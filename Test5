-- ============================================================================
-- Util
-- ============================================================================
local Util = {}

function Util.remote(name, expectClass)
    if not networking then return nil end
    local r = networking:FindFirstChild(name)
    if not r then return nil end
    if expectClass and not r:IsA(expectClass) then return nil end
    return r
end

function Util.invoke(name, ...)
    local r = Util.remote(name, "RemoteFunction")
    if not r then return false, nil end
    local ok, res = pcall(r.InvokeServer, r, ...)
    return ok, res
end

function Util.fire(name, ...)
    local r = Util.remote(name, "RemoteEvent")
    if not r then return false end
    return pcall(r.FireServer, r, ...)
end

function Util.root()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.humanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.distanceTo(pos)
    local root = Util.root()
    if not root or not pos then return math.huge end
    return (root.Position - pos).Magnitude
end

function Util.saveGet()
    local s = Modules.Save
    if type(s) ~= "table" then return nil end
    if type(s.Get) == "function" then
        local ok, res = pcall(s.Get)
        if ok then return res end
    end
    if type(s.Peek) == "function" then
        local ok, res = pcall(s.Peek)
        if ok then return res end
    end
    return nil
end

function Util.readOwnerEggs()
    local es = Modules.EggState
    if type(es) ~= "table" or type(es.ReadOwnerEggs) ~= "function" then
        return {}
    end
    local ok, res = pcall(es.ReadOwnerEggs, LocalPlayer.UserId)
    return ok and type(res) == "table" and res or {}
end

function Util.readFieldEggs()
    local es = Modules.EggState
    if type(es) == "table" and type(es.ReadFieldEggs) == "function" then
        local ok, res = pcall(es.ReadFieldEggs)
        if ok and type(res) == "table" and type(res.Records) == "table" then
            return res.Records
        end
    end
    local snap = Util.invoke("RF/EggWorld/AskFieldEggSnapshot")
    if type(snap) == "table" and type(snap.Records) == "table" then
        return snap.Records
    end
    return nil
end

function Util.assetInfo(category)
    local assets = Modules.Assets
    if type(assets) ~= "table" or type(assets.Directory) ~= "table" then return nil end
    return assets.Directory[tostring(category)]
end

function Util.assetRarity(category)
    local info = Util.assetInfo(category)
    if type(info) ~= "table" then return 0 end
    local rar = info.Rarity
    if type(rar) ~= "table" then return 0 end
    return tonumber(rar.RarityNumber or rar.Rank) or 0
end

function Util.assetName(category)
    local info = Util.assetInfo(category)
    if type(info) == "table" and info.DisplayName then
        return tostring(info.DisplayName)
    end
    return tostring(category)
end

function Util.assetIncome(category, scale)
    local info = Util.assetInfo(category)
    if type(info) ~= "table" then return 0 end
    local rate  = tonumber(info.EarningRate) or 0
    scale       = tonumber(scale) or 1
    local mult  = scale > 5 and (scale / 5) ^ 1.2 * 19.637875755794113 or scale ^ 1.85
    return rate * mult
end

function Util.notify(title, text, dur)
    pcall(function()
        Astra.Notify({
            Title    = tostring(title or "L Hub"),
            Text     = tostring(text or ""),
            Icon     = "check",
            Duration = tonumber(dur) or 4,
        })
    end)
end

function Util.inBase(pos)
    pos = pos or (Util.root() and Util.root().Position)
    if not pos then return false end
    local world = workspace:FindFirstChild("World") or workspace:FindFirstChild("__OBJECTS")
    local areas = world and world:FindFirstChild("Areas")
    local line  = areas and areas:FindFirstChild("SeparationLine")
    local xCut  = line and line:IsA("BasePart") and line.Position.X or 552
    return pos.X < xCut
end

function Util.stealHome()
    local paths = {
        { "GearGiver_Slap", "Podium" },
        { "World", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003" },
        { "__OBJECTS", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003" },
    }
    for _, p in ipairs(paths) do
        local cur = workspace
        for _, n in ipairs(p) do
            cur = cur and cur:FindFirstChild(n) or nil
        end
        if cur and cur:IsA("BasePart") then
            local off = p[1] == "GearGiver_Slap" and Vector3.new(-16.415, 21.072, -6.106)
                       or Vector3.new(-26.776, 1.75, 18.665)
            return cur.CFrame:PointToWorldSpace(off)
        end
    end
    return Vector3.new(528.7, 70.57, -364.11)
end

