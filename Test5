-- ============================================================================
-- Movement ownership
-- ============================================================================
local Movement = {}
function Movement.claim(owner)
    if State.Movement.Owner == nil or State.Movement.Owner == owner then
        State.Movement.Owner = owner
        return true
    end
    return false
end
function Movement.release(owner)
    if State.Movement.Owner == owner then
        State.Movement.Owner = nil
    end
end

-- ============================================================================
-- Egg filters
-- ============================================================================
local function eggMatches(record)
    local category = record.AssetCategory or record.Category
    if not category then return false end
    local rarity = Util.assetRarity(category)

    if State.MinRarity > 0 and rarity < State.MinRarity then return false end

    if State.MinValue > 0 then
        local income = Util.assetIncome(category, record.AssetScale or 1)
        if income < State.MinValue then return false end
    end

    if next(State.SpecificEggs) then
        if not State.SpecificEggs[tostring(category)] then return false end
    end

    if next(State.Areas) then
        local areaId = record.AreaId
        if not areaId or not State.Areas[tostring(areaId)] then return false end
    end

    return true
end

local function collectCandidates(includeCarried)
    local records = Util.readFieldEggs()
    if not records then return {} end
    local list = {}
    for _, rec in pairs(records) do
        local state = rec.State
        if state == "Slot" or state == "Dropped" or (includeCarried and state == "Carried") then
            if eggMatches(rec) then
                list[#list + 1] = rec
            end
        end
    end
    return list
end

local function sortCandidates(list)
    local priority = State.Priority
    table.sort(list, function(a, b)
        if priority == "Best Rarity" then
            return Util.assetRarity(a.AssetCategory) > Util.assetRarity(b.AssetCategory)
        end
        if priority == "Biggest Weight" then
            return (a.AssetScale or 0) > (b.AssetScale or 0)
        end
        if priority == "Lowest Value" then
            return Util.assetIncome(a.AssetCategory, a.AssetScale or 1) < Util.assetIncome(b.AssetCategory, b.AssetScale or 1)
        end
        -- highest value
        return Util.assetIncome(a.AssetCategory, a.AssetScale or 1) > Util.assetIncome(b.AssetCategory, b.AssetScale or 1)
    end)
end

-- ============================================================================
-- Steal logic
-- ============================================================================
local function tryCarryEgg(rec)
    local es = Modules.EggState
    if type(es) == "table" and type(es.CarryFieldEgg) == "function" then
        pcall(es.CarryFieldEgg, rec.Uid)
    end
    -- also try proximity prompt on the nearest SmartPromptPart
    local pos = rec.BottomCFrame and rec.BottomCFrame.Position or nil
    if pos and type(fireproximityprompt) == "function" then
        for _, child in ipairs(workspace:GetChildren()) do
            if child.Name == "SmartPromptPart" and child:IsA("BasePart") then
                local prompt = child:FindFirstChild("CarryAreaEgg")
                if prompt and prompt:IsA("ProximityPrompt") then
                    if (child.Position - pos).Magnitude < 6 then
                        pcall(function() prompt.HoldDuration = 0 end)
                        pcall(fireproximityprompt, prompt)
                        break
                    end
                end
            end
        end
    end
end

local StealWorker = nil

local function stealOneEgg(rec, shouldStop)
    if not Movement.claim("steal") then return false end

    local root = Util.root()
    if not root then Movement.release("steal"); return false end

    local pos = rec.BottomCFrame and rec.BottomCFrame.Position or nil
    if not pos then Movement.release("steal"); return false end

    -- Walk toward the egg
    local humanoid = Util.humanoid()
    if not humanoid then Movement.release("steal"); return false end

    local function moveToward(target, timeout)
        local start = os.clock()
        while os.clock() - start < timeout do
            if shouldStop and shouldStop() then return false end
            local r = Util.root()
            if not r then return false end
            if (r.Position - target).Magnitude <= 4 then return true end
            humanoid:MoveTo(target)
            RunService.Heartbeat:Wait()
        end
        return (Util.root() and (Util.root().Position - target).Magnitude <= 5) or false
    end

    -- Teleport close if far
    if Util.distanceTo(pos) > 40 then
        local r = Util.root()
        if r then
            pcall(function()
                r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                r.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    else
        moveToward(pos, 6)
    end

    -- Attempt grab
    tryCarryEgg(rec)

    -- Wait for carrying flag
    local start = os.clock()
    while os.clock() - start < 2 do
        if shouldStop and shouldStop() then break end
        local s = Util.saveGet()
        -- Check via EggState
        local carried = false
        if s and s.CarryUid == rec.Uid then carried = true end
        local es = Modules.EggState
        if es and type(es.ReadOwnerEggs) == "function" then
            local recs = Util.readOwnerEggs()
            for k, v in pairs(recs) do
                if k == rec.Uid then carried = true; break end
            end
        end
        if carried then
            State.Steal.CarryUid = rec.Uid
            State.Steal.Carrying = true
            break
        end
        RunService.Heartbeat:Wait()
    end

    -- Deliver: fly home
    if State.Steal.Carrying then
        local home = Util.stealHome()
        local r = Util.root()
        if r and home then
            local start = os.clock()
            while os.clock() - start < 20 do
                if shouldStop and shouldStop() then break end
                local r2 = Util.root()
                if not r2 then break end
                local delta = home - r2.Position
                if delta.Magnitude < 6 then break end
                pcall(function()
                    r2.CFrame = r2.CFrame + delta.Unit * math.min(400 * RunService.Heartbeat:Wait(), delta.Magnitude)
                    r2.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end

    Movement.release("steal")
    State.Steal.Carrying = false
    State.Steal.LastFinished = os.clock()
    return true
end

-- ============================================================================
-- Farm tab — Auto Steal
-- ============================================================================
do
    local sec = TabFarm:CreateSection({ Name = "Auto Steal", Side = "Left" })

    -- Areas list
    local areaList = {
        "Forest", "Desert", "Snow", "Lake", "Jungle", "Volcano",
        "Prehistoric", "Cosmic", "Abyss Ocean", "Cherry Blossom",
        "Light Dark", "Titan Temple",
    }
    local areaDefaults = table.clone(areaList)

    local areaToggle = sec:AddMultiDropdown({
        Name     = "Target Areas",
        Options  = areaList,
        Default  = areaDefaults,
        Callback = function(selected)
            local s = {}
            if type(selected) == "table" then
                for k, v in pairs(selected) do
                    if v == true and type(k) == "string" then s[k] = true
                    elseif type(v) == "string" then s[v] = true end
                end
            end
            if next(s) == nil then
                for _, v in ipairs(areaList) do s[v] = true end
            end
            State.Areas = s
        end,
    })

    -- Rarity dropdown
    local rarityOptions = { "Any" }
    local rarityMap = { Any = 0 }
    do
        local seen = {}
        local assets = Modules.Assets
        if type(assets) == "table" and type(assets.Directory) == "table" then
            for _, info in pairs(assets.Directory) do
                local rar = type(info) == "table" and type(info.Rarity) == "table" and info.Rarity or nil
                local num = rar and tonumber(rar.RarityNumber or rar.Rank)
                if num and not seen[num] then
                    seen[num] = tostring(rar.DisplayName or rar._id or num)
                end
            end
        end
        if next(seen) == nil then
            seen = { 1, "Common"; 2, "Uncommon"; 3, "Rare"; 4, "Epic"; 5, "Legendary"; 6, "Mythic" }
        end
        local sorted = {}
        for k in pairs(seen) do sorted[#sorted + 1] = k end
        table.sort(sorted)
        for _, k in ipairs(sorted) do
            local name = string.format("%d - %s", k, seen[k])
            rarityOptions[#rarityOptions + 1] = name
            rarityMap[name] = k
        end
    end

    sec:AddDropdown({
        Name     = "Min Rarity",
        Options  = rarityOptions,
        Default  = rarityOptions[1],
        Callback = function(sel)
            State.MinRarity = rarityMap[sel] or 0
        end,
    })

    sec:AddInput({
        Name        = "Min Steal Value",
        Placeholder = "e.g. 250k, 50m, 1.5b",
        Default     = "",
        Callback    = function(text, entered)
            if not entered then return end
            local s = tostring(text):lower():gsub("%s", "")
            local num, suffix = string.match(s, "^([%d%.]+)([kmbt]?)$")
            num = tonumber(num)
            if not num then State.MinValue = 0; return end
            local mult = ({ k = 1e3, m = 1e6, b = 1e9, t = 1e12 })[suffix] or 1
            State.MinValue = num * mult
        end,
    })

    -- Specific eggs
    local specificList, specificMap = {}, {}
    do
        local assets = Modules.Assets
        local entries = {}
        if type(assets) == "table" and type(assets.Directory) == "table" then
            for k, info in pairs(assets.Directory) do
                local rar = type(info) == "table" and type(info.Rarity) == "table" and info.Rarity or nil
                local num = rar and tonumber(rar.RarityNumber or rar.Rank)
                if num then
                    entries[#entries + 1] = {
                        cat = tostring(k),
                        name = tostring(info.DisplayName or k),
                        rar = num,
                        rarName = tostring(rar.DisplayName or rar._id or num),
                    }
                end
            end
        end
        table.sort(entries, function(a, b)
            if a.rar ~= b.rar then return a.rar > b.rar end
            return a.name < b.name
        end)
        for _, e in ipairs(entries) do
            local label = string.format("%s [%s]", e.name, e.rarName)
            if specificMap[label] then
                label = string.format("%s [%s] (%s)", e.name, e.rarName, e.cat)
            end
            specificList[#specificList + 1] = label
            specificMap[label] = e.cat
        end
    end

    if #specificList > 0 then
        sec:AddMultiDropdown({
            Name     = "Target Specific Eggs",
            Options  = specificList,
            Default  = {},
            Callback = function(sel)
                local out = {}
                if type(sel) == "table" then
                    for k, v in pairs(sel) do
                        if v == true and specificMap[k] then out[specificMap[k]] = true
                        elseif type(v) == "string" and specificMap[v] then out[specificMap[v]] = true end
                    end
                end
                State.SpecificEggs = out
            end,
        })
    end

    sec:AddDropdown({
        Name     = "Steal Priority",
        Options  = { "Highest Value", "Best Rarity", "Biggest Weight", "Lowest Value" },
        Default  = "Highest Value",
        Callback = function(sel) State.Priority = sel end,
    })

    sec:AddToggle({
        Name     = "Auto Steal",
        Default  = false,
        Callback = function(on)
            State.Steal.Enabled = on == true
            if not on then
                State.Steal.Carrying = false
                State.Steal.CarryUid = nil
            end
        end,
    })
end

