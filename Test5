-- Background workers
-- ============================================================================

-- Steal worker
task.spawn(function()
    while true do
        if State.Steal.Enabled and not State.Steal.Carrying then
            local list = collectCandidates(false)
            sortCandidates(list)
            local target = list[1]
            if target then
                local ok = pcall(stealOneEgg, target, function()
                    return not State.Steal.Enabled
                end)
                if not ok then
                    task.wait(1)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Treadmill worker
task.spawn(function()
    while true do
        if State.Treadmill.Enabled and not State.Treadmill.Riding then
            local plot = nil
            do
                local plots = workspace:FindFirstChild("Plots")
                if plots then
                    for _, child in ipairs(plots:GetChildren()) do
                        local sign = child:FindFirstChild("PlotSign")
                        sign = sign and sign:FindFirstChild("PlayerPlotSign")
                        sign = sign and sign:FindFirstChild("Frame")
                        sign = sign and sign:FindFirstChild("PlayerName")
                        if sign and sign:IsA("TextLabel") then
                            local t = string.lower(sign.Text)
                            if t == string.lower(LocalPlayer.Name) or t == string.lower(LocalPlayer.DisplayName) then
                                plot = child
                                break
                            end
                        end
                    end
                end
            end
            if plot then
                local belt = plot:FindFirstChild("TreadmillBottom")
                if belt and belt:IsA("BasePart") then
                    local root = Util.root()
                    if root and (root.Position - belt.Position).Magnitude > 6 then
                        pcall(function()
                            root.CFrame = CFrame.new(belt.Position + Vector3.new(0, 4, 0))
                            root.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                    pcall(function()
                        Util.invoke("RF/Treadmill/AskWearStill")
                    end)
                    State.Treadmill.Riding = true
                    task.wait(3)
                    State.Treadmill.Riding = false
                end
            end
        end
        task.wait(1)
    end
end)

-- Hatch worker
task.spawn(function()
    while true do
        if State.Hatch.Enabled then
            local owned = Util.readOwnerEggs()
            local es = Modules.EggState
            for uid, rec in pairs(owned) do
                if type(rec) == "table" and rec.Placement ~= nil then
                    local ready = false
                    if es and type(es.IsReadyToHatch) == "function" then
                        local ok, res = pcall(es.IsReadyToHatch, uid)
                        ready = ok and res == true
                    end
                    if ready then
                        local rarity = Util.assetRarity(rec.AssetCategory)
                        if State.Hatch.MinRarity == 0 or rarity >= State.Hatch.MinRarity then
                            Util.invoke("RF/EggWorld/AskHatch", uid)
                            task.wait(0.35)
                            Util.invoke("RF/EggWorld/AskFinishHatch", uid)
                            task.wait(State.Hatch.Delay or 0.35)
                        end
                    end
                end
            end
        end
        task.wait(2)
    end
end)

-- Sell worker
task.spawn(function()
    while true do
        if State.SellEgg.Enabled then
            local owned = Util.readOwnerEggs()
            local toSell = {}
            for uid, rec in pairs(owned) do
                if type(rec) == "table" and rec.Placement == nil then
                    local mut = type(rec.Mutations) == "table" and next(rec.Mutations) ~= nil
                    if not (State.SellEgg.KeepMutated and mut) then
                        local rarity = Util.assetRarity(rec.AssetCategory)
                        local maxR = State.SellEgg.MaxRarity
                        if maxR == 0 or rarity <= maxR then
                            toSell[#toSell + 1] = uid
                        end
                    end
                end
            end
            if #toSell > 0 then
                -- PetSatchel sell accepts Eggs
                local batches = {}
                for i = 1, #toSell, 50 do
                    local chunk = {}
                    for j = i, math.min(i + 49, #toSell) do
                        chunk[#chunk + 1] = toSell[j]
                    end
                    batches[#batches + 1] = chunk
                end
                for _, batch in ipairs(batches) do
                    Util.fire("RE/PetSatchel/SellSelection", { Eggs = batch, Assets = {} })
                    task.wait(0.4)
                end
            end
        end
        task.wait(3)
    end
end)

-- Progression worker
task.spawn(function()
    while true do
        if State.AutoClaim then
            pcall(function() Util.invoke("RF/AwayEarnings/PendingCheck") end)
            pcall(function() Util.invoke("RF/AwayEarnings/AskCollect") end)
            pcall(function() Util.invoke("RF/Codex/AskRedeemAll") end)
        end
        if State.AutoClaimIndex then
            pcall(function() Util.invoke("RF/Codex/AskRedeemAll") end)
        end
        task.wait(15)
    end
end)

-- Anti-AFK
task.spawn(function()
    while true do
        if State.AntiAfk then
            pcall(function()
                if typeof(getconnections) == "function" then
                    for _, c in ipairs(getconnections(LocalPlayer.Idled)) do
                        pcall(function() c:Disable() end)
                    end
                end
            end)
        end
        task.wait(120)
    end
end)

-- Auto rejoin
do
    local fired = false
    pcall(function()
        game:GetService("GuiService").ErrorMessageChanged:Connect(function(msg)
            if fired or not State.RejoinOnDC then return end
            local text = string.lower(tostring(msg or ""))
            if text == "" or text:find("teleport", 1, true) then return end
            fired = true
            Util.notify("Auto Rejoin", "Disconnected, rejoining…")
            task.spawn(function()
                while true do
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, LocalPlayer)
                    end)
                    task.wait(5)
                end
            end)
        end)
    end)
end

