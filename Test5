-- ============================================================================
do
    local moveSec = TabPlayer:CreateSection({ Name = "Movement", Side = "Left" })
    local charSec = TabPlayer:CreateSection({ Name = "Character", Side = "Left" })
    local combSec = TabPlayer:CreateSection({ Name = "Combat / Anti", Side = "Right" })

    -- Speed boost
    local speedConn
    local function enableSpeed()
        if speedConn then return end
        speedConn = RunService.Heartbeat:Connect(function()
            local hum = Util.humanoid()
            local root = Util.root()
            if not hum or not root then return end
            local dir = hum.MoveDirection
            if dir.Magnitude < 0.01 then return end
            local vel = dir.Unit * State.SpeedValue
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.new(vel.X, root.AssemblyLinearVelocity.Y, vel.Z)
            end)
        end)
    end
    local function disableSpeed()
        if speedConn then speedConn:Disconnect(); speedConn = nil end
    end

    moveSec:AddToggle({
        Name     = "Speed Boost",
        Default  = false,
        Callback = function(on)
            State.SpeedBoost = on == true
            if on then enableSpeed() else disableSpeed() end
        end,
    })

    moveSec:AddSlider({
        Name     = "Boost Speed",
        Min      = 20,
        Max      = 1000,
        Default  = 350,
        Callback = function(v) State.SpeedValue = math.clamp(tonumber(v) or 350, 20, 1000) end,
    })

    -- Infinite jump
    local jumpConn
    moveSec:AddToggle({
        Name     = "Infinite Jump",
        Default  = false,
        Callback = function(on)
            State.InfiniteJump = on == true
            if on and not jumpConn then
                jumpConn = UserInputService.JumpRequest:Connect(function()
                    local hum = Util.humanoid()
                    if hum then
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    end
                end)
            elseif not on and jumpConn then
                jumpConn:Disconnect()
                jumpConn = nil
            end
        end,
    })

    -- Anti-ragdoll
    local ragConn
    charSec:AddToggle({
        Name     = "Anti Ragdoll",
        Default  = true,
        Callback = function(on)
            State.AntiRagdoll = on ~= false
            if on and not ragConn then
                ragConn = RunService.Heartbeat:Connect(function()
                    if not State.AntiRagdoll then return end
                    local hum = Util.humanoid()
                    if not hum then return end
                    local state = hum:GetState()
                    if state == Enum.HumanoidStateType.Physics
                        or state == Enum.HumanoidStateType.Ragdoll
                        or state == Enum.HumanoidStateType.FallingDown then
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
                    end
                    if hum.PlatformStand then
                        hum.PlatformStand = false
                    end
                end)
            elseif not on and ragConn then
                ragConn:Disconnect()
                ragConn = nil
            end
        end,
    })

    -- Anti-trap
    charSec:AddToggle({
        Name     = "Anti Trap",
        Default  = true,
        Callback = function(on)
            State.AntiTrap = on ~= false
            if State.AntiTrap then
                for _, inst in ipairs(CollectionService:GetTagged("PlacedTrap")) do
                    for _, desc in ipairs(inst:GetDescendants()) do
                        if desc:IsA("BasePart") then pcall(function() desc.CanTouch = false end) end
                    end
                    if inst:IsA("BasePart") then pcall(function() inst.CanTouch = false end) end
                end
            end
        end,
    })

    -- Invisibility toggle (best-effort)
    charSec:AddToggle({
        Name     = "Invisibility",
        Default  = false,
        Callback = function(on)
            State.Invisibility = on == true
            if not on then
                pcall(function()
                    LocalPlayer.Character:SetAttribute("InvisApplied", false)
                end)
            end
        end,
    })

    -- Anti-guard
    combSec:AddToggle({
        Name     = "Anti Guard",
        Default  = false,
        Callback = function(on) State.AntiGuard = on == true end,
    })

    combSec:AddToggle({
        Name     = "Anti AFK",
        Default  = true,
        Callback = function(on) State.AntiAfk = on ~= false end,
    })
end

-- ============================================================================
-- Visuals tab (ESP)
-- ============================================================================
do
    local sec = TabVisuals:CreateSection({ Name = "ESP", Side = "Left" })

    local function espInstanceLookup()
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return nil end
        local gui = playerGui:FindFirstChild("LHubEsp")
        if not gui then
            gui = Instance.new("ScreenGui")
            gui.Name = "LHubEsp"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            gui.DisplayOrder = 40
            gui.Parent = playerGui
        end
        return gui
    end

    -- ESP Eggs
    local eggTags = {}
    local function clearEggEsp()
        for _, tag in pairs(eggTags) do
            if tag.Parent then tag:Destroy() end
        end
        table.clear(eggTags)
    end

    local function updateEggEsp()
        if not State.EspEggs then
            clearEggEsp()
            return
        end
        local gui = espInstanceLookup()
        if not gui then return end

        local records = Util.readFieldEggs() or {}
        local seen = {}

        for uid, rec in pairs(records) do
            if type(rec) == "table" and rec.BottomCFrame and type(rec.BottomCFrame) == "CFrame" then
                local rarity = Util.assetRarity(rec.AssetCategory)
                if rarity >= State.EspEggMinRarity then
                    seen[uid] = true
                    local tag = eggTags[uid]
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "EggTag"
                        tag.Size = UDim2.fromOffset(160, 30)
                        tag.AlwaysOnTop = true
                        tag.Adornee = workspace.Terrain
                        tag.StudsOffsetWorldSpace = rec.BottomCFrame.Position - workspace.Terrain.Position + Vector3.new(0, 3, 0)
                        tag.Parent = gui

                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.fromScale(1, 1)
                        lbl.BackgroundTransparency = 0.3
                        lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        lbl.TextScaled = true
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.Text = ""
                        lbl.Parent = tag

                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(0, 4)
                        corner.Parent = lbl

                        tag._lbl = lbl
                        eggTags[uid] = tag
                    end
                    local income = Util.assetIncome(rec.AssetCategory, rec.AssetScale or 1)
                    tag._lbl.Text = string.format("%s  x%.2f  $%d/s",
                        Util.assetName(rec.AssetCategory),
                        rec.AssetScale or 1,
                        math.floor(income))
                    tag.StudsOffsetWorldSpace = rec.BottomCFrame.Position - workspace.Terrain.Position + Vector3.new(0, 3, 0)
                end
            end
        end

        for uid, tag in pairs(eggTags) do
            if not seen[uid] then
                tag:Destroy()
                eggTags[uid] = nil
            end
        end
    end

    sec:AddToggle({
        Name     = "ESP Eggs",
        Default  = false,
        Callback = function(on)
            State.EspEggs = on == true
            task.spawn(updateEggEsp)
        end,
    })

    -- ESP Guards
    local guardTags = {}
    local function clearGuardEsp()
        for _, tag in pairs(guardTags) do
            if tag.Parent then tag:Destroy() end
        end
        table.clear(guardTags)
    end

    local function updateGuardEsp()
        if not State.EspGuards then clearGuardEsp(); return end
        local gui = espInstanceLookup()
        if not gui then return end
        local world = workspace:FindFirstChild("World") or workspace:FindFirstChild("__OBJECTS")
        local areas = world and world:FindFirstChild("Areas")
        local guardAreas = areas and areas:FindFirstChild("GuardAreas")
        if not guardAreas then return end

        local seen = {}
        for _, area in ipairs(guardAreas:GetChildren()) do
            local guard = area:FindFirstChild("Guard")
            if guard and guard:IsA("Model") then
                local root = guard:FindFirstChild("HumanoidRootPart") or guard.PrimaryPart
                if root then
                    seen[guard] = true
                    local tag = guardTags[guard]
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Size = UDim2.fromOffset(160, 26)
                        tag.AlwaysOnTop = true
                        tag.Adornee = root
                        tag.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
                        tag.Parent = gui

                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.fromScale(1, 1)
                        lbl.BackgroundTransparency = 0.3
                        lbl.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                        lbl.TextScaled = true
                        lbl.TextColor3 = Color3.fromRGB(255, 200, 100)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.Parent = tag
                        tag._lbl = lbl
                        guardTags[guard] = tag
                    end
                    local st = guard:GetAttribute("GuardState") or "Awake"
                    tag._lbl.Text = string.format("%s Guard [%s]", area.Name, tostring(st))
                end
            end
        end

        for g, tag in pairs(guardTags) do
            if not seen[g] then tag:Destroy(); guardTags[g] = nil end
        end
    end

    sec:AddToggle({
        Name     = "ESP Guards",
        Default  = false,
        Callback = function(on)
            State.EspGuards = on == true
            task.spawn(updateGuardEsp)
        end,
    })

    -- ESP Players
    local playerTags = {}
    local function clearPlayerEsp()
        for _, tag in pairs(playerTags) do
            if tag.Parent then tag:Destroy() end
        end
        table.clear(playerTags)
    end

    local function updatePlayerEsp()
        if not State.EspPlayers then clearPlayerEsp(); return end
        local gui = espInstanceLookup()
        if not gui then return end
        local seen = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                local head = char and char:FindFirstChild("Head")
                if head then
                    seen[plr] = true
                    local tag = playerTags[plr]
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Size = UDim2.fromOffset(160, 24)
                        tag.AlwaysOnTop = true
                        tag.Adornee = head
                        tag.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                        tag.Parent = gui

                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.fromScale(1, 1)
                        lbl.BackgroundTransparency = 0.4
                        lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        lbl.TextScaled = true
                        lbl.TextColor3 = Color3.fromRGB(120, 220, 255)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.Parent = tag
                        tag._lbl = lbl
                        playerTags[plr] = tag
                    end
                    tag._lbl.Text = plr.DisplayName
                end
            end
        end
        for p, tag in pairs(playerTags) do
            if not seen[p] then tag:Destroy(); playerTags[p] = nil end
        end
    end

    sec:AddToggle({
        Name     = "ESP Players",
        Default  = false,
        Callback = function(on)
            State.EspPlayers = on == true
            task.spawn(updatePlayerEsp)
        end,
    })

    -- Single global heartbeat drives all ESP
    RunService.Heartbeat:Connect(function()
        if State.EspEggs    then pcall(updateEggEsp) end
        if State.EspGuards  then pcall(updateGuardEsp) end
        if State.EspPlayers then pcall(updatePlayerEsp) end
    end)
end

-- ============================================================================
-- Server tab
-- ============================================================================
do
    local sec = TabServer:CreateSection({ Name = "Server", Side = "Left" })

    local hopOptions = { "Least Players", "Most Players", "Random" }

    sec:AddDropdown({
        Name     = "Server Hop Mode",
        Options  = hopOptions,
        Default  = "Least Players",
        Callback = function(sel) State.HopMode = sel end,
    })

    local function fetchServers(sortOrder)
        local list = {}
        local ok, res = pcall(function()
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=true&limit=100",
                game.PlaceId, sortOrder)
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or type(res) ~= "table" or type(res.data) ~= "table" then return list end
        for _, srv in ipairs(res.data) do
            if srv.id and srv.id ~= game.JobId and (srv.playing or 0) < (srv.maxPlayers or 0) then
                list[#list + 1] = {
                    Id       = tostring(srv.id),
                    Playing  = tonumber(srv.playing) or 0,
                    Room     = (tonumber(srv.maxPlayers) or 0) - (tonumber(srv.playing) or 0),
                }
            end
        end
        return list
    end

    sec:AddButton({
        Name     = "Server Hop",
        Callback = function()
            local mode = State.HopMode
            local order = mode == "Least Players" and "Asc" or "Desc"
            local servers = fetchServers(order)
            if #servers == 0 then
                Util.notify("Server Hop", "No servers found.")
                return
            end
            table.sort(servers, function(a, b)
                if mode == "Least Players" then return a.Playing < b.Playing end
                if mode == "Most Players"  then return a.Playing > b.Playing end
                return false
            end)
            local target = mode == "Random" and servers[math.random(1, #servers)] or servers[1]
            Util.notify("Server Hop", "Joining " .. target.Id:sub(1, 8))
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, target.Id, LocalPlayer)
            end)
        end,
    })

    sec:AddButton({
        Name     = "Rejoin Server",
        Callback = function()
            pcall(function()
                if game.JobId ~= "" then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                else
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end
            end)
        end,
    })

    sec:AddToggle({
        Name     = "Auto Rejoin When Disconnect",
        Default  = true,
        Callback = function(on) State.RejoinOnDC = on ~= false end,
    })
end

