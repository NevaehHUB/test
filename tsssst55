__modules["log"] = function(...)
-- Session log: ring buffer with listeners. Nothing is persisted.
local Log = {}

local MAX = 300
local entries = {}
local listeners = {}

function Log.add(level, source, msg)
	local e = { t = os.time(), clock = os.clock(), level = level, source = source, msg = tostring(msg) }
	table.insert(entries, e)
	if #entries > MAX then
		table.remove(entries, 1)
	end
	for _, fn in ipairs(listeners) do
		task.spawn(pcall, fn, e)
	end
	return e
end

function Log.info(source, msg)
	return Log.add("info", source, msg)
end

function Log.warn(source, msg)
	return Log.add("warn", source, msg)
end

function Log.error(source, msg)
	return Log.add("error", source, msg)
end

function Log.good(source, msg)
	return Log.add("good", source, msg)
end

function Log.entries()
	return entries
end

function Log.onEntry(fn)
	table.insert(listeners, fn)
end

function Log.format(e)
	return string.format("[%s] %s: %s", os.date("%H:%M:%S", e.t), e.source, e.msg)
end

function Log.export()
	local lines = {}
	for _, e in ipairs(entries) do
		table.insert(lines, Log.format(e))
	end
	return table.concat(lines, "\n")
end

return Log
end
__modules["logo"] = function(...)
-- DUKE HUB logo: the PNG is embedded as base64 by build.ps1 (module
-- "logo_data"), written to the executor workspace once and loaded with
-- getcustomasset. Returns nil when the executor can't do that; the UI then
-- shows the name only.
local Logo = {}

local PATH = "AnimeDiceHub/duke_logo.png"
local cached

local function decoder()
	-- executor globals; any of them may be missing
	if type(crypt) == "table" and (crypt.base64decode or crypt.base64_decode) then
		return crypt.base64decode or crypt.base64_decode
	end
	return base64_decode or base64decode
end

function Logo.asset()
	if cached ~= nil then
		return cached or nil
	end
	cached = false
	local data = import("logo_data")
	local decode = decoder()
	if not data or not decode or type(writefile) ~= "function" or type(getcustomasset) ~= "function" then
		return nil
	end
	local ok, id = pcall(function()
		if not isfolder("AnimeDiceHub") then
			makefolder("AnimeDiceHub")
		end
		if not isfile(PATH) then
			writefile(PATH, decode(data))
		end
		return getcustomasset(PATH)
	end)
	if ok and id then
		cached = id
		return id
	end
	return nil
end

return Logo
end
__modules["misc"] = function(...)
-- Anti-AFK and low graphics. Both restore what they changed on cleanup.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local Misc = {}

local connections = {}
local afkConn
local afkThread
local saved = {}

-- The game's own PlayerScripts.AFK teleports you to a new server after 1080s
-- without a UserInputService.InputBegan event, which wipes the script. A
-- VirtualUser click does not count as input there, so an unbound key (F15)
-- is also pressed every few minutes.
local KEEPALIVE_EVERY = 240

function Misc.setAntiAfk(on)
	if afkConn then
		afkConn:Disconnect()
		afkConn = nil
	end
	if afkThread then
		task.cancel(afkThread)
		afkThread = nil
	end
	-- the game's own PlayerScripts.AFK: disabling it stops its 18-minute timer
	-- (key presses may not count while the Roblox window is in the background)
	local ps = Players.LocalPlayer:FindFirstChild("PlayerScripts")
	local afkScript = ps and ps:FindFirstChild("AFK")
	if afkScript and afkScript:IsA("LocalScript") then
		if on and afkScript.Enabled then
			afkScript.Enabled = false
			Misc.disabledAfkScript = afkScript
		elseif not on and Misc.disabledAfkScript == afkScript then
			afkScript.Enabled = true
			Misc.disabledAfkScript = nil
		end
	end
	if not on then
		return
	end
	local ok, vu = pcall(game.GetService, game, "VirtualUser")
	if ok then
		-- Roblox's own 20-minute idle kick
		afkConn = Players.LocalPlayer.Idled:Connect(function()
			pcall(function()
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
		end)
	end
	afkThread = task.spawn(function()
		while true do
			pcall(function()
				local vim = game:GetService("VirtualInputManager")
				vim:SendKeyEvent(true, Enum.KeyCode.F15, false, game)
				task.wait(0.05)
				vim:SendKeyEvent(false, Enum.KeyCode.F15, false, game)
			end)
			Misc.lastKeepAlive = os.time()
			task.wait(KEEPALIVE_EVERY)
		end
	end)
end

function Misc.setLowGraphics(on)
	if on then
		if next(saved) then
			return
		end
		saved.GlobalShadows = Lighting.GlobalShadows
		saved.QualityLevel = settings().Rendering.QualityLevel
		saved.effects = {}
		Lighting.GlobalShadows = false
		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		for _, e in ipairs(Lighting:GetDescendants()) do
			if e:IsA("PostEffect") and e.Enabled then
				saved.effects[e] = true
				e.Enabled = false
			end
		end
		for i, d in ipairs(workspace:GetDescendants()) do
			if (d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")) and d.Enabled then
				saved.effects[d] = true
				d.Enabled = false
			end
			if UserInputService.TouchEnabled and i % 200 == 0 then task.wait() end
		end
	else
		if not next(saved) then
			return
		end
		Lighting.GlobalShadows = saved.GlobalShadows
		pcall(function()
			settings().Rendering.QualityLevel = saved.QualityLevel
		end)
		for e in pairs(saved.effects or {}) do
			if e.Parent then
				e.Enabled = true
			end
		end
		saved = {}
	end
end

-- Rejoin the same place when Roblox shows a disconnect / kick error.
local rejoinConn
local rejoinGeneration = 0
function Misc.setAutoRejoin(on)
	rejoinGeneration += 1
	local generation = rejoinGeneration
	if rejoinConn then
		rejoinConn:Disconnect()
		rejoinConn = nil
	end
	if not on then
		return
	end
	local GuiService = game:GetService("GuiService")
	local TeleportService = game:GetService("TeleportService")
	rejoinConn = GuiService.ErrorMessageChanged:Connect(function(msg)
		if not Misc.shouldRejoin(msg) then
			return
		end
		task.wait(5)
		if generation ~= rejoinGeneration then return end
		pcall(function()
			import("hop").queueSelf() -- start DUKE HUB again after rejoining
		end)
		while generation == rejoinGeneration do
			pcall(TeleportService.Teleport, TeleportService, game.PlaceId, Players.LocalPlayer)
			task.wait(15)
		end
	end)
end

-- Never rejoin when the account was opened on another device (error 273):
-- rejoining would kick that session, which then kicks this one, forever.
function Misc.shouldRejoin(msg)
	if msg == nil or msg == "" then
		return false
	end
	local m = msg:lower()
	for _, word in ipairs({ "another device", "different device", "273", "banned" }) do
		if m:find(word, 1, true) then
			return false
		end
	end
	return true
end

-- Calls onDisconnect(message) once when Roblox shows a disconnect / kick message.
function Misc.watchDisconnect(onDisconnect)
	local GuiService = game:GetService("GuiService")
	local fired = false
	local function check(msg)
		if fired or msg == nil or msg == "" then
			return
		end
		fired = true
		task.spawn(onDisconnect, msg)
	end
	table.insert(connections, GuiService.ErrorMessageChanged:Connect(check))
	pcall(function()
		check(GuiService:GetErrorMessage())
	end)
end

function Misc.cleanup()
	Misc.setAutoRejoin(false)
	Misc.setAntiAfk(false)
	Misc.setLowGraphics(false)
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
end

return Misc
end
__modules["reroll"] = function(...)
-- Auto Trait / Grade rerolls.
--
-- TraitService.Roll(unitId, override) costs 1 "Trait Reroll"; GradeService.Roll
-- costs 1 "Gems". Both have a 0.25s debounce and refuse to replace a trait /
-- grade the player protected in-game unless override is true. Override is
-- only sent for the "best unit" goal when the player turned it on, and only
-- while that unit is still below its goal.
--
-- "Better" depends on what the unit is for: on the plot only income counts,
-- in the tower damage x health counts. A unit is done when its current
-- trait / grade scores at least as high as the chosen goal.
local G = import("game")
local Util = import("util")
local Log = import("log")
local Config = import("config")
local Tower = import("tower")
local Gear = import("gear")
local Farm = import("farm")

local Reroll = {}

Reroll.stats = { traitRolls = 0, gradeRolls = 0, best = {} }

local KINDS = {
	trait = {
		module = "Traits.Traits",
		service = "TraitService",
		item = "Trait Reroll",
		attr = "trait",
		cfg = "traits",
	},
	grade = {
		module = "Grades.Grades",
		service = "GradeService",
		item = "Gems",
		attr = "grade",
		cfg = "grades",
	},
}

local function defs(kind)
	return G.mod(KINDS[kind].module)
end

-- Multiplier that matters for `purpose` ("Plot" = income, "Tower" = damage x health).
function Reroll.score(kind, name, purpose)
	local d = name and defs(kind)[name]
	if not d then
		return 1
	end
	if purpose == "Tower" then
		return (d.damageMultiplier or 1) * (d.healthMultiplier or 1)
	end
	return d.incomeMultiplier or 1
end

-- Names that improve `purpose`, weakest first (for the goal dropdown).
function Reroll.goalOptions(kind, purpose)
	local list = {}
	for name in pairs(defs(kind)) do
		if Reroll.score(kind, name, purpose) > 1 then
			table.insert(list, name)
		end
	end
	table.sort(list, function(a, b)
		return Reroll.score(kind, a, purpose) < Reroll.score(kind, b, purpose)
	end)
	return list
end

-- Chance (0-1) that one roll gives at least the goal score.
function Reroll.goalChance(kind, goal, purpose)
	local luckName = kind == "trait" and "Trait Luck" or "Grade Luck"
	local ok, LW = pcall(function()
		return require(game:GetService("ReplicatedStorage").Framework.Utils.LuckWeights)
	end)
	if not ok then
		return 0
	end
	local need = Reroll.score(kind, goal, purpose)
	local p = 0
	for name in pairs(defs(kind)) do
		if Reroll.score(kind, name, purpose) >= need then
			p += LW.GetChance(defs(kind), name, G.buff(luckName)) / 100
		end
	end
	return p
end

local function protectedInGame(kind, name)
	if not name then
		return false
	end
	local list = G.get(kind == "trait" and "ProtectedTraits" or "ProtectedGrades") or {}
	return list[name] == true
end

-- Chance (0-1) to reach the goal at least once within `rolls` rolls.
function Reroll.successChance(kind, goal, purpose, rolls)
	local p = Reroll.goalChance(kind, goal, purpose)
	if p <= 0 or rolls <= 0 then
		return 0
	end
	return 1 - (1 - p) ^ rolls
end

-- Rolls expected before the goal shows up (the "save until" default).
function Reroll.expectedRolls(kind, goal, purpose)
	local p = Reroll.goalChance(kind, goal, purpose)
	return p > 0 and math.ceil(1 / p) or math.huge
end

-- Value of the unit without its current trait / grade, used to rank units.
local function baseValue(kind, u, purpose)
	local current = u[KINDS[kind].attr]
	if purpose == "Tower" then
		return u.damage * u.health / Reroll.score(kind, current, "Tower")
	end
	return u.income / Reroll.score(kind, current, "Plot")
end

-- Income of `u` if its trait / grade were `value`, using the game's own formula.
function Reroll.incomeWith(kind, u, value)
	local e = G.inventory()[u.id]
	local cfg = e and G.entryConfig(e.name)
	if not cfg or type(cfg.income) ~= "function" then
		return u.income
	end
	local a = table.clone(e.attributes)
	a[KINDS[kind].attr] = value
	local ok, v = pcall(cfg.income, a)
	return ok and v or u.income
end

local function plotSlots()
	local ok, n = pcall(function()
		local PC = G.mod("PlotConfig")
		local count = 0
		for i = 1, PC.GetMaxSlots() do
			if PC.GetSlotRebirthRequirement(i) <= G.rebirths() then
				count += 1
			end
		end
		return count
	end)
	return ok and n or 0
end

-- Units the reroll plan is about to work on; selling must leave them alone.
local planned = { trait = {}, grade = {} }

function Reroll.protectedIds()
	local set = {}
	for _, ids in pairs(planned) do
		for id in pairs(ids) do
			set[id] = true
		end
	end
	return set
end

-- Plot purpose: every unit counts, not only the placed ones. A unit in the
-- bag is worth rolling when its income with the goal would beat the weakest
-- unit Equip Best keeps on the plot; `gain` is the extra money per second.
local function plotCandidates(kind, c)
	local all = G.units()
	table.sort(all, function(a, b)
		return a.income > b.income
	end)
	local slots = plotSlots()
	local onPlot, weakest = {}, 0
	if Farm.placeMode() == "Potential" then
		-- the plot is picked by potential: grade exactly those units
		for _, u in ipairs(Farm.plotTarget()) do
			onPlot[u.id] = true
		end
		weakest = math.huge
	else
		for i = 1, math.min(slots, #all) do
			onPlot[all[i].id] = true
		end
		if slots > 0 and #all >= slots then
			weakest = all[slots].income
		end
	end
	-- "best units" = highest income without their current trait / grade
	local byBase = table.clone(all)
	table.sort(byBase, function(a, b)
		return baseValue(kind, a, "Plot") > baseValue(kind, b, "Plot")
	end)
	local topIds = {}
	if c.topGoal and c.topGoal ~= "Off" then
		for i = 1, math.min(c.topCount or 0, #byBase) do
			topIds[byBase[i].id] = true
		end
	end
	local out = {}
	for _, u in ipairs(all) do
		local top = topIds[u.id] == true
		local goal = top and c.topGoal or c.goal
		local need = Reroll.score(kind, goal, "Plot")
		local current = u[KINDS[kind].attr]
		local override = top and c.topOverride == true
		if Reroll.score(kind, current, "Plot") < need and (override or not protectedInGame(kind, current)) then
			local potential = Reroll.incomeWith(kind, u, goal)
			local gain = onPlot[u.id] and (potential - u.income) or (potential - weakest)
			if gain > 0 or top then
				table.insert(out, {
					unit = u, need = need, goal = goal, override = override, top = top,
					gain = gain, potential = potential, placed = onPlot[u.id] == true,
				})
			end
		end
	end
	-- best deal first: extra money per second for each Gem / reroll it is
	-- expected to cost (S needs ~95 Gems, Z+ ~9,500)
	for _, e in ipairs(out) do
		e.cost = Reroll.expectedRolls(kind, e.goal, "Plot")
		e.value = math.max(e.gain, 0) / math.max(e.cost, 1)
	end
	table.sort(out, function(a, b)
		if a.value ~= b.value then
			return a.value > b.value
		end
		return a.gain > b.gain
	end)
	return out
end

-- Work list, most valuable first. Each entry: { unit, need, goal, override, top }.
-- The best `topCount` units aim for `topGoal`; override lets them replace a
-- grade the game protects, but only while it is still below that goal.
function Reroll.candidates(kind)
	local c = Config.get(KINDS[kind].cfg)
	local purpose = c.purpose or "Plot"
	if purpose ~= "Tower" then
		local out = plotCandidates(kind, c)
		local ids = {}
		for i = 1, math.min(3, #out) do
			ids[out[i].unit.id] = true
		end
		planned[kind] = ids
		return out, purpose
	end
	local pool = {}
	if purpose == "Tower" then
		local plan = Tower.cached()
		local ids = {}
		for _, id in pairs(G.towerTeamIds()) do
			ids[id] = true
		end
		for _, u in ipairs(plan and plan.team or {}) do
			ids[u.id] = true
		end
		for _, u in ipairs(G.units()) do
			if ids[u.id] then
				table.insert(pool, u)
			end
		end
	else
		local placed = G.placedIds()
		for _, u in ipairs(G.units()) do
			if placed[u.id] then
				table.insert(pool, u)
			end
		end
	end
	table.sort(pool, function(a, b)
		return baseValue(kind, a, purpose) > baseValue(kind, b, purpose)
	end)
	local topCount = c.topCount or 0
	local out = {}
	for i, u in ipairs(pool) do
		local top = i <= topCount and c.topGoal ~= nil and c.topGoal ~= "Off"
		local goal = top and c.topGoal or c.goal
		local need = Reroll.score(kind, goal, purpose)
		local current = u[KINDS[kind].attr]
		local below = Reroll.score(kind, current, purpose) < need
		local override = top and c.topOverride == true
		if below and (override or not protectedInGame(kind, current)) then
			table.insert(out, { unit = u, need = need, goal = goal, override = override, top = top })
		end
	end
	return out, purpose
end

-- Rolls one unit until it reaches its goal, the budget runs out or the task stops.
local function work(kind, ctx)
	local k = KINDS[kind]
	local c = Config.get(k.cfg)
	local list, purpose = Reroll.candidates(kind)
	local have = G.itemCount(k.item)
	local keep = c.keep or 0
	-- The list is sorted best first, so a top unit comes first. It only starts
	-- once enough is saved for a fair chance, and while it saves nothing else
	-- spends from the same pile.
	local job = list[1]
	if not job then
		return "Ready", "all units reached their goal"
	end
	-- a chase that already started (its old grade is gone) is finished first
	if c.chasing and c.chasing ~= "" then
		for _, entry in ipairs(list) do
			if entry.unit.id == c.chasing then
				job = entry
				break
			end
		end
	end
	-- "chasing" is saved in the config so a reload mid-chase keeps going
	if job.top and c.chasing ~= job.unit.id then
		local saveUntil = (c.saveUntil or 0) > 0 and c.saveUntil or Reroll.expectedRolls(kind, job.goal, purpose)
		if have - keep < saveUntil then
			return "Waiting", ("saving %s for %s on %s: %s / %s"):format(k.item, job.goal, job.unit.name, Util.fmt(have), Util.fmt(saveUntil))
		end
	end
	if have <= keep then
		return "Waiting", ("out of %s (keep %d)"):format(k.item, keep)
	end
	local unit = job.unit
	if job.top and c.chasing ~= unit.id then
		Config.set(k.cfg .. ".chasing", unit.id)
	end
	local fire = kind == "trait" and G.remote.rollTrait or G.remote.rollGrade
	local maxPerRun = job.top and math.huge or (c.maxPerRun or 50)
	local rolled = 0
	local function loop()
		while rolled < maxPerRun do
			if ctx and not ctx.alive() then
				break
			end
			local left = G.itemCount(k.item)
			if left <= keep then
				break
			end
			local entry = G.inventory()[unit.id]
			if not entry then
				break
			end
			local current = entry.attributes[k.attr]
			if Reroll.score(kind, current, purpose) >= job.need then
				break
			end
			if not job.override and protectedInGame(kind, current) then
				break
			end
			fire(unit.id, job.override)
			-- the attribute may re-roll to the same value, so watch the item count
			if not Util.waitFor(function()
				return G.itemCount(k.item) < left
			end, 3, 0.05) then
				break
			end
			rolled += 1
			Reroll.stats[kind .. "Rolls"] += 1
			task.wait(0.3) -- server debounce 0.25s
		end
	end
	if c.luckGear ~= false then
		Gear.withProfile(kind == "trait" and "Trait" or "Grade", loop)
	else
		loop()
	end
	local now = (G.inventory()[unit.id] or { attributes = {} }).attributes[k.attr]
	local reached = Reroll.score(kind, now, purpose) >= job.need
	if reached and job.placed == false then
		-- it now beats a unit on the plot: put it there right away
		Farm.equipBest()
	end
	if reached then
		if c.chasing == unit.id then
			Config.set(k.cfg .. ".chasing", "")
		end
		Log.good(kind == "trait" and "Trait" or "Grade", ("%s got %s after %d rolls"):format(unit.name, tostring(now), rolled))
	end
	return "Ready", ("%s: %s → goal %s (%d rolls)%s"):format(unit.name, tostring(now), job.goal, rolled, reached and " ✓" or "")
end

function Reroll.runTraits(ctx)
	return work("trait", ctx)
end

function Reroll.runGrades(ctx)
	return work("grade", ctx)
end

return Reroll
end
__modules["rewards"] = function(...)
-- Free claims: quests, daily reward, offline earnings, group reward, codes.
local G = import("game")
local Util = import("util")
local Log = import("log")
local Config = import("config")

local Rewards = {}

function Rewards.claimQuests()
	local periods = G.mod("QuestConfig").Periods
	local data = G.get("Quests") or {}
	local claimed = 0
	for period, pcfg in pairs(periods) do
		local q = data[period]
		if q then
			for _, quest in ipairs(pcfg.quests or {}) do
				local progress = (q.progress or {})[quest.id] or 0
				if progress >= quest.target and not (q.claimed or {})[quest.id] then
					-- expiresAt must match the server value at claim time
					local fresh = (G.get("Quests") or {})[period]
					G.remote.claimQuest(period, quest.id, fresh and fresh.expiresAt or q.expiresAt)
					if Util.waitFor(function()
						local now = (G.get("Quests") or {})[period]
						return now and now.claimed and now.claimed[quest.id]
					end, 3) then
						claimed += 1
						Log.good("Quest", ("claimed %s %s (+%s tickets)"):format(period, quest.id, tostring(quest.tickets)))
					end
					task.wait(0.3)
				end
			end
		end
	end
	return "Ready", claimed > 0 and ("claimed " .. claimed) or "no finished quests"
end

-- Seconds until the daily reward, 0 when claimable.
function Rewards.dailyIn()
	local last = G.get("LastDailyRewardClaim") or 0
	if last == 0 then
		return 0
	end
	local ok, cfg = pcall(G.mod, "DailyRewardConfig")
	local cd = ok and cfg.Cooldown or 86400
	return math.max(0, cd - (os.time() - last))
end

local groupChecked, inGroup = false, false

function Rewards.claimAll()
	local done = {}
	if Config.get("rewards.daily") and Rewards.dailyIn() == 0 then
		local before = G.get("LastDailyRewardClaim") or 0
		G.remote.claimDaily()
		if Util.waitFor(function()
			return (G.get("LastDailyRewardClaim") or 0) ~= before
		end, 3) then
			table.insert(done, "daily")
		end
	end
	if Config.get("rewards.offline") and (G.get("PendingOfflineEarnings") or 0) > 0 then
		local amount = G.get("PendingOfflineEarnings")
		G.remote.claimOffline()
		if Util.waitFor(function()
			return (G.get("PendingOfflineEarnings") or 0) == 0
		end, 3) then
			table.insert(done, "offline $" .. Util.fmt(amount))
		end
	end
	if Config.get("rewards.group") and not G.get("ClaimedGroupReward") then
		if not groupChecked then
			groupChecked = true
			inGroup = game.CreatorType == Enum.CreatorType.Group
				and select(2, pcall(G.player.IsInGroup, G.player, game.CreatorId)) == true
		end
		if inGroup then
			G.remote.claimGroup()
			if Util.waitFor(function()
				return G.get("ClaimedGroupReward")
			end, 3) then
				table.insert(done, "group")
			end
		end
	end
	for _, d in ipairs(done) do
		Log.good("Rewards", "claimed " .. d)
	end
	if #done > 0 then
		return "Ready", "claimed " .. table.concat(done, ", ")
	end
	return "Ready", "daily in " .. Util.fmtTime(Rewards.dailyIn())
end

---------------------------------------------------------------- codes

-- Codes known outside the game config (from the player's list).
local EXTRA_CODES = {
	"UPDATE6", "400KLIKES", "UPDATE5", "250KLIKES", "1KCCU", "100KLIKES", "40KCCU", "30KCCU",
	"20KCCU", "10KCCU", "5KCCU", "UPDATE4", "UPDATE3", "UPDATE2", "UPDATE1", "RELEASE",
}

local failedCodes = {} -- rejected this session (invalid / expired / used up)

local function normalize(code)
	local ok, v = pcall(function()
		return G.mod("Codes.CodeUtil").Normalize(code)
	end)
	return ok and v or tostring(code):upper():gsub("%s", "")
end

function Rewards.codeList()
	local seen, list = {}, {}
	local ok, cfg = pcall(G.mod, "Codes.CodesConfig")
	local function add(c)
		c = normalize(c)
		if c ~= "" and not seen[c] then
			seen[c] = true
			table.insert(list, c)
		end
	end
	if ok and type(cfg) == "table" then
		for code in pairs(cfg) do
			add(code)
		end
	end
	for _, c in ipairs(EXTRA_CODES) do
		add(c)
	end
	for _, c in ipairs(Config.get("codes.custom") or {}) do
		add(c)
	end
	table.sort(list)
	return list
end

function Rewards.codeState(code)
	if (G.get("RedeemedCodes") or {})[code] then
		return "done"
	elseif failedCodes[code] then
		return "blocked"
	end
	return "progress"
end

function Rewards.redeemAll()
	local sent, got = 0, 0
	for _, code in ipairs(Rewards.codeList()) do
		if Rewards.codeState(code) == "progress" then
			sent += 1
			G.remote.redeemCode(code)
			if Util.waitFor(function()
				return (G.get("RedeemedCodes") or {})[code]
			end, 4) then
				got += 1
				Log.good("Codes", "redeemed " .. code)
			else
				failedCodes[code] = true
				Log.warn("Codes", code .. " was not accepted (invalid, expired or used up)")
			end
			task.wait(0.8) -- server debounce is 0.5s
		end
	end
	if sent == 0 then
		return "Ready", "all codes redeemed"
	end
	return "Ready", ("redeemed %d/%d"):format(got, sent)
end

function Rewards.redeem(code)
	code = normalize(code or "")
	if code == "" then
		return false, "empty"
	end
	if (G.get("RedeemedCodes") or {})[code] then
		return false, "already redeemed"
	end
	-- remember it so the auto redeemer retries it in later sessions
	local custom = table.clone(Config.get("codes.custom") or {})
	if not table.find(custom, code) then
		table.insert(custom, code)
		Config.set("codes.custom", custom)
	end
	failedCodes[code] = nil
	G.remote.redeemCode(code)
	local ok = Util.waitFor(function()
		return (G.get("RedeemedCodes") or {})[code]
	end, 4)
	if ok then
		Log.good("Codes", "redeemed " .. code)
		return true
	end
	failedCodes[code] = true
	return false, "not accepted"
end

return Rewards
end
__modules["scheduler"] = function(...)
-- Scheduler: one driver loop, each task runs in its own thread with an
-- enabled check, shared locks (money / inventory / tower) and error backoff.
local Log = import("log")
local UserInputService = game:GetService("UserInputService")

local Scheduler = {}

local tasks = {}
local order = {}
local locks = {}
local alive = false
local paused = false
local driver
local statusListeners = {}

local MAX_ERRORS = 5

local function setStatus(t, status, msg)
	t.status = status
	t.message = msg or ""
	for _, fn in ipairs(statusListeners) do
		pcall(fn, t)
	end
end

-- def = { id, name, priority, locks = {...}, interval = fn|number,
--         enabled = fn -> bool, run = fn(ctx) -> status?, msg? }
function Scheduler.register(def)
	assert(def.id and def.run, "task needs id and run")
	local t = {
		def = def,
		id = def.id,
		name = def.name or def.id,
		priority = def.priority or 50,
		status = "Off",
		message = "",
		running = false,
		nextRun = 0,
		errors = 0,
		runs = 0,
	}
	tasks[def.id] = t
	table.insert(order, t)
	table.sort(order, function(a, b)
		return a.priority < b.priority
	end)
	return t
end

function Scheduler.get(id)
	return tasks[id]
end

function Scheduler.all()
	return order
end

-- Returns a function that removes the listener again.
function Scheduler.onStatus(fn)
	table.insert(statusListeners, fn)
	return function()
		local i = table.find(statusListeners, fn)
		if i then
			table.remove(statusListeners, i)
		end
	end
end

local function isEnabled(t)
	local ok, v = pcall(t.def.enabled)
	return ok and v == true
end

-- A switch that was already on when the script loaded (a saved profile) does nothing until the player
-- says so: a task runs only once it is armed — its switch turned on in this session (main.lua), "continue"
-- on the start prompt, or the resume after a server hop. Waiting tasks show "Held".
local armedAll = false
local armed = {}

local function isArmed(t)
	return armedAll or armed[t.id] == true
end

function Scheduler.arm(id)
	armed[id] = true
end

function Scheduler.armAll()
	armedAll = true
end

function Scheduler.disarmAll()
	armedAll = false
	table.clear(armed)
end

function Scheduler.allArmed()
	return armedAll
end

function Scheduler.armedIds()
	local out = {}
	for id in pairs(armed) do
		table.insert(out, id)
	end
	return out
end

-- tasks whose switch is on but that wait for the player
function Scheduler.held()
	local out = {}
	for _, t in ipairs(order) do
		if isEnabled(t) and not t.suspended and not isArmed(t) then
			table.insert(out, t)
		end
	end
	return out
end

-- tasks that may run now
function Scheduler.active()
	local out = {}
	for _, t in ipairs(order) do
		if isEnabled(t) and not t.suspended and isArmed(t) then
			table.insert(out, t)
		end
	end
	return out
end

local function interval(t)
	local iv = t.def.interval
	if type(iv) == "function" then
		local ok, v = pcall(iv)
		iv = ok and v or 5
	end
	return math.max(0.1, tonumber(iv) or 5)
end

local function tryLocks(t)
	for _, name in ipairs(t.def.locks or {}) do
		if locks[name] and locks[name] ~= t.id then
			return false, name
		end
	end
	for _, name in ipairs(t.def.locks or {}) do
		locks[name] = t.id
	end
	return true
end

local function releaseLocks(t)
	for _, name in ipairs(t.def.locks or {}) do
		if locks[name] == t.id then
			locks[name] = nil
		end
	end
end

-- A manual run (Run button) keeps going while the toggle is off; it stops on
-- pause / stop all like any other run.
local function makeCtx(t, manual)
	local ctx = {}
	function ctx.alive()
		return alive and not paused and not t.suspended and (manual or (isEnabled(t) and isArmed(t)))
	end
	function ctx.wait(sec)
		task.wait(sec)
		return ctx.alive()
	end
	function ctx.status(msg)
		setStatus(t, "Running", msg)
	end
	return ctx
end

local function runTask(t, manual)
	if not alive or paused or (not manual and not (isEnabled(t) and isArmed(t))) then return end
	t.running = true
	local okLock, lockName = tryLocks(t)
	if not okLock then
		t.running = false
		setStatus(t, "Waiting", "lock busy: " .. lockName)
		t.nextRun = os.clock() + 1
		return
	end
	setStatus(t, "Running", manual and "manual run" or "")
	local ok, status, msg = pcall(t.def.run, makeCtx(t, manual), manual)
	releaseLocks(t)
	t.running = false
	t.lastRun = os.time()
	t.runs += 1
	if ok then
		t.errors = 0
		setStatus(t, status or "Ready", msg)
	else
		t.errors += 1
		Log.error(t.name, status)
		setStatus(t, "Error", tostring(status))
		if t.errors >= MAX_ERRORS and not t.suspended then
			-- suspended until "Reset errors", also when the Auto page enables it
			t.suspended = true
			if t.def.onDisable then
				pcall(t.def.onDisable, "too many errors")
			end
			Log.warn(t.name, "suspended after " .. MAX_ERRORS .. " errors in a row (Misc > Reset errors)")
		end
	end
	t.nextRun = os.clock() + interval(t) * (t.errors > 0 and math.min(2 ^ t.errors, 16) or 1)
end

-- Run a task once from a button, even if its toggle is off.
function Scheduler.runOnce(id)
	local t = tasks[id]
	if not alive or paused or not t or t.running then
		return false
	end
	task.spawn(runTask, t, true)
	return true
end

function Scheduler.resetErrors()
	for _, t in ipairs(order) do
		t.errors = 0
		t.suspended = false
		if t.status == "Error" then
			setStatus(t, isEnabled(t) and "Ready" or "Off")
		end
	end
end

function Scheduler.setPaused(v)
	paused = v
end

function Scheduler.isPaused()
	return paused
end

function Scheduler.start()
	if alive then
		return
	end
	alive = true
	if UserInputService.TouchEnabled then
		local now = os.clock()
		for i, t in ipairs(order) do
			t.nextRun = math.max(t.nextRun, now + (i - 1) * 0.35)
		end
	end
	driver = task.spawn(function()
		while alive do
			local now = os.clock()
			for _, t in ipairs(order) do
				if not alive then
					break
				end
				local enabled = isEnabled(t) and not t.suspended
				if not enabled then
					if t.status ~= "Off" and not t.running and t.status ~= "Error" then
						-- keep the last message so a manual Run's result stays visible
						setStatus(t, "Off", t.message)
					end
				elseif paused then
					if t.status ~= "Paused" and not t.running then
						setStatus(t, "Paused")
					end
				elseif not isArmed(t) then
					if t.status ~= "Held" and not t.running then
						setStatus(t, "Held")
					end
				elseif not t.running and now >= t.nextRun then
					task.spawn(runTask, t, false)
				end
			end
			task.wait(0.25)
		end
	end)
end

function Scheduler.stop()
	alive = false
	for _, t in ipairs(order) do
		if t.running and not paused and t.def.onStop then
			pcall(t.def.onStop)
		end
	end
end

return Scheduler
end
