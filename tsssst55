__modules["farm"] = function(...)
-- Money loop features: collect, plot equip best, dice, rebirth, upgrades, level up.
local G = import("game")
local Util = import("util")
local Log = import("log")
local Config = import("config")

local Farm = {}

Farm.stats = { collected = 0, rebirths = 0, diceBought = 0, upgradesBought = 0, levels = 0, started = os.clock() }

local function slotUnlocked(i)
	local ok, req = pcall(function()
		return G.mod("PlotConfig").GetSlotRebirthRequirement(i)
	end)
	return ok and req <= G.rebirths()
end

local function maxSlots()
	local ok, n = pcall(function()
		return G.mod("PlotConfig").GetMaxSlots()
	end)
	return ok and n or 16
end

function Farm.unlockedSlots()
	local out = {}
	for i = 1, maxSlots() do
		if slotUnlocked(i) then
			table.insert(out, i)
		end
	end
	return out
end

-- Spending check shared by dice / upgrades / level up. In auto mode with
-- rebirth on, only buy things costing at most 25% of the next rebirth, so
-- purchases (which survive rebirth) never stall the next rebirth for long.
local AUTO_REBIRTH_SHARE = 0.25

function Farm.canSpend(price, reserve)
	if G.money() - price < (reserve or 0) then
		return false, "not enough money"
	end
	if Config.auto("progress") then
		local nxt = Farm.rebirthInfo()
		-- fine if it is cheap, or if the rebirth stays affordable after buying
		if nxt and price > nxt.cost * AUTO_REBIRTH_SHARE and G.money() - price < nxt.cost then
			return false, "saving for rebirth"
		end
	end
	return true
end

---------------------------------------------------------------- collect

function Farm.collect(ctx)
	local slots = G.slots()
	local total, count = 0, 0
	for _, i in ipairs(Farm.unlockedSlots()) do
		local s = slots[tostring(i)] or slots[i]
		if s and (s.balance or 0) > 0 then
			total += s.balance
			count += 1
			G.remote.collect(i)
			task.wait(0.05)
		end
	end
	Farm.stats.collected += total
	if count == 0 then
		return "Ready", "nothing to collect"
	end
	return "Ready", ("collected $%s from %d slots"):format(Util.fmt(total), count)
end

---------------------------------------------------------------- equip best (plot)

-- Two ways to pick the plot:
--   "Income"    — the game's Equip Best: highest income right now.
--   "Potential" — income each unit would make at the same standard grade and
--                 level (default S, level 30), keeping its own mutation and
--                 trait. A unit that is only behind because it was never
--                 graded / leveled wins here, then gets graded and leveled.
function Farm.potentialIncome(u)
	local e = G.inventory()[u.id]
	local cfg = e and G.entryConfig(e.name)
	if not cfg or type(cfg.income) ~= "function" then
		return u.income
	end
	local a = table.clone(e.attributes)
	a.grade = Config.get("equipBest.standardGrade") or "S"
	a.level = Config.get("equipBest.standardLevel") or 30
	local ok, v = pcall(cfg.income, a)
	return ok and v or u.income
end

function Farm.placeMode()
	return Config.get("equipBest.mode") == "Income" and "Income" or "Potential"
end

-- The units that should be on the plot, best first.
function Farm.plotTarget()
	local units = G.units()
	local potential = Farm.placeMode() == "Potential"
	for _, u in ipairs(units) do
		u.score = potential and Farm.potentialIncome(u) or u.income
	end
	table.sort(units, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.id < b.id
	end)
	local out = {}
	for i = 1, math.min(#units, #Farm.unlockedSlots()) do
		out[i] = units[i]
	end
	return out
end

function Farm.bestPlotDiffers()
	local want = {}
	for _, u in ipairs(Farm.plotTarget()) do
		want[u.id] = true
	end
	local placed = G.placedIds()
	for id in pairs(want) do
		if not placed[id] then
			return true
		end
	end
	for id in pairs(placed) do
		if not want[id] then
			return true
		end
	end
	return false
end

-- Put the "Potential" target on the plot slot by slot: hold the unit
-- (UnitService.Equip) and press the slot (PlotService.InteractSlot). Placing
-- over a unit resets that slot's cash to 0, so everything is collected first.
function Farm.placePotential(ctx)
	Farm.collect()
	local target = Farm.plotTarget()
	local want = {}
	for _, u in ipairs(target) do
		want[u.id] = true
	end
	local placed = G.placedIds()
	local missing = {}
	for _, u in ipairs(target) do
		if not placed[u.id] then
			table.insert(missing, u)
		end
	end
	local moved = 0
	for _, slot in ipairs(Farm.unlockedSlots()) do
		if #missing == 0 or (ctx and not ctx.alive()) then
			break
		end
		local s = G.slots()[tostring(slot)]
		local current = s and s.unitId
		if not current or not want[current] then
			local u = table.remove(missing, 1)
			local okEquip, held = G.remote.equipUnit(u.id)
			if okEquip and held then
				task.wait(0.6) -- UnitAction debounce 0.5s
				G.remote.interactSlot(slot)
				if Util.waitFor(function()
					local now = G.slots()[tostring(slot)]
					return now and now.unitId == u.id
				end, 3) then
					moved += 1
				end
				task.wait(0.6) -- PlotSlotInteraction debounce 0.5s
			end
		end
	end
	pcall(G.remote.unequipUnit)
	if moved > 0 then
		Log.good("Plot", ("placed %d unit(s) by potential"):format(moved))
	end
	return moved
end

function Farm.equipBest(ctx)
	if not Farm.bestPlotDiffers() then
		return "Ready", "plot already best"
	end
	if Farm.placeMode() == "Potential" then
		local moved = Farm.placePotential(ctx)
		return "Ready", ("placed %d unit(s) by potential"):format(moved)
	end
	Farm.collect()
	G.remote.equipBestPlot()
	local ok = Util.waitFor(function()
		return not Farm.bestPlotDiffers()
	end, 4)
	return "Ready", ok and "placed best units" or "sent EquipBest (no change seen yet)"
end

---------------------------------------------------------------- dice

function Farm.diceList()
	local list = {}
	for name, d in pairs(G.mod("Dice").GetAll()) do
		table.insert(list, { name = name, price = d.price or 0, luck = d.luck or 0, rarity = d.rarity })
	end
	table.sort(list, function(a, b)
		return a.price < b.price
	end)
	return list
end

function Farm.nextDice()
	local owned = G.get("OwnedDice") or {}
	for _, d in ipairs(Farm.diceList()) do
		if not owned[d.name] and d.price > 0 then
			return d
		end
	end
end

function Farm.buyDice()
	local owned = G.get("OwnedDice") or {}
	local reserve = Config.get("dice.reserve") or 0
	local maxPrice = Config.get("dice.maxPrice") or 0
	local target = Config.get("dice.target")
	local bought = 0
	for _, d in ipairs(Farm.diceList()) do
		if not owned[d.name] and d.price > 0 then
			if maxPrice > 0 and d.price > maxPrice then
				return "Waiting", "next dice above max price"
			end
			local okSpend, why = Farm.canSpend(d.price, reserve)
			if not okSpend then
				return "Waiting", ("next: %s $%s (%s)"):format(d.name, Util.fmt(d.price), why)
			end
			G.remote.buyDice(d.name)
			if Util.waitFor(function()
				return (G.get("OwnedDice") or {})[d.name]
			end, 3) then
				bought += 1
				Farm.stats.diceBought += 1
				Log.good("Dice", ("bought %s for $%s"):format(d.name, Util.fmt(d.price)))
			else
				return "Waiting", "purchase of " .. d.name .. " not confirmed"
			end
			if target and target ~= "Off" and d.name == target then
				Config.set("dice.buy", false)
				return "Ready", "reached target dice " .. target
			end
			task.wait(0.6) -- DiceShop debounce
			owned = G.get("OwnedDice") or {}
		end
	end
	return "Ready", bought > 0 and ("bought " .. bought) or "all dice owned"
end

-- Equip the owned dice with the highest luck.
function Farm.equipBestDice()
	local owned = G.get("OwnedDice") or {}
	local current = G.get("Dice")
	local all = G.mod("Dice").GetAll()
	local best, bestLuck = current, (all[current] and all[current].luck) or 0
	for name in pairs(owned) do
		local d = all[name]
		if d and (d.luck or 0) > bestLuck then
			best, bestLuck = name, d.luck
		end
	end
	if best and best ~= current then
		G.remote.equipDice(best)
		return true, best
	end
	return false, current
end

---------------------------------------------------------------- rebirth

Farm.rebirthsThisSession = 0

function Farm.rebirthInfo()
	local ok, nxt = pcall(function()
		return G.mod("Rebirths").GetNext(G.rebirths())
	end)
	return ok and nxt or nil
end

function Farm.rebirth()
	local nxt = Farm.rebirthInfo()
	if not nxt then
		return "Blocked", "max rebirth"
	end
	local limit = Config.get("rebirth.maxPerSession") or 0
	if limit > 0 and Farm.rebirthsThisSession >= limit then
		return "Blocked", "session limit reached"
	end
	local need = nxt.cost * (1 + (Config.get("rebirth.extraPct") or 0) / 100)
	local slotsTotal = 0
	for _, s in pairs(G.slots()) do
		slotsTotal += s.balance or 0
	end
	if G.money() + slotsTotal < need then
		return "Waiting", ("$%s / $%s"):format(Util.fmt(G.money()), Util.fmt(need))
	end
	Farm.collect()
	if not Util.waitFor(function()
		return G.money() >= nxt.cost
	end, 3) then
		return "Waiting", "money not enough after collect"
	end
	local before = G.rebirths()
	G.remote.rebirth()
	if Util.waitFor(function()
		return G.rebirths() > before
	end, 4) then
		Farm.rebirthsThisSession += 1
		Farm.stats.rebirths += 1
		Log.good("Rebirth", "rebirth " .. G.rebirths())
		return "Ready", "rebirth " .. G.rebirths()
	end
	return "Waiting", "rebirth not confirmed"
end

---------------------------------------------------------------- upgrades

function Farm.upgradeLine(name)
	return name:match("^(.-) [IVXLC]+$") or name
end

function Farm.upgradeCandidates()
	local owned = G.get("Upgrades") or {}
	local lines = Config.get("upgrades.lines") or {}
	local Tree = G.mod("TreeStructure")
	local list = {}
	for name, u in pairs(G.mod("Upgrades")) do
		if type(u) == "table" and u.price and not owned[name] then
			local okP, parent = pcall(Tree.GetParent, name)
			local parentOk = (not okP) or parent == nil or parent == "Start" or owned[parent]
			if parentOk and lines[Farm.upgradeLine(name)] then
				table.insert(list, { name = name, price = u.price })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.price < b.price
	end)
	return list
end

function Farm.buyUpgrades(ctx)
	local reserve = Config.get("upgrades.reserve") or 0
	local bought = 0
	for _ = 1, 10 do
		local c = Farm.upgradeCandidates()[1]
		if not c then
			return "Ready", bought > 0 and ("bought " .. bought) or "nothing available"
		end
		local okSpend, why = Farm.canSpend(c.price, reserve)
		if not okSpend then
			return "Waiting", ("next: %s $%s (%s)"):format(c.name, Util.fmt(c.price), why)
		end
		G.remote.buyUpgrade(c.name)
		if not Util.waitFor(function()
			return (G.get("Upgrades") or {})[c.name]
		end, 3) then
			return "Waiting", "upgrade " .. c.name .. " not confirmed"
		end
		bought += 1
		Farm.stats.upgradesBought += 1
		Log.good("Upgrade", ("bought %s for $%s"):format(c.name, Util.fmt(c.price)))
		if ctx and not ctx.alive() then
			break
		end
	end
	return "Ready", "bought " .. bought
end

---------------------------------------------------------------- level up placed units

-- Seconds of extra income needed to pay back one level of `e` (math.huge if none).
local function payback(e, price)
	local cfg = G.entryConfig(e.name)
	if not cfg or type(cfg.income) ~= "function" then
		return math.huge
	end
	local nextAttrs = table.clone(e.attributes)
	nextAttrs.level = (e.attributes.level or 1) + 1
	local okA, now = pcall(cfg.income, e.attributes)
	local okB, after = pcall(cfg.income, nextAttrs)
	local gain = (okA and okB) and (after - now) * G.buff("Money Multiplier") or 0
	return gain > 0 and price / gain or math.huge
end

-- Money per second from the plot, incl. Money Multiplier.
function Farm.incomePerSec()
	local inv = G.inventory()
	local total = 0
	for _, s in pairs(G.slots()) do
		local e = s.unitId and inv[s.unitId]
		if e then
			local info = G.unitInfo(s.unitId, e)
			total += info and info.income or 0
		end
	end
	return total * G.buff("Money Multiplier")
end

-- Next level-up of every placed unit, fastest payback first:
-- { name, level, price, gain (money/s), payback (s), grade }
function Farm.levelOptions()
	local UnitUtil = G.mod("UnitUtil")
	local mm = G.buff("Money Multiplier")
	local inv = G.inventory()
	local out = {}
	for _, s in pairs(G.slots()) do
		local e = s.unitId and inv[s.unitId]
		local cfg = e and G.entryConfig(e.name)
		if cfg and type(cfg.income) == "function" then
			local a = table.clone(e.attributes)
			local b = table.clone(a)
			b.level = (a.level or 1) + 1
			local okP, price = pcall(UnitUtil.GetLevelPrice, e.name, a)
			local okA, now = pcall(cfg.income, a)
			local okB, after = pcall(cfg.income, b)
			if okP and okA and okB then
				local gain = (after - now) * mm
				table.insert(out, {
					name = e.name, level = a.level or 1, price = price, gain = gain, grade = a.grade,
					payback = gain > 0 and price / gain or math.huge,
				})
			end
		end
	end
	table.sort(out, function(x, y)
		return x.payback < y.payback
	end)
	return out
end

-- Seconds until the next rebirth is affordable at the current income.
function Farm.secondsToRebirth()
	local nxt = Farm.rebirthInfo()
	local income = Farm.incomePerSec()
	if not nxt or income <= 0 then
		return math.huge
	end
	return math.max(0, (nxt.cost - G.money()) / income)
end

-- Longest payback worth buying. Levels stay after a rebirth, so a level that
-- pays back within a quarter of the wait for the next rebirth is a good deal.
-- levelUp.maxPayback > 0 overrides this.
function Farm.levelPaybackLimit()
	local set = Config.get("levelUp.maxPayback") or 0
	if set > 0 then
		return set
	end
	local wait = Farm.secondsToRebirth()
	if wait == math.huge then
		return 7200
	end
	return math.clamp(wait * 0.25, 600, 7200)
end

-- Levels placed units. A level is bought when it is below the target level
-- (0 = no cap) and pays for itself within the payback limit; the fastest
-- payback goes first. Level price ignores grade and trait, so S-grade units
-- come first by themselves.
function Farm.levelUp(ctx)
	local reserve = Config.get("levelUp.reserve") or 0
	local target = Config.get("levelUp.targetLevel") or 0
	local maxPayback = Farm.levelPaybackLimit()
	local maxPer = Config.get("levelUp.maxPerRound") or 5
	local UnitUtil = G.mod("UnitUtil")
	local done = 0
	for _ = 1, maxPer do
		local inv = G.inventory()
		local best
		for key, s in pairs(G.slots()) do
			local i = tonumber(key)
			local e = s.unitId and inv[s.unitId]
			local level = e and (e.attributes.level or 1)
			if i and e and slotUnlocked(i) and (target <= 0 or level < target) then
				local okP, price = pcall(UnitUtil.GetLevelPrice, e.name, e.attributes)
				if okP and price then
					local pb = payback(e, price)
					if pb <= maxPayback and (not best or pb < best.payback) then
						best = { slot = i, id = s.unitId, price = price, level = level, name = e.name, payback = pb }
					end
				end
			end
		end
		if not best then
			return "Ready", done > 0 and ("leveled " .. done) or ("no level pays back within " .. Util.fmtTime(maxPayback))
		end
		local okSpend, why = Farm.canSpend(best.price, reserve)
		if not okSpend then
			return "Waiting", ("next: %s L%d $%s (%s)"):format(best.name, best.level + 1, Util.fmt(best.price), why)
		end
		G.remote.levelUpSlot(best.slot)
		if not Util.waitFor(function()
			local e = G.inventory()[best.id]
			return e and (e.attributes.level or 1) > best.level
		end, 3) then
			return "Waiting", "level up not confirmed"
		end
		done += 1
		Farm.stats.levels += 1
		if ctx and not ctx.alive() then
			break
		end
		task.wait(0.15)
	end
	return "Ready", "leveled " .. done
end

return Farm
end
__modules["game"] = function(...)
-- GameAdapter: the only module that knows remote names, argument shapes and
-- where game data lives. Everything else goes through these functions.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local G = {}
G.player = Players.LocalPlayer

local F -- ReplicatedStorage.Framework.Features
local mods = {}
local comms = {}
local weatherProperty
local DC -- DataController

local RARITY_ORDER = {
	"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Divine",
	"Exotic", "Celestial", "Secret I", "Secret II", "Heavenly", "Exclusive",
}
G.RARITY_ORDER = RARITY_ORDER
local rarityRank = {}
for i, name in ipairs(RARITY_ORDER) do
	rarityRank[name] = i
end

local MODULE_PATHS = {
	DataController = "Data.DataController",
	EntryRegistry = "Inventory.EntryRegistry",
	BuffController = "Buffs.BuffController",
	Dice = "Rolling.Dice",
	Rebirths = "Rebirth.Rebirths",
	Upgrades = "Upgrades.Upgrades",
	TreeStructure = "Upgrades.TreeStructure",
	PlotConfig = "Plot.PlotConfig",
	Towers = "Towers.Towers",
	TowerRefs = "Towers.TowerRefs",
	QuestConfig = "Quests.QuestConfig",
	UnitUtil = "Inventory.Kinds.Unit.UnitUtil",
	DailyRewardConfig = "Rewards.DailyRewardConfig",
	SellUtil = "Selling.SellUtil",
}

local function findModule(path)
	local inst = F
	for part in path:gmatch("[^%.]+") do
		inst = inst and inst:FindFirstChild(part)
	end
	return inst
end

function G.mod(name)
	if mods[name] == nil then
		local inst = findModule(MODULE_PATHS[name] or name)
		if not inst then
			error("module missing: " .. name)
		end
		mods[name] = require(inst)
	end
	return mods[name]
end

-- Bootstrap: wait for the framework and player data. Returns ok, reason.
function G.init(timeout)
	local deadline = os.clock() + (timeout or 30)
	while os.clock() < deadline do
		local fw = ReplicatedStorage:FindFirstChild("Framework")
		local net = ReplicatedStorage:FindFirstChild("Network")
		F = fw and fw:FindFirstChild("Features")
		if F and net and G.player then
			local ok, dc = pcall(G.mod, "DataController")
			if ok and dc then
				DC = dc
				local okMoney, money = pcall(function()
					return DC.Money()
				end)
				if okMoney and type(money) == "number" then
					return true
				end
			end
		end
		task.wait(0.5)
	end
	return false, "game data not ready (Framework/Network/DataController)"
end

---------------------------------------------------------------- remotes

local function comm(service)
	if not comms[service] then
		local Network = require(ReplicatedStorage.Packages.Network)
		comms[service] = Network.ClientComm.new(ReplicatedStorage.Network, false, service)
	end
	return comms[service]
end

-- The same replicated property used by the game's weather banner.
-- If it is unavailable, consumable event boosts stay unused.
function G.activeWeather()
	local ok, weather = pcall(function()
		weatherProperty = weatherProperty or comm("WeatherService"):GetProperty("ActiveWeather")
		return weatherProperty and weatherProperty:Get()
	end)
	return ok and type(weather) == "table" and weather.name or nil
end

local handles = {}

local function handle(service, name, isFunction)
	local key = service .. "/" .. name
	if not handles[key] then
		local c = comm(service)
		handles[key] = isFunction and c:GetFunction(name) or c:GetSignal(name)
	end
	return handles[key]
end

local function fire(service, name, ...)
	handle(service, name, false):Fire(...)
	return true
end

-- Returns pcall-style: ok, result... An InvokeServer never returns after a
-- disconnect, so give up after INVOKE_TIMEOUT instead of holding locks forever.
local INVOKE_TIMEOUT = 15

local function invoke(service, name, ...)
	local fn = handle(service, name, true)
	local args = table.pack(...)
	local result
	task.spawn(function()
		result = table.pack(pcall(fn, table.unpack(args, 1, args.n)))
	end)
	local deadline = os.clock() + INVOKE_TIMEOUT
	while not result and os.clock() < deadline do
		task.wait(0.05)
	end
	if not result then
		return false, "timeout (" .. name .. ")"
	end
	return table.unpack(result, 1, result.n)
end

-- Set when Roblox shows a disconnect / kick message.
G.disconnected = nil

local upgradeSignal
local function fireUpgrade(name)
	if not upgradeSignal then
		local Network = require(ReplicatedStorage.Packages.Network)
		upgradeSignal = Network.Client.GetSignal(ReplicatedStorage.Network, "BuyUpgrade")
	end
	upgradeSignal:Fire(name)
	return true
end

G.remote = {
	-- plot
	collect = function(slot) return fire("PlotService", "CollectBalance", slot) end,
	equipBestPlot = function() return fire("PlotService", "EquipBest") end,
	levelUpSlot = function(slot) return fire("PlotService", "LevelUpSlot", slot) end,
	-- hold a unit, then InteractSlot puts the held unit in that slot
	interactSlot = function(slot) return fire("PlotService", "InteractSlot", slot) end,
	equipUnit = function(unitId) return invoke("UnitService", "Equip", unitId) end,
	unequipUnit = function() return invoke("UnitService", "Unequip") end,
	-- rolling
	roll = function() return invoke("RollService", "RollDice") end,
