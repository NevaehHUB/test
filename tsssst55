            mk("UITextSizeConstraint", { MaxTextSize = fontPx(12.5), MinTextSize = 7 }, nameText)
            local sub = text({ Text = it.Sub or "", TextSize = 11, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.new(0, 5, 0, CH - 21), Size = UDim2.new(1, -10, 0, 15), ZIndex = 4 }, f)
            local dot = mk("Frame", { BackgroundColor3 = TONES.off, Position = UDim2.fromOffset(7, 7), Size = UDim2.fromOffset(8, 8), Visible = false, ZIndex = 5 }, f)
            corner(dot, 4)
            local check = mk("Frame", { BackgroundColor3 = T.accent, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(18, 18), Visible = false, ZIndex = 5 }, f)
            corner(check, 9)
            if ICON.check then
                mk("ImageLabel", { BackgroundTransparency = 1, Image = ICON.check, ImageColor3 = T.white, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(11, 11), ZIndex = 6 }, check)
