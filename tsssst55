	-- Unlock system: rules (rarity + what stays locked) → pictures of the locked kinds they cover →
	-- pick kinds or take all → the question shows what happens next (auto sell) → unlocked in batches and checked.
	local unlockGrid
	local unlockCounts = {} -- unit name -> how many the rules would unlock (filled with the pictures)
	local unlocking = false
	local function runUnlock(kinds)
		if unlocking then
			UI.hint(L("Already unlocking…", "กำลังปลดล็อคอยู่…"))
			return
		end
		local list = Units.unlockPreview(kinds)
		if #list == 0 then
			UI.hint(L("Nothing to unlock with these rules", "ไม่มีตัวที่ต้องปลดล็อคตามกฎนี้"))
			return
		end
		local byRarity = {}
		for _, u in ipairs(list) do byRarity[u.rarity] = (byRarity[u.rarity] or 0) + 1 end
		local parts = {}
		for i = #G.RARITY_ORDER, 1, -1 do
			local r = G.RARITY_ORDER[i]
			if byRarity[r] then table.insert(parts, r .. " " .. byRarity[r]) end
		end
		local lines = { L("Unlock ", "ปลดล็อค ") .. #list .. L(" units?", " ตัว?"), table.concat(parts, ", ") }
		if Config.get("sell.enabled") and not Config.get("sell.dryRun") then
			local below = G.rarityRank(Config.get("sell.belowRarity") or "Common")
			local n = 0
			for _, u in ipairs(list) do
				if u.rank < below and not u.trait and not u.grade then n += 1 end
			end
			if n > 0 then
				table.insert(lines, "\n⚠ " .. L("Auto sell is in REAL mode: ", "ขายอัตโนมัติเป็นโหมดขายจริง: ") .. n
					.. L(" of them are below ", " ตัวในนี้ต่ำกว่า ") .. tostring(Config.get("sell.belowRarity")) .. L(" and can be sold", " และอาจถูกขาย"))
			end
		end
		if running("lock") then
			table.insert(lines, L("Auto lock stays on but leaves these alone.", "ล็อกอัตโนมัติยังเปิดอยู่ แต่จะไม่ล็อกตัวเหล่านี้กลับ"))
		end
		UI.confirm(table.concat(lines, "\n"), function()
			unlocking = true
			UI.hint(L("Unlocking ", "กำลังปลดล็อค ") .. #list .. "…")
			local ok, done, asked = pcall(Units.unlock, list)
			unlocking = false
			if not ok then
				UI.hint(L("Unlock failed: ", "ปลดล็อคไม่สำเร็จ: ") .. tostring(done))
				return
			end
			UI.hint(L("Unlocked ", "ปลดล็อคแล้ว ") .. done .. "/" .. asked)
			if unlockGrid then unlockGrid.clear() end
