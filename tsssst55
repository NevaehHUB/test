__modules["lang"] = function(...)
-- 20 languages. Every visible text is written as L(english, thai); the other
-- 18 languages come from lang_data (keyed by the English text) and fall back
-- to English when a line has no translation.
local Config = import("config")

local Lang = {}

local LIST = {
	{ code = "TH", name = "ไทย" },
	{ code = "EN", name = "English" },
	{ code = "ES", name = "Español" },
	{ code = "PT", name = "Português" },
	{ code = "FR", name = "Français" },
	{ code = "DE", name = "Deutsch" },
	{ code = "IT", name = "Italiano" },
	{ code = "RU", name = "Русский" },
	{ code = "ID", name = "Bahasa Indonesia" },
	{ code = "VI", name = "Tiếng Việt" },
	{ code = "TL", name = "Filipino" },
	{ code = "JA", name = "日本語" },
	{ code = "KO", name = "한국어" },
	{ code = "ZH", name = "简体中文" },
	{ code = "TW", name = "繁體中文" },
	{ code = "AR", name = "العربية" },
	{ code = "TR", name = "Türkçe" },
	{ code = "PL", name = "Polski" },
	{ code = "NL", name = "Nederlands" },
	{ code = "MS", name = "Bahasa Melayu" },
}
-- column order inside lang_data rows
local COLUMNS = { "ES", "PT", "FR", "DE", "IT", "RU", "ID", "VI", "TL", "JA", "KO", "ZH", "TW", "AR", "TR", "PL", "NL", "MS" }

local dict

local function load()
	if dict then
		return dict
	end
	dict = {}
	local ok, rows = pcall(import, "lang_data")
	for _, row in ipairs(ok and rows or {}) do
		local byCode = {}
		local i = 0
		for part in (row[2] .. "|"):gmatch("(.-)|") do
			i += 1
			if COLUMNS[i] and part ~= "" then
				byCode[COLUMNS[i]] = part
			end
		end
		dict[row[1]] = byCode
	end
	return dict
end

function Lang.list()
	return LIST
end

function Lang.current()
	local code = Config.get("ui.lang")
	for _, l in ipairs(LIST) do
		if l.code == code then
			return code
		end
	end
	return "TH"
end

function Lang.L(en, th)
	local cur = Lang.current()
	if cur == "TH" then
		return th or en
	elseif cur == "EN" then
		return en
	end
	local row = load()[en]
	return row and row[cur] or en
end

-- How many texts have a translation in `code` (for the self-test).
function Lang.coverage(code)
	local n = 0
	for _, row in pairs(load()) do
		if row[code] then
			n += 1
		end
	end
	return n
end

return Lang
end
