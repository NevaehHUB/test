-- Teleport to the map zones (Workspace.Zones) and to the player's own plot.
local Players = game:GetService("Players")
local G = import("game")

local Teleport = {}

-- Friendly order for the buttons; any other zone is appended after these.
local ORDER = { "HubArea", "Traits", "Grades", "Fusing", "Towers", "Quests", "Selling", "Trade", "ShopArea", "Shop", "DiceShop" }
local LABELS = {
	HubArea = "Hub", ShopArea = "Shop area", Shop = "Shop (robux)", DiceShop = "Dice Shop",
	Fusing = "Fuse", Traits = "Traits", Grades = "Grades", Towers = "Towers",
	Quests = "Quests", Selling = "Sell", Trade = "Trade",
}

function Teleport.zones()
	local folder = workspace:FindFirstChild("Zones")
	local list, seen = {}, {}
	if not folder then
		return list
	end
	for _, name in ipairs(ORDER) do
		local z = folder:FindFirstChild(name)
		if z and z:IsA("BasePart") then
			seen[name] = true
			table.insert(list, { name = name, label = LABELS[name] or name, part = z })
		end
	end
	for _, z in ipairs(folder:GetChildren()) do
		if z:IsA("BasePart") and not seen[z.Name] then
			table.insert(list, { name = z.Name, label = LABELS[z.Name] or z.Name, part = z })
		end
	end
	return list
end

local function root()
	local char = Players.LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

function Teleport.to(cf)
	local hrp = root()
	if not hrp then
		return false, "no character"
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = cf
	return true
end

function Teleport.zone(name)
	local z = workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild(name)
	if not z then
		return false, "zone missing"
	end
	-- stand at the bottom-centre of the zone volume, facing the same way
	return Teleport.to(z.CFrame * CFrame.new(0, -z.Size.Y / 2 + 3, 0))
end

function Teleport.home()
	local id = G.plotId()
	local claimed = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild("Claimed")
	local plot = id and claimed and claimed:FindFirstChild(id)
	if not plot then
		return false, "plot not found"
	end
	local spawn = plot:FindFirstChild("Spawn", true)
	if spawn and spawn:IsA("BasePart") then
		return Teleport.to(spawn.CFrame + Vector3.new(0, 3, 0))
	end
	return Teleport.to(plot:GetPivot() + Vector3.new(0, 5, 0))
end

return Teleport
end
__modules["tower"] = function(...)
-- Tower automation.
--
-- The server (TowerClass.completeFloor) resolves combat deterministically:
--   * the current team member hits first; enemy HP carries over between members
--   * a member's HP carries over between floors (no healing)
--   * when a member dies the next one continues the same floor
--   * only the drops are random (each entry rolls chance% per cleared floor)
-- So a run can be simulated exactly, which lets us pick the tower, the four
-- units and their order that give the best result for the chosen goal.
local G = import("game")
local Util = import("util")
local Log = import("log")
local Config = import("config")
local Gear = import("gear")

local Tower = {}

local SIM_FLOOR_CAP = 3000 -- Infinity Tower has no max floor
local START_OVERHEAD = 3.5 -- PlayTower debounce (3s) + latency

Tower.stats = {
	runs = 0,
	floors = 0,
	bestFloor = 0,
	losses = 0,
	lossStreak = 0,
	rewards = {},
	mismatches = 0,
	lastRun = nil,
	lastOtherTower = nil,
	started = os.clock(),
}

local cachedPlan
local cachedKey

---------------------------------------------------------------- simulation

local function waitTimes()
	local refs = G.mod("TowerRefs")
	return refs.ActionWaitTime, refs.FloorStartedWaitTime
end

-- Simulate one run. team = { {damage=, health=}, ... } already multiplied by buffs.
-- Returns cleared (number of floors cleared), seconds (server pacing time).
function Tower.simulate(cfg, team)
	if #team == 0 then
		return 0, 0
	end
	local act, fs = waitTimes()
	local hp = {}
	for i, m in ipairs(team) do
		hp[i] = m.health
	end
	local member, floor, cleared, seconds = 1, 1, 0, 0
	local maxFloors = cfg.maxFloors or SIM_FLOOR_CAP
	while floor <= maxFloors do
		local enemyHp = cfg.enemyHealth(floor)
		local enemyDmg = cfg.enemyDamage(floor)
		local firstInCall = true
		local prevDefeated = false
		local finished = false
		while true do
			local m = team[member]
			if not m then
				return cleared, seconds
			end
			-- floorStarted
			if firstInCall then
				seconds += (floor == 1) and fs.initial or fs.transition
				firstInCall = false
			else
				seconds += prevDefeated and fs.transition or fs.repeated
			end
			prevDefeated = false
			enemyHp -= m.damage
			seconds += act.damageEnemy
			if enemyHp <= 0 then
				seconds += act.floorCompleted
				cleared = floor
				floor += 1
				break
			end
			hp[member] -= enemyDmg
			seconds += act.damagePlayer
			if hp[member] <= 0 then
				seconds += act.memberDefeated
				member += 1
				prevDefeated = true
				if member > #team then
					finished = true
					break
				end
			end
		end
		if finished then
			break
		end
	end
	return cleared, seconds
end

---------------------------------------------------------------- rewards

local RARITY_VALUE = {
	Common = 5, Uncommon = 8, Rare = 20, Epic = 40, Legendary = 80, Mythical = 150,
	Divine = 300, Exotic = 500, Celestial = 800, ["Secret I"] = 1500, ["Secret II"] = 2500, Heavenly = 4000,
}
local TIER_VALUE = { I = 1, II = 3, III = 8, IV = 25, V = 60 }

function Tower.itemValue(name)
	if name == "Gems" then
		return 1
	elseif name == "Trait Reroll" then
		return 4
	end
	local tier = name:match(" ([IV]+)$")
	local cfg = G.entryConfig(name)
	if cfg and cfg.kind == "Gear" then
		return RARITY_VALUE[cfg.rarity] or 60
	end
	if tier and TIER_VALUE[tier] then
		return TIER_VALUE[tier]
	end
	return 10
end

-- Expected drops for clearing floors 1..cleared.
-- Returns { [item] = {expected=, pAny=} }
function Tower.expectedDrops(cfg, cleared)
	local out = {}
	for f = 1, cleared do
		for _, tier in pairs(cfg.drops or {}) do
			if tier.minFloor <= f then
				for _, e in pairs(tier.entries) do
					local p = math.clamp(e.chance / 100, 0, 1)
					local o = out[e.name]
					if not o then
						o = { expected = 0, pNone = 1 }
						out[e.name] = o
					end
					o.expected += p * e.amount
					o.pNone *= (1 - p)
				end
			end
		end
	end
	for _, o in pairs(out) do
		o.pAny = 1 - o.pNone
		o.pNone = nil
	end
	return out
end

local function score(goal, cfg, cleared, seconds, targetItem)
	local runTime = seconds + START_OVERHEAD + (Config.get("tower.retryDelay") or 0)
	if goal == "Max floor" then
		-- floors first, then faster runs
		return cleared * 1e6 - seconds, runTime
	end
	local drops = Tower.expectedDrops(cfg, cleared)
	if goal == "Target item" and targetItem ~= "" then
		local d = drops[targetItem]
		return d and (d.pAny * 3600 / runTime) or 0, runTime
	end
	local value = 0
	for name, d in pairs(drops) do
		value += d.expected * Tower.itemValue(name)
	end
	return value * 3600 / runTime, runTime
end

---------------------------------------------------------------- team search

local function combos(n, k, fn)
	local idx = {}
	local function rec(start, depth)
		if depth > k then
			fn(idx)
			return
		end
		for i = start, n do
			idx[depth] = i
			rec(i + 1, depth + 1)
		end
	end
	rec(1, 1)
end

local function permutations(list, fn)
	local n = #list
	local a = table.clone(list)
	local function rec(i)
		if i > n then
			fn(a)
			return
		end
		for j = i, n do
			a[i], a[j] = a[j], a[i]
			rec(i + 1)
			a[i], a[j] = a[j], a[i]
		end
	end
	rec(1)
end

-- Units usable in the tower with buffed stats.
function Tower.candidates()
	local dm = G.buff("Damage Multiplier")
	local hm = G.buff("Health Multiplier")
	local list = {}
	for _, u in ipairs(G.units()) do
		table.insert(list, { id = u.id, name = u.name, rarity = u.rarity, damage = u.damage * dm, health = u.health * hm })
	end
	return list
end

local function pool(units)
	local picked, out = {}, {}
	local function take(sorted, n)
		for i = 1, math.min(n, #sorted) do
			local u = sorted[i]
			if not picked[u.id] then
				picked[u.id] = true
				table.insert(out, u)
			end
		end
	end
	local byScore = table.clone(units)
	table.sort(byScore, function(a, b)
		return a.damage * a.health > b.damage * b.health
	end)
	local byDmg = table.clone(units)
	table.sort(byDmg, function(a, b)
		return a.damage > b.damage
	end)
	local byHp = table.clone(units)
	table.sort(byHp, function(a, b)
		return a.health > b.health
	end)
	take(byScore, 8)
	take(byDmg, 3)
	take(byHp, 3)
	return out
end

-- Best team for one tower. canReorder=false keeps the given order.
local function bestTeamFor(cfg, units, goal, targetItem, canReorder, yield)
	local p = pool(units)
	local k = math.min(4, #p)
	local best
	local counter = 0
	local function consider(team)
		local cleared, seconds = Tower.simulate(cfg, team)
		local s, runTime = score(goal, cfg, cleared, seconds, targetItem)
		counter += 1
		if counter % 150 == 0 and yield then
			task.wait()
		end
		if not best or s > best.score then
			best = { score = s, cleared = cleared, seconds = seconds, runTime = runTime, team = table.clone(team) }
		end
	end
	if k == 0 then
		return nil
	end
	-- phase 1: every combination with a default order (damage first)
	local shortlist = {}
	combos(#p, k, function(idx)
		local team = {}
		for _, i in ipairs(idx) do
			table.insert(team, p[i])
		end
		table.sort(team, function(a, b)
			return a.damage > b.damage
		end)
		local cleared, seconds = Tower.simulate(cfg, team)
		local s = score(goal, cfg, cleared, seconds, targetItem)
		table.insert(shortlist, { s = s, team = team })
		counter += 1
		if counter % 150 == 0 and yield then
			task.wait()
		end
	end)
	table.sort(shortlist, function(a, b)
		return a.s > b.s
	end)
	-- phase 2: all orders for the best few combinations
	for i = 1, math.min(canReorder and 12 or 1, #shortlist) do
		if canReorder then
			permutations(shortlist[i].team, consider)
		else
			consider(shortlist[i].team)
		end
	end
	return best
end

local function planKey(units, goal, targetItem, mode, infinityFrequency)
	local parts = { goal, targetItem, mode, infinityFrequency }
	for _, u in ipairs(units) do
		table.insert(parts, u.id .. ":" .. math.floor(u.damage) .. ":" .. math.floor(u.health))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Returns the plan { tower, team (list of units), cleared, seconds, runTime, score, table = per-tower rows }
function Tower.plan(force)
	local units = Tower.candidates()
	local goal = Config.get("tower.goal")
	local targetItem = Config.get("tower.targetItem") or ""
	local mode = Config.get("tower.mode")
	local infinityFrequency = Config.get("tower.infinityFrequency")
	local key = planKey(units, goal, targetItem, mode, infinityFrequency)
	if not force and cachedPlan and cachedKey == key then
		return cachedPlan
	end
	if #units == 0 then
		return nil, "no units"
	end
	-- Reordering needs a spare unit outside the team (see applyTeam).
	local canReorder = Config.get("tower.optimizeTeam") and #units >= 5
	local towers = G.mod("Towers").GetAll()
	-- "Always win" requires a full clear for finite towers. Infinity has no
	-- final floor, so a predicted clear of at least one floor makes it farmable.
	local alwaysWin = goal == "Always win"
	local searchGoal = alwaysWin and "Max floor" or goal
	local rows = {}
	local best
	local function selectable(row)
		if row.cleared <= 0 then return false end
		if alwaysWin and not (row.winsAll or row.tower == "Infinity Tower") then return false end
		if goal == "Target item" and targetItem ~= "" and row.score <= 0 then return false end
		return true
	end
	for name, cfg in pairs(towers) do
		if mode == "Auto (best)" or mode == "Rotate (one run each)" or mode == name then
			local r = bestTeamFor(cfg, units, searchGoal, targetItem, canReorder, true)
			if r then
				r.tower = name
				r.order = cfg.order or 99
				r.maxFloors = cfg.maxFloors
				r.winsAll = cfg.maxFloors ~= nil and r.cleared >= cfg.maxFloors
				-- floors the first unit kills in a single hit
				local first = r.team[1]
				local oneShot, cap = 0, cfg.maxFloors or SIM_FLOOR_CAP
				while first and oneShot < cap and first.damage >= cfg.enemyHealth(oneShot + 1) do
					oneShot += 1
				end
				r.oneShot = oneShot
				if alwaysWin then
					r.score = (r.winsAll or name == "Infinity Tower")
						and score("Best loot/hour", cfg, r.cleared, r.seconds, targetItem) or -1
				end
				table.insert(rows, r)
				if selectable(r) and (not best or r.score > best.score) then
					best = r
				end
			end
		end
	end
	table.sort(rows, function(a, b)
		return a.order < b.order
	end)
	if mode == "Rotate (one run each)" then
		-- Walk through eligible towers in game order, advancing only after a run
		-- actually starts and finishes. A refused start retries the same tower.
		local eligible, others, infinity = {}, {}, nil
		for _, row in ipairs(rows) do
			if selectable(row) then
				table.insert(eligible, row)
				if row.tower == "Infinity Tower" then
					infinity = row
				else
					table.insert(others, row)
				end
			end
		end
		best = nil
		local previous = Tower.stats.lastRun and Tower.stats.lastRun.tower
		if infinityFrequency == "Every other run" and infinity and #others > 0 then
			if previous == nil or previous ~= "Infinity Tower" then
				best = infinity
			else
				for i, row in ipairs(others) do
					if row.tower == Tower.stats.lastOtherTower then
						best = others[(i % #others) + 1]
						break
					end
				end
				best = best or others[1]
			end
		else
			for i, row in ipairs(eligible) do
				if row.tower == previous then
					best = eligible[(i % #eligible) + 1]
					break
				end
			end
			best = best or eligible[1]
		end
	end
	if not best then
		return nil, alwaysWin and "no tower can be fully cleared yet" or "no tower matched"
	end
	best.rows = rows
	best.canReorder = canReorder
	cachedPlan, cachedKey = best, key
	return best
end

-- Units the current plan wants in the tower team; selling must not touch them.
function Tower.reservedIds()
	local set = {}
	if cachedPlan then
		for _, u in ipairs(cachedPlan.team) do
			set[u.id] = true
		end
	end
	return set
end

-- Last computed plan without recomputing (for the UI).
function Tower.cached()
	return cachedPlan
end

function Tower.invalidate()
	cachedPlan, cachedKey = nil, nil
end

---------------------------------------------------------------- team apply

local function teamEquals(desired)
	local cur = G.towerTeamIds()
	for i, u in ipairs(desired) do
		if cur[i] ~= u.id then
			return false
		end
	end
	return true
end

-- Put `desired` units into slots 1..n in order. UpdateTowerTeam(slot, id)
-- ignores ids already in the team and appends while the team has < 4, so a
-- spare unit is swapped in to free a unit before moving it.
function Tower.applyTeam(desired, ctx)
	if teamEquals(desired) then
		return true
	end
	local units = G.units()
	local cur = G.towerTeamIds()
	local count = Util.count(cur)
	if count < math.min(4, #units) then
		G.remote.equipBestTowerTeam()
		Util.waitFor(function()
			return Util.count(G.towerTeamIds()) >= math.min(4, #units)
		end, 4)
		task.wait(1.1) -- EquipBestTowerTeam debounce
	end
	if teamEquals(desired) then
		return true
	end
	if #units < 5 then
		-- cannot reorder without a spare; the team the game picked is used
		return false, "need 5+ units to reorder"
	end
	local wanted = {}
	for _, u in ipairs(desired) do
		wanted[u.id] = true
	end
	for i, u in ipairs(desired) do
		if ctx and not ctx.alive() then
			return false, "stopped"
		end
		cur = G.towerTeamIds()
		if cur[i] ~= u.id then
			for j = 1, 4 do
				if cur[j] == u.id then
					local spare
					local inTeam = {}
					for _, id in pairs(cur) do
						inTeam[id] = true
					end
					for _, other in ipairs(units) do
						if not inTeam[other.id] and not wanted[other.id] then
							spare = other.id
							break
						end
					end
					if not spare then
						return false, "no spare unit"
					end
					G.remote.updateTowerTeam(j, spare)
					Util.waitFor(function()
						return G.towerTeamIds()[j] == spare
					end, 3)
					break
				end
			end
			G.remote.updateTowerTeam(i, u.id)
			if not Util.waitFor(function()
				return G.towerTeamIds()[i] == u.id
			end, 3) then
				return false, "slot " .. i .. " did not update"
			end
		end
	end
	return teamEquals(desired)
end

---------------------------------------------------------------- run

local function sequenceWait(seq)
	local act, fs = waitTimes()
	local t = 0
	for i, a in ipairs(seq) do
		if a.action ~= "floorStarted" then
			t += act[a.action] or 0
		elseif i == 1 then
			t += (a.floor == 1) and fs.initial or fs.transition
		else
			local prev = seq[i - 1]
			t += (prev and prev.action == "memberDefeated") and fs.transition or fs.repeated
		end
	end
	return t
end

-- Plays one full tower run. Returns status, message.
local function runOnce(ctx)
	local plan, err = Tower.plan(false)
	if plan then
		-- a planned unit may have been sold or fused since the plan was made
		local inv = G.inventory()
		for _, u in ipairs(plan.team) do
			if not inv[u.id] then
				plan, err = Tower.plan(true)
				break
			end
		end
	end
	if not plan then
		return "Blocked", err
	end
	local maxRuns = Config.get("tower.maxRuns") or 0
	if maxRuns > 0 and Tower.stats.runs >= maxRuns then
		return "Blocked", "reached max runs"
	end
	local stopAfter = Config.get("tower.stopAfterLosses") or 0
	if stopAfter > 0 and Tower.stats.lossStreak >= stopAfter then
		return "Blocked", "lost " .. Tower.stats.lossStreak .. " runs in a row"
	end

	ctx.status("setting team")
	local teamOk, teamMsg = Tower.applyTeam(plan.team, ctx)
	if not teamOk and teamMsg then
		Log.warn("Tower", "team: " .. teamMsg)
	end
	-- Predict with the team that is actually set.
	local cfg = G.mod("Towers").Get(plan.tower)
	local actualTeam = {}
	local byId = {}
	for _, u in ipairs(Tower.candidates()) do
		byId[u.id] = u
	end
	for i = 1, 4 do
		local id = G.towerTeamIds()[i]
		if id and byId[id] then
			table.insert(actualTeam, byId[id])
		end
	end
	if #actualTeam == 0 then
		return "Blocked", "tower team is empty"
	end
	local predicted = Tower.simulate(cfg, actualTeam)

	if not ctx.alive() then
		return "Off"
	end
	G.remote.setAutoTower(false)
	ctx.status("starting " .. plan.tower)
	local ok, started = G.remote.playTower(plan.tower)
	if not ok or not started then
		-- a previous run may still be open on the server
		G.remote.cancelTower()
		return "Waiting", "PlayTower refused; retrying"
	end

	local cleared, fails, ended = 0, 0, false
	local runRewards = {}
	local t0 = os.clock()
	while not ended do
		if not ctx.alive() then
			G.remote.cancelTower()
		end
		local okCall, seq = G.remote.completeFloor()
		if not okCall or type(seq) ~= "table" or #seq == 0 then
			fails += 1
			if fails > 8 then
				G.remote.cancelTower()
				Log.warn("Tower", "no response from CompleteTowerFloor; cancelled")
				break
			end
			task.wait(0.4)
		else
			fails = 0
			for _, a in ipairs(seq) do
				if a.action == "floorCompleted" then
					cleared = math.max(cleared, a.floor or 0)
					for item, n in pairs(a.rewards or {}) do
						runRewards[item] = (runRewards[item] or 0) + n
					end
					ctx.status(plan.tower .. " floor " .. cleared .. "/" .. predicted)
				elseif a.action == "ended" then
					ended = true
				end
			end
			if not ended then
				task.wait(sequenceWait(seq) + 0.12)
			end
		end
	end

	local s = Tower.stats
	s.runs += 1
	s.floors += cleared
	s.bestFloor = math.max(s.bestFloor, cleared)
	s.lastRun = { tower = plan.tower, cleared = cleared, predicted = predicted, seconds = os.clock() - t0 }
	if plan.tower ~= "Infinity Tower" then s.lastOtherTower = plan.tower end
	Tower.invalidate() -- choose the next eligible tower for the following run
	local target = cfg.maxFloors or predicted
	if cleared >= target then
		s.lossStreak = 0
	else
		s.losses += 1
		s.lossStreak += 1
	end
	for item, n in pairs(runRewards) do
		s.rewards[item] = (s.rewards[item] or 0) + n
	end
	if ctx.alive() and cleared ~= predicted then
		s.mismatches += 1
		Log.warn("Tower", ("simulation said %d floors, run cleared %d"):format(predicted, cleared))
	end
	local got = {}
	for item, n in pairs(runRewards) do
		table.insert(got, n .. "x " .. item)
	end
	Log.good("Tower", ("%s: cleared %d floors in %s%s"):format(
		plan.tower, cleared, Util.fmtTime(os.clock() - t0), #got > 0 and (" | " .. table.concat(got, ", ")) or ""))
	return "Ready", ("last: %s floor %d"):format(plan.tower, cleared)
end

-- Fire-and-forget: used during shutdown, must never block (e.g. while disconnected).
-- Use the best damage boost of each kind that is not running yet.
function Tower.useDamageBoosts()
	local chosen = Config.get("boosts.items") or {}
	if next(chosen) == nil then return end
	local running = {}
	for name in pairs(G.get("ActiveEntries") or {}) do
		local cfg = G.entryConfig(name)
		if cfg and cfg.kind == "Boost" and cfg.category then
			running[cfg.category] = true
		end
	end
	local items = G.itemsOfKind("Boost")
	table.sort(items, function(a, b)
		return (a.cfg.tier or 0) > (b.cfg.tier or 0)
	end)
	local keep = Config.get("boosts.keep") or 0
	for _, item in ipairs(items) do
		local cat = item.cfg.category
		if cat and chosen[item.name] and tostring(cat):match("Damage$") and not running[cat] and item.amount > keep then
			running[cat] = true
			G.remote.useBoost(item.id)
			Log.info("Boost", ("used %s before a tower (%d left)"):format(item.name, item.amount - 1))
			task.wait(0.3)
		end
	end
end

-- Fight with the hardest-hitting gear on (and optional damage boosts), then
-- put the farming gear back.
function Tower.run(ctx)
	if not ctx.alive() then return "Paused", "stopped before entering tower" end
	if Config.get("tower.useDamageBoost") then
		Tower.useDamageBoosts()
	end
	if Config.get("tower.gear") ~= false then
		return Gear.withProfile("Tower", function()
			return runOnce(ctx)
		end)
	end
	return runOnce(ctx)
end

function Tower.stop()
	task.spawn(pcall, G.remote.cancelTower)
end

return Tower
end
__modules["ui"] = function(...)
-- DUKE HUB window, drawn with DukeGUI (src/dukegui.lua).
--
-- Layout: UI.group(name) = a big category in the sidebar · UI.tab(name, title, desc) = a page in it ·
-- tab:section(title, opts) = a card (folds up on click) · tab:advanced() = the rest of the card hides behind
-- "More settings (n)". Every control is bound to a Config path, so the window always shows what the hub will
-- really do: a switch changed elsewhere (Auto page, Stop all, profile switch) moves here too.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Config = import("config")
local Scheduler = import("scheduler")
local Lang = import("lang")
local DukeGUI = import("dukegui")
local L = Lang.L

local UI = {}
UI.ACCENT = "#4F8FF7"

local W
local currentGroup
local firstTab
local updaters = {}
local watchers = {} -- config path -> { fn(value) }
local taskRows = {} -- scheduler task id -> { fn(task) }
local cleanups = {}
local alive = false

local TONE_HEX = { run = "#4CC38A", wait = "#E0A84A", done = "#7FB0FF", bad = "#F07167", off = "#8B919C" }
local STATUS_TONE = { Running = "run", Ready = "done", Waiting = "wait", Blocked = "bad", Error = "bad", Paused = "wait", Held = "wait", Off = "off" }

local function statusWord(s)
	local th = { Ready = "พร้อม", Running = "กำลังทำ", Waiting = "รอ", Blocked = "ติดขัด", Error = "ผิดพลาด", Paused = "หยุดชั่วคราว", Held = "รอเริ่ม (ค้างจากครั้งก่อน: ปิดแล้วเปิดสวิตช์ หรือกดทำต่อ)", Off = "ปิด" }
	local en = { Held = "Held (on from last time: switch it off and on, or press Continue)" }
	return L(en[s] or s, th[s])
end

-- text that goes into a RichText label as plain text
local function plain(s)
	return (tostring(s or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function UI.accentHex()
	return UI.ACCENT
end

function UI.tone(name)
	return TONE_HEX[name] or TONE_HEX.off
end

-- Each update runs in its own thread: calling into some game modules (e.g. the Network package behind
-- G.activeWeather) lowers the calling thread's capabilities, after which that thread can no longer touch
-- the window (it lives in gethui). A thread of its own keeps the builder and the other updates unaffected.
function UI.onUpdate(fn)
	table.insert(updaters, fn)
	task.spawn(pcall, fn)
end

local function watch(path, fn)
	watchers[path] = watchers[path] or {}
	table.insert(watchers[path], fn)
end

-- Run fn in a thread of its own and wait for its result (see UI.onUpdate for why).
local function isolated(fn)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(fn)
		done = true
	end)
	while not done do
		task.wait()
	end
	return ok and res or nil
end

local function same(a, b)
	return a == b or tostring(a) == tostring(b)
end

---------------------------------------------------------------- window

local function keyCode()
	return Enum.KeyCode[tostring(Config.get("ui.key") or "RightShift")] or Enum.KeyCode.RightShift
end

local BASE_W, BASE_H = 868, 640

local function fitScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(BASE_W, BASE_H)
	local fit = math.min(1, (vp.X - 16) / BASE_W, (vp.Y - 16) / BASE_H)
	return math.max(0.4, fit) * (tonumber(Config.get("ui.scale")) or 1)
end

-- opts: title, version, logoData (base64 PNG)
function UI.create(opts)
	W = DukeGUI:Window({
		Title = opts.title or "DUKE HUB",
		Subtitle = opts.subtitle or (tostring(opts.version or "") .. " · Anime Dice"),
		Size = UDim2.fromOffset(BASE_W, BASE_H),
		GuiName = "DukeHubAnimeDice",
		Keybind = keyCode(),
		Logo = opts.logoData,
	})
	UI.window = W
	currentGroup, firstTab = nil, nil
	alive = true
	W:SetScale(fitScale())
	local cam = workspace.CurrentCamera
	if cam then
		table.insert(cleanups, cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if W then W:SetScale(fitScale()) end
		end))
	end
	table.insert(cleanups, Config.onChange(function(path, value)
		for p, list in pairs(watchers) do
			if p == path or p:sub(1, #path + 1) == path .. "." then
				local v = Config.get(p)
				for _, fn in ipairs(list) do
					task.spawn(pcall, fn, v)
				end
			end
		end
		if path == "ui.key" and W then W:SetKeybind(keyCode()) end
		if path == "ui.scale" and W then W:SetScale(fitScale()) end
	end))
	table.insert(cleanups, Scheduler.onStatus(function(t)
		for _, fn in ipairs(taskRows[t.id] or {}) do
			task.spawn(pcall, fn, t)
		end
	end))
	task.spawn(function()
		while alive do
			for _, fn in ipairs(updaters) do
				task.spawn(pcall, fn)
			end
			task.wait(1)
		end
	end)
	W.onUnloaded(function()
		alive = false
	end)
	return W
end

