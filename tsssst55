                    c.toneColor = info[2] and TONES[info[2]] or nil
                    c.dot.Visible = c.toneColor ~= nil
                    if c.toneColor then c.dot.BackgroundColor3 = c.toneColor end
                end
            end
            paint()
        end
        paint()
        showTab(currentTab)
        if Flag then DukeGUI.Options[Flag] = EP end
        return EP
    end

