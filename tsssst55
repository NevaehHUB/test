local function pickLanguage()
	local names = {}
	local codeOf = {}
	for _, l in ipairs(Lang.list()) do
		table.insert(names, l.name)
		codeOf[l.name] = l.code
	end
	UI.pick("🌐 Language / ภาษา", names, function(name)
		Config.set("ui.lang", codeOf[name])
		task.defer(rebuild)
	end)
end

local function onOff(on)
	return on and L("on", "เปิด") or L("off", "ปิด")
end

-- running(id): the scheduler's own answer, the same check that decides whether the task fires
local function running(id)
	local t = Scheduler.get(id)
	local ok, on = pcall(function()
		return t and t.def.enabled() == true and not t.suspended
	end)
	return ok and on == true
end

local function itemTotal(kind)
	local n = 0
	for _, it in ipairs(G.itemsOfKind(kind)) do
		n += it.amount
	end
	return n
end

-- text that goes into a RichText block as plain text
local function plainText(s)
	return (tostring(s or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local ALL_SWITCHES = { "auto.enabled", "auto.money", "auto.progress", "auto.roll", "auto.tower", "auto.rewards", "auto.reroll",
	"codes.enabled", "collect.enabled", "equipBest.enabled", "roll.enabled", "dice.buy", "rebirth.enabled",
	"upgrades.enabled", "levelUp.enabled", "sell.enabled", "lock.enabled", "quests.enabled", "spins.enabled",
	"boosts.enabled", "tower.enabled", "traits.enabled", "grades.enabled", "gear.enabled", "hop.enabled",
	"rewards.daily", "rewards.offline", "rewards.group", "tower.useDamageBoost", "misc.antiAfk",
	"misc.lowGraphics", "misc.autoRejoin", "misc.telemetry" }

local function turnEverythingOff()
	Hub.stop()
	for _, path in ipairs(ALL_SWITCHES) do Config.set(path, false) end
	applyPassiveSettings(false)
end

local function itemInfo(kind)
	local counts = {}
	for _, item in ipairs(G.itemsOfKind(kind)) do counts[item.name] = (counts[item.name] or 0) + item.amount end
	local out = {}
	for _, entry in ipairs(G.entriesOf(kind)) do
		local n = counts[entry.name] or 0
		-- "x12": the small card font has no Thai letters, so the count stays language-free
		out[entry.name] = { "x" .. Util.fmt(n), n > 0 and "done" or "off" }
	end
	return out
end

