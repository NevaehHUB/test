-- Rolling, selling, locking and consumables (spins / boosts).
local G = import("game")
local Util = import("util")
local Log = import("log")
local Config = import("config")
local Index = import("index")
local Tower = import("tower")
local Reroll = import("reroll")

local Units = {}

Units.stats = { rolls = 0, sold = 0, soldMoney = 0, locked = 0, byRarity = {}, best = nil, recent = {}, started = os.clock() }

---------------------------------------------------------------- roll

function Units.rollInterval()
	return math.max(0.3, G.buff("Roll Duration")) + 0.15
end

local function storageFull()
	return #G.units() >= G.unitStorage()
end

function Units.roll(ctx, manual)
	if storageFull() then
		return "Waiting", ("storage full (%d)"):format(G.unitStorage())
	end
	if G.get("AutoRoll") then
		if manual then
			return "Waiting", "the game's Auto Roll is on"
		end
		-- the game's own loop would race ours; take over from it
		G.remote.setAutoRoll(false)
		task.wait(G.buff("Roll Duration") + 0.3)
	end
	local before = G.get("Rolls") or 0
	local ok, results = G.remote.roll()
	if not ok or type(results) ~= "table" or #results == 0 then
		return "Waiting", "roll refused (cooldown or busy)"
	end
	local names = {}
	local stopRank = G.rarityRank(Config.get("roll.stopRarity") or "Off")
	local hit
	for _, r in ipairs(results) do
		local name = r.result
		local cfg = name and G.entryConfig(name)
		-- rarity including the mutation, same as the game shows it
		local rarity = "?"
		if cfg then
			local okR, rr = pcall(cfg.getRarity, { mutation = r.mutation })
			rarity = (okR and rr) or cfg.rarity or "?"
		end
		local label = (r.mutation and (r.mutation .. " ") or "") .. tostring(name) .. " (" .. rarity .. ")"
		Units.stats.rolls += 1
		Units.stats.byRarity[rarity] = (Units.stats.byRarity[rarity] or 0) + 1
		table.insert(names, label)
		local rank = G.rarityRank(rarity)
		if not Units.stats.best or rank > Units.stats.best.rank then
			Units.stats.best = { name = label, rarity = rarity, rank = rank }
		end
		if name and Index.isTarget(name) then
			Log.good("Index", "wanted unit obtained: " .. label)
		end
		if rank >= G.rarityRank("Legendary") then
			table.insert(Units.stats.recent, 1, label)
			Units.stats.recent[9] = nil
			Log.good("Roll", "got " .. label)
		end
		if (stopRank > 0 and rank >= stopRank)
			or (Config.get("roll.stopOnSecret") and (rarity:find("Secret") or rarity == "Exclusive" or rarity == "Heavenly")) then
			hit = label
		end
	end
	if hit then
		Config.set("roll.enabled", false)
		Log.good("Roll", "stop rule hit: " .. hit)
		return "Ready", "stopped: got " .. hit
	end
	return "Ready", table.concat(names, ", ")
end

---------------------------------------------------------------- sell

-- Returns list of unit infos that the sell rules allow, sorted by name.
-- belowRank overrides the configured "sell rarity below" (used by overflow).
function Units.sellPreview(belowRank, keepMutOverride)
	local below = belowRank or G.rarityRank(Config.get("sell.belowRarity") or "Common")
	local keepMut = keepMutOverride or Config.get("sell.keepMutationMin") or "Off"
	local keepPerName = Config.get("sell.keepPerName") or 0
	local placed = G.placedIds()
	local team = {}
	if Config.get("sell.keepTowerTeam") then
		for _, id in pairs(G.towerTeamIds()) do
			team[id] = true
		end
		for id in pairs(Tower.reservedIds()) do
			team[id] = true
		end
	end
	-- units about to get a better grade / trait
	for id in pairs(Reroll.protectedIds()) do
		team[id] = true
	end
	local byName = {}
	for _, u in ipairs(G.units()) do
		local protected = u.locked or placed[u.id] or team[u.id]
			or G.mutationAtLeast(u, keepMut)
			or u.trait or u.grade -- rerolled units are never auto-sold
			or Index.isTarget(u.name)
			or u.rank == 0 or u.rank >= below
		if not protected then
			byName[u.name] = byName[u.name] or {}
			table.insert(byName[u.name], u)
		end
	end
	local out = {}
	for _, list in pairs(byName) do
		table.sort(list, function(a, b)
			return a.income > b.income
		end)
		for i = keepPerName + 1, #list do
			table.insert(out, list[i])
		end
	end
	table.sort(out, function(a, b)
		return a.name < b.name
	end)
	return out
end

-- Optional (sell.overflow): when storage is almost full and the normal rules
-- find nothing, sell the lowest-income unprotected units below the lock rarity
-- until the inventory is back to 85%.
local OVERFLOW_AT, OVERFLOW_TO = 0.95, 0.85

function Units.overflowList()
	local count, storage = #G.units(), G.unitStorage()
	if count < storage * OVERFLOW_AT then
		return {}
	end
	local lockRank = G.rarityRank(Config.get("lock.minRarity") or "Mythical")
	local lockMut = Config.get("lock.mutationMin")
	local list = Units.sellPreview(lockRank > 0 and lockRank or G.rarityRank("Mythical"), lockMut or "Off")
	table.sort(list, function(a, b)
		return a.income < b.income
	end)
	local need = count - math.floor(storage * OVERFLOW_TO)
	local out = {}
	for i = 1, math.min(need, #list) do
		out[i] = list[i]
	end
	return out
end

-- Runs only from its own switch (or the Run button). Test mode always means
-- nothing is sold, also for the Run button; the storage-full extra sale needs
-- its own switch.
function Units.sell(ctx, manual)
	local list = Units.sellPreview()
	local overflow = false
	if #list == 0 and Config.get("sell.overflow") then
		list = Units.overflowList()
		overflow = #list > 0
	end
	if #list == 0 then
		return "Ready", "nothing matches the sell rules"
	end
	local value = 0
	for _, u in ipairs(list) do
		value += u.income * 40 * u.amount -- SellUtil.GetSellPrice
	end
	if Config.get("sell.dryRun") then
		return "Ready", ("test mode: would sell %d units ~$%s (nothing sold)"):format(#list, Util.fmt(value))
	end
	if overflow then
		Log.info("Sell", ("storage almost full: selling %d lowest-income units"):format(#list))
	end
	local ids = {}
	for i = 1, math.min(#list, 200) do
		ids[i] = list[i].id
	end
	local ok, money, count = G.remote.sellInventory(ids)
	if not ok then
		return "Waiting", "sell failed: " .. tostring(money)
	end
	Units.stats.sold += count or 0
	Units.stats.soldMoney += money or 0
	local names = {}
	for i = 1, #ids do
		names[list[i].name] = (names[list[i].name] or 0) + 1
	end
	local parts = {}
	for name, n in pairs(names) do
		table.insert(parts, n .. "x " .. name)
	end
	table.sort(parts)
	Log.info("Sell", ("sold %d units for $%s%s: %s"):format(count or 0, Util.fmt(money or 0),
		manual and " (Run button)" or "", table.concat(parts, ", ")))
	return "Ready", ("sold %d for $%s"):format(count or 0, Util.fmt(money or 0))
end

---------------------------------------------------------------- lock

function Units.autoLock()
	local minRank = G.rarityRank(Config.get("lock.minRarity") or "Mythical")
	local lockMut = Config.get("lock.mutationMin") or "Off"
	local manual = Config.get("unlock.manual") or {} -- unlocked by hand: left alone
	local map, n = {}, 0
	for _, u in ipairs(G.units()) do
		if not u.locked and not manual[u.id] and ((minRank > 0 and u.rank >= minRank) or G.mutationAtLeast(u, lockMut) or Index.isTarget(u.name)) then
			map[u.id] = true
			n += 1
		end
	end
	if n == 0 then
		return "Ready", "nothing new to lock"
	end
	G.remote.setLocked(map)
	Units.stats.locked += n
	Log.info("Lock", "locked " .. n .. " units")
	return "Ready", "locked " .. n
end

-- Wanted units are locked in-game as soon as they arrive, whatever the lock toggle says.
function Units.lockTargets()
	local manual = Config.get("unlock.manual") or {}
	local map, n = {}, 0
	for _, u in ipairs(G.units()) do
		if not u.locked and not manual[u.id] and Index.isTarget(u.name) then
			map[u.id] = true
			n += 1
		end
	end
	if n == 0 then
		return "Ready", "wanted units are locked"
	end
	G.remote.setLocked(map)
	Log.good("Index", "locked " .. n .. " wanted unit(s)")
	return "Ready", "locked " .. n
end

-- Locked units the unlock rules allow (config "unlock"), sorted rarest first. names = { [unit name] = true }
-- limits it to those kinds. Kept locked on request: wanted units, units on the plot / in the tower team /
-- about to be rerolled, units with a trait or grade, mutations at or above keepMutationMin.
function Units.unlockPreview(names)
	local c = Config.get("unlock") or {}
	local maxRank = c.maxRarity == "All" and math.huge or G.rarityRank(c.maxRarity or "All")
	if maxRank == 0 then maxRank = math.huge end
	local team = {}
	if c.keepTeam then
		for id in pairs(G.placedIds()) do team[id] = true end
		for _, id in pairs(G.towerTeamIds()) do team[id] = true end
		for id in pairs(Reroll.protectedIds()) do team[id] = true end
	end
	local out = {}
	for _, u in ipairs(G.units()) do
		if u.locked and u.rank <= maxRank
			and (names == nil or names[u.name])
			and not (c.keepWanted and Index.isTarget(u.name))
			and not team[u.id]
			and not (c.keepRerolled and (u.trait or u.grade))
			and not G.mutationAtLeast(u, c.keepMutationMin or "Off") then
			table.insert(out, u)
		end
	end
	table.sort(out, function(a, b)
		if a.rank ~= b.rank then return a.rank > b.rank end
		return a.name < b.name
	end)
	return out
end

-- Unlocks the given units in batches and checks the result. Returns unlocked, asked.
function Units.unlock(list)
	local ids = {}
	for _, u in ipairs(list) do table.insert(ids, u.id) end
	for i = 1, #ids, 100 do
		local map = {}
		for j = i, math.min(i + 99, #ids) do map[ids[j]] = false end
		G.remote.setLocked(map)
		task.wait(0.4)
	end
	local stillLocked = 0
	local inv = G.inventory()
	if Util.waitFor(function()
		inv = G.inventory()
		for _, id in ipairs(ids) do
			local e = inv[id]
			if e and e.attributes and e.attributes.locked then return false end
		end
		return true
	end, 3) then
		stillLocked = 0
	else
		for _, id in ipairs(ids) do
			local e = inv[id]
			if e and e.attributes and e.attributes.locked then stillLocked += 1 end
		end
	end
	local done = #ids - stillLocked
	-- remembered so Auto lock / wanted-lock leave these alone (pruned to units still owned)
	local manual = {}
	inv = G.inventory()
	for id in pairs(Config.get("unlock.manual") or {}) do
		if inv[id] then manual[id] = true end
	end
	for _, id in ipairs(ids) do manual[id] = true end
	Config.set("unlock.manual", manual)
	local byName = {}
	for _, u in ipairs(list) do byName[u.name] = (byName[u.name] or 0) + 1 end
	local parts = {}
	for name, n in pairs(byName) do table.insert(parts, n .. "x " .. name) end
	table.sort(parts)
	Log.info("Lock", ("unlocked %d/%d units: %s"):format(done, #ids, table.concat(parts, ", ")))
	return done, #ids
end

-- Locks every unit that is not locked yet. Returns the number locked.
function Units.lockAll()
	local map, n = {}, 0
	for _, u in ipairs(G.units()) do
		if not u.locked then
			map[u.id] = true
			n += 1
		end
	end
	if n > 0 then
		G.remote.setLocked(map)
		Log.info("Lock", "locked all: " .. n .. " units")
	end
	Config.set("unlock.manual", {})
	return n
end

-- Unlock units whose only reason to be locked is a mutation below `minName`
-- and a rarity below the lock rarity. Wanted units stay locked.
function Units.unlockLowMutations(minName)
	local minRank = G.rarityRank(Config.get("lock.minRarity") or "Mythical")
	local map, n = {}, 0
	for _, u in ipairs(G.units()) do
		if u.locked and u.mutation and not G.mutationAtLeast(u, minName)
			and (minRank == 0 or u.rank < minRank) and not Index.isTarget(u.name) then
			map[u.id] = false
			n += 1
		end
	end
	if n > 0 then
		G.remote.setLocked(map)
		Log.info("Lock", "unlocked " .. n .. " units with a mutation below " .. minName)
	end
	return n
end

---------------------------------------------------------------- consumables

local function active(name)
	local a = G.get("ActiveEntries") or {}
	return a[name]
end

function Units.useSpins()
	local keep = Config.get("spins.keep") or 0
	local chosen = Config.get("spins.items") or {}
	if next(chosen) == nil then return "Ready", "no spin selected" end
	for _, item in ipairs(G.itemsOfKind("Spin")) do
		if chosen[item.name] and item.amount > keep and not active(item.name) then
			G.remote.useSpin(item.id)
			Log.info("Spin", ("used %s (%d left)"):format(item.name, item.amount - 1))
			return "Ready", "used " .. item.name
		end
	end
	return "Ready", "no spin to use"
end

-- Game categories are e.g. "Pirate Luck" / "Dragon Income"; the player picks
-- the effect (last word). Per game category only the highest tier counts
-- down (BoostService), so one running boost per game category is enough.
local function boostEffect(cfg)
	return tostring(cfg.category or ""):match("(%a+)$") or ""
end

-- Runs only from its own switch and only uses the ticked kinds; nothing ticked = nothing used.
function Units.useBoosts()
	local keep = Config.get("boosts.keep") or 0
	local chosen = Config.get("boosts.items") or {}
	if next(chosen) == nil then return "Ready", "no boost selected" end
	local waitEvent = Config.get("boosts.waitEvent") ~= false
	local weather = waitEvent and G.activeWeather() or nil
	local items = G.itemsOfKind("Boost")
	table.sort(items, function(a, b)
		return (a.cfg.tier or 0) > (b.cfg.tier or 0)
	end)
	local running = {}
	for name in pairs(G.get("ActiveEntries") or {}) do
		local cfg = G.entryConfig(name)
		if cfg and cfg.kind == "Boost" and cfg.category then
			running[cfg.category] = true
		end
	end
	local used = {}
	for _, item in ipairs(items) do
		local cat = item.cfg.category
		local effect = boostEffect(item.cfg)
		local eventReady = not waitEvent or ((effect ~= "Luck" or weather == "Luck Event")
			and (effect ~= "Income" or weather == "Cash Event"))
		if cat and chosen[item.name] and eventReady and not running[cat] and item.amount > keep then
			running[cat] = true
			G.remote.useBoost(item.id)
			if Util.waitFor(function()
				return active(item.name)
			end, 3) then
				table.insert(used, item.name)
				Log.info("Boost", ("used %s (%d left)"):format(item.name, item.amount - 1))
			end
			task.wait(0.3)
		end
	end
	return "Ready", #used > 0 and ("used " .. table.concat(used, ", ")) or "nothing to use"
end

return Units
end
