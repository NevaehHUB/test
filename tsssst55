-- Auto gear: wear the best owned gear for what the hub is doing right now.
--
-- Buffs come from the game's own gear config, so new gear works without code
-- changes. A "multiplier" buff of x2 and a "percentage" buff of +100% are worth
-- the same (log scale); each profile weights the buffs it cares about.
-- GearService.Equip(slot, name) (0.25s debounce); name nil empties the slot.
local G = import("game")
local Log = import("log")
local Config = import("config")

local Gear = {}

Gear.PROFILES = {
	Farm = { ["Money Multiplier"] = 1, Luck = 0.8, ["Grade Luck"] = 0.05, ["Trait Luck"] = 0.05, Walkspeed = 0.001 },
	Tower = { ["Damage Multiplier"] = 1, ["Health Multiplier"] = 1, ["Money Multiplier"] = 0.02, Luck = 0.01 },
	Grade = { ["Grade Luck"] = 1, ["Money Multiplier"] = 0.01, Luck = 0.01 },
	Trait = { ["Trait Luck"] = 1, ["Money Multiplier"] = 0.01, Luck = 0.01 },
}

local function buffValue(b)
	local amount = tonumber(b.amount) or 0
	if b.bucket == "multiplier" then
		return amount > 0 and math.log(amount) or 0
	elseif b.bucket == "percentage" then
		return math.log(1 + amount)
	end
	return amount / 100 -- "base" buffs like Walkspeed: tiny tie-breaker
end

function Gear.score(name, profile)
	local cfg = name and G.entryConfig(name)
	if not cfg or cfg.kind ~= "Gear" then
		return 0
	end
	local weights = Gear.PROFILES[profile] or {}
	local total = 0
	for buff, b in pairs(cfg.buffs or {}) do
		total += (weights[buff] or 0) * buffValue(b)
	end
	return total
end

function Gear.slots()
	local ok, cfg = pcall(G.mod, "Inventory.Kinds.Gear.GearConfig")
	return ok and cfg.slots or { "Head", "Torso", "Back", "Upper", "Waist" }
end

function Gear.equipped()
	return table.clone(G.get("EquippedGear") or {})
end

-- Best owned gear per slot for a profile: { [slot] = name }. Slots with
-- nothing useful keep what is worn.
function Gear.best(profile)
	local current = Gear.equipped()
	local best = {}
	for _, slot in ipairs(Gear.slots()) do
		best[slot] = current[slot]
	end
	for _, item in ipairs(G.itemsOfKind("Gear")) do
		local slot = item.cfg.slot
		if slot and Gear.score(item.name, profile) > Gear.score(best[slot], profile) then
			best[slot] = item.name
		end
	end
	return best
end

-- Equip `target` ({slot = name}); returns what was worn before in the changed slots.
function Gear.apply(target)
	local current = Gear.equipped()
	local previous = {}
	for slot, name in pairs(target) do
		if current[slot] ~= name then
			previous[slot] = current[slot] or false
			G.remote.equipGear(slot, name or nil)
			task.wait(0.35)
		end
	end
	return previous
end

function Gear.restore(previous)
	for slot, name in pairs(previous or {}) do
		G.remote.equipGear(slot, name or nil)
		task.wait(0.35)
	end
end

-- Set while a profile is worn for something (e.g. a tower fight).
Gear.busy = nil

-- Wear the best gear for `profile` while fn runs, then put the old gear back.
-- If another profile is already being worn (a tower fight), fn just runs with
-- that gear instead of waiting for it.
function Gear.withProfile(profile, fn)
	if Gear.busy then
		return fn()
	end
	Gear.busy = profile
	local previous = Gear.apply(Gear.best(profile))
	local ok, a, b = pcall(fn)
	Gear.restore(previous)
	Gear.busy = nil
	if not ok then
		error(a, 0)
	end
	return a, b
end

-- Scheduler task: keep the Farm profile on while nothing else needs other gear.
function Gear.run()
	if Gear.busy then
		return "Waiting", "wearing " .. Gear.busy .. " gear right now"
	end
	local target = Gear.best(Config.get("gear.profile") or "Farm")
	local changed = Gear.apply(target)
	local names = {}
	for slot in pairs(changed) do
		table.insert(names, slot .. ": " .. tostring(target[slot]))
	end
	if #names > 0 then
		Log.info("Gear", "wearing " .. table.concat(names, ", "))
		return "Ready", "equipped " .. table.concat(names, ", ")
	end
	return "Ready", "already wearing the best gear"
end

return Gear
end
__modules["hop"] = function(...)
-- Server hop: list public servers of this place and teleport to another one.
-- The script is gone after a teleport, so Hop.queueSelf() asks the executor
-- to run DUKE HUB again in the new server (queue_on_teleport).
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local Log = import("log")
local Config = import("config")

local Hop = {}

Hop.visited = {} -- job ids tried this session

local function httpGet(url)
	local ok, res = pcall(function()
		if request then
			local r = request({ Url = url, Method = "GET" })
			return r and r.Body
		end
		return game:HttpGet(url)
	end)
	return ok and res or nil
end

-- Public servers with room: { {id, playing, maxPlayers, ping} }
function Hop.servers(maxPages)
	local out, cursor = {}, nil
	for _ = 1, maxPages or 3 do
		local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true%s"):format(
			game.PlaceId, cursor and ("&cursor=" .. cursor) or "")
		local body = httpGet(url)
		local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "")
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			break
		end
		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 0) then
				table.insert(out, { id = s.id, playing = s.playing or 0, maxPlayers = s.maxPlayers or 0, ping = s.ping })
			end
		end
		cursor = data.nextPageCursor
		if not cursor then
			break
		end
	end
	return out
end

-- Run DUKE HUB again after a teleport: from the local copy when there is one, else from the link it was
-- loaded with (the loader sets getgenv().DUKE_HUB_URL, so a shared link keeps working after a hop).
function Hop.queueSelf()
	local q = queue_on_teleport or (syn and syn.queue_on_teleport)
	if type(q) ~= "function" then
		return false
	end
	local env = (getgenv and getgenv()) or _G
	local src
	if type(isfile) == "function" and isfile("AnimeDiceHub/DukeHub_v0.8.4.lua") then
		src = 'loadstring(readfile("AnimeDiceHub/DukeHub_v0.8.4.lua"))()'
	elseif type(env.DUKE_HUB_URL) == "string" and env.DUKE_HUB_URL:match("^https?://") then
		-- set the link again: the new server starts with an empty getgenv, and the next hop needs it too
		src = ("getgenv().DUKE_HUB_URL = %q; loadstring(game:HttpGet(getgenv().DUKE_HUB_URL))()"):format(env.DUKE_HUB_URL)
	end
	if not src then
		return false
	end
	pcall(q, src)
	return true
end

-- mode: "smallest" (fewest players) or "random". Returns ok, message.
function Hop.hop(mode)
	local list = Hop.servers(3)
	local candidates = {}
	for _, s in ipairs(list) do
		if not Hop.visited[s.id] then
			table.insert(candidates, s)
		end
	end
	if #candidates == 0 then
		return false, "no other server found"
	end
	if mode == "random" then
		local s = candidates[math.random(1, #candidates)]
		candidates = { s }
	else
		table.sort(candidates, function(a, b)
			return a.playing < b.playing
		end)
	end
	local target = candidates[1]
	Hop.visited[target.id] = true
	local queued = Hop.queueSelf()
	Log.info("Hop", ("teleporting to a server with %d/%d players%s"):format(target.playing, target.maxPlayers,
		queued and "" or " (script will not restart by itself)"))
	local ok, err = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, target.id, Players.LocalPlayer)
	if not ok then
		return false, tostring(err)
	end
	return true, ("%d/%d players"):format(target.playing, target.maxPlayers)
end

-- Rejoin the same server (fresh copy of it).
function Hop.rejoin()
	Hop.queueSelf()
	return pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, game.JobId, Players.LocalPlayer)
end

-- Scheduler task: hop when the server is too full or after the set time.
Hop.started = os.clock()
function Hop.run()
	local maxPlayers = Config.get("hop.whenPlayersOver") or 0
	local everyMin = Config.get("hop.everyMinutes") or 0
	local count = #Players:GetPlayers()
	local reason
	if maxPlayers > 0 and count > maxPlayers then
		reason = ("%d players here"):format(count)
	elseif everyMin > 0 and os.clock() - Hop.started > everyMin * 60 then
		reason = ("%d minutes passed"):format(everyMin)
	end
	if not reason then
		return "Ready", ("%d players · no hop needed"):format(count)
	end
	local ok, msg = Hop.hop(Config.get("hop.mode") or "smallest")
	return ok and "Ready" or "Waiting", (ok and "hopping: " or "hop failed: ") .. reason .. " · " .. tostring(msg)
end

return Hop
end
__modules["index"] = function(...)
-- Index targets: which units the player wants, their odds and status.
--
-- RollUtil.RollUnit(luck): every rollable unit (and each mutation of it) gets
-- weight luck / chance, but only while chance / luck >= 1 — units that are too
-- common for the current luck drop out of the pool entirely.
local G = import("game")
local Config = import("config")

local Index = {}

local entriesCache

-- All units that can come from a roll: { name, rarity, rank, chance, variant }
function Index.entries()
	if entriesCache then
		return entriesCache
	end
	local list = {}
	for name, cfg in pairs(G.mod("EntryRegistry").entriesOfKind("Unit")) do
		if type(cfg.chance) == "function" then
			local ok, chance = pcall(cfg.chance)
			if ok and chance then
				table.insert(list, {
					name = name,
					rarity = cfg.rarity,
					rank = G.rarityRank(cfg.rarity),
					chance = chance,
					variant = cfg.variant,
				})
			end
		end
	end
	table.sort(list, function(a, b)
		return a.chance < b.chance
	end)
	entriesCache = list
	return list
end

local function mutations()
	local ok, m = pcall(G.mod, "Inventory.Kinds.Unit.Mutations")
	return ok and m or {}
end

-- Luck used for the next roll (dice luck x Luck buff; spins not included).
function Index.luck()
	local dice = G.mod("Dice").Get(G.get("Dice"))
	return ((dice and dice.luck) or 1) * G.buff("Luck")
end

-- Probability that one roll gives `name` (any mutation). 0 if it's out of the pool.
local weightCache = { luck = nil, total = 0, byName = {} }

local function weights(luck)
	if weightCache.luck == luck then
		return weightCache
	end
	local total, byName = 0, {}
	local muts = mutations()
	for _, e in ipairs(Index.entries()) do
		local w = 0
		local base = e.chance / luck
		if base >= 1 then
			w += 1 / base
		end
		for _, m in pairs(muts) do
			local c = e.chance * (m.chance or 1) / luck
			if c >= 1 then
				w += 1 / c
			end
		end
		byName[e.name] = w
		total += w
	end
	weightCache = { luck = luck, total = total, byName = byName }
	return weightCache
end

function Index.probability(name, luck)
	local w = weights(luck or Index.luck())
	if w.total <= 0 then
		return 0
	end
	return (w.byName[name] or 0) / w.total
end

function Index.discovered(name)
	return (G.get("DiscoveredUnits") or {})[name] ~= nil
end

function Index.owned(name)
	for _, e in pairs(G.inventory()) do
		if e.name == name then
			return true
		end
	end
	return false
end

function Index.targets()
	return Config.get("index.targets") or {}
end

function Index.isTarget(name)
	return Index.targets()[name] == true
end

function Index.setTarget(name, on)
	local t = table.clone(Index.targets())
	t[name] = on and true or nil
	Config.set("index.targets", t)
end

-- Status rows for the UI: { name, state = "done"|"progress"|"blocked", text }
function Index.status(rollInterval)
	local rows = {}
	local luck = Index.luck()
	for name in pairs(Index.targets()) do
		local e
		for _, x in ipairs(Index.entries()) do
			if x.name == name then
				e = x
				break
			end
		end
		local row = { name = name, rarity = e and e.rarity or "?" }
		if Index.owned(name) then
			row.state, row.text = "done", "obtained"
		else
			local p = Index.probability(name, luck)
			if p <= 0 then
				row.state = "blocked"
				row.text = (e and e.chance < luck) and "too common for your luck" or "not rollable"
			else
				row.state = "progress"
				local rolls = 1 / p
				row.text = ("1 in %s · ~%s"):format(
					rolls >= 1e3 and string.format("%.3g", rolls) or tostring(math.floor(rolls + 0.5)),
					rollInterval and Index.fmtEta(rolls * rollInterval) or "")
