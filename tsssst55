end

function Index.fmtEta(sec)
	if sec < 60 then
		return math.floor(sec) .. "s"
	elseif sec < 3600 then
		return math.floor(sec / 60) .. "m"
	elseif sec < 86400 * 2 then
		return string.format("%.1fh", sec / 3600)
	elseif sec < 86400 * 365 then
		return string.format("%.0fd", sec / 86400)
	end
	return "years"
end

