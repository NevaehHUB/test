local state = {
	version = VERSION,
	profile = "Default",
	profiles = {},
}
local current
local listeners = {}
local saveQueued = false
local canPersist = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

local function path()
	local uid = game:GetService("Players").LocalPlayer.UserId
	return FOLDER .. "/" .. tostring(uid) .. ".json"
end

function Config.persistent()
	return canPersist
end

function Config.load()
	if canPersist then
		local ok, raw = pcall(function()
			if isfile(path()) then
				return readfile(path())
			end
		end)
		local data = ok and raw and Util.decode(raw)
		if raw and not data then
			pcall(writefile, path() .. ".bak", raw)
			Log.warn("Config", "config file was corrupt; backed up and reset")
		end
		if type(data) == "table" and type(data.profiles) == "table" then
			state.profile = type(data.profile) == "string" and data.profile or "Default"
			for name, p in pairs(data.profiles) do
				local merged = Util.merge(Config.defaults, p)
				-- Older profiles kept the old default, which prevented the requested
				-- one-run rotation from taking effect after an update.
				if (tonumber(data.version) or 1) < 2 and type(p) == "table" and type(p.tower) == "table"
					and p.tower.mode == "Auto (best)" then
					merged.tower.mode = "Rotate (one run each)"
				end
				if (tonumber(data.version) or 1) < 3 then
					merged.boosts.items = {}
					merged.spins.items = {}
					merged.boosts.categories = nil
				end
				state.profiles[name] = merged
			end
		end
	end
	if not state.profiles[state.profile] then
		state.profiles[state.profile] = Util.copy(Config.defaults)
	end
	current = state.profiles[state.profile]
	return current
end

function Config.save()
	if not canPersist then
		return false
	end
	local ok = pcall(function()
		if not isfolder(FOLDER) then
			makefolder(FOLDER)
		end
		writefile(path(), Util.encode(state))
	end)
	return ok
end

local function queueSave()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1.5, function()
		saveQueued = false
		Config.save()
	end)
end

-- Dotted path access: Config.get("tower.goal")
function Config.get(p)
	local node = current
	for part in p:gmatch("[^%.]+") do
		if type(node) ~= "table" then
			return nil
		end
		node = node[part]
	end
	return node
end

function Config.set(p, value)
	local node = current
	local parts = {}
	for part in p:gmatch("[^%.]+") do
		table.insert(parts, part)
	end
	for i = 1, #parts - 1 do
		node[parts[i]] = node[parts[i]] or {}
		node = node[parts[i]]
	end
	node[parts[#parts]] = value
	for _, fn in ipairs(listeners) do
		pcall(fn, p, value)
	end
	queueSave()
end

-- True when the Auto page's master switch and the given group are both on.
function Config.auto(group)
	return Config.get("auto.enabled") == true and Config.get("auto." .. group) == true
end

-- Returns a function that removes the listener again.
function Config.onChange(fn)
	table.insert(listeners, fn)
	return function()
		local i = table.find(listeners, fn)
		if i then
			table.remove(listeners, i)
		end
	end
end

function Config.profileNames()
	return Util.keys(state.profiles)
end

function Config.currentProfile()
	return state.profile
end

function Config.switchProfile(name, cloneCurrent)
	if not state.profiles[name] then
		state.profiles[name] = cloneCurrent and Util.copy(current) or Util.copy(Config.defaults)
	end
	state.profile = name
	current = state.profiles[name]
	queueSave()
	return current
end

function Config.deleteProfile(name)
	if name == state.profile or not state.profiles[name] then
		return false
	end
	state.profiles[name] = nil
	queueSave()
	return true
end

function Config.resetProfile()
	state.profiles[state.profile] = Util.copy(Config.defaults)
	current = state.profiles[state.profile]
	queueSave()
end

return Config
end
