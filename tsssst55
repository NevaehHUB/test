-- opts: text, path, desc, task (scheduler id: its live status shows under the name), runOnce, danger, onChange
function Tab:toggle(opts)
	local card = self:_card()
	local TF
	TF = card:Toggle({
		Name = opts.text, Description = opts.desc, Danger = opts.danger, Default = Config.get(opts.path) == true,
		Callback = function(v)
			if v and opts.danger and Config.get("safety.confirmDanger") ~= false and Config.get(opts.path) ~= true then
				UI.confirm(opts.confirm or (L("Enable this action? It may spend resources or sell items: ", "เปิดงานนี้หรือไม่? อาจใช้ทรัพยากรหรือขายของ: ") .. opts.text), function()
					Config.set(opts.path, true)
					if opts.onChange then task.spawn(opts.onChange, true) end
				end, function()
					TF:UpdateState(false)
				end)
				return
			end
			if not v and opts.dangerOff and Config.get("safety.confirmDanger") ~= false and Config.get(opts.path) == true then
				UI.confirm(opts.confirmOff or (L("Turn this protection off? ", "ปิดการป้องกันนี้หรือไม่? ") .. opts.text), function()
					Config.set(opts.path, false)
					if opts.onChange then task.spawn(opts.onChange, false) end
				end, function()
					TF:UpdateState(true)
				end)
				return
			end
			if Config.get(opts.path) ~= v then
				Config.set(opts.path, v)
				if opts.onChange then task.spawn(opts.onChange, v) end
			end
		end,
	})
	TF.IgnoreConfig = true
	watch(opts.path, function(v)
		v = v == true
		if TF.State ~= v then TF:UpdateState(v) end
	end)
	self:_add(TF)
	if opts.task then
		local base = opts.desc or ""
		local desc = TF.Row and TF.Row.descLabel
		local function show(t)
			if not desc then return end
			local msg = (t.message ~= "" and t.message) or statusWord(t.status)
			desc.Text = (base ~= "" and (plain(base) .. "  ·  ") or "") .. ('<font color="%s">● %s</font>'):format(UI.tone(STATUS_TONE[t.status]), plain(msg))
			desc.Visible = true
		end
		taskRows[opts.task] = taskRows[opts.task] or {}
		table.insert(taskRows[opts.task], show)
		local t = Scheduler.get(opts.task)
		if t then show(t) end
		if opts.runOnce then
			local b = card:Button({ Name = L("▶ Run once now", "▶ ทำ 1 รอบตอนนี้") .. " · " .. opts.text, Callback = function()
				if opts.danger and Config.get("safety.confirmDanger") ~= false then
					UI.confirm(opts.confirm or (L("Run this action once? It may spend resources or sell items: ", "ทำงานนี้หนึ่งรอบหรือไม่? อาจใช้ทรัพยากรหรือขายของ: ") .. opts.text), function()
						if not Scheduler.runOnce(opts.task) then UI.hint(L("Can't run now (already running or disconnected)", "ทำตอนนี้ไม่ได้ (กำลังทำอยู่ หรือหลุดจากเกม)")) end
					end)
				elseif not Scheduler.runOnce(opts.task) then
					UI.hint(L("Can't run now (already running or disconnected)", "ทำตอนนี้ไม่ได้ (กำลังทำอยู่ หรือหลุดจากเกม)"))
				end
			end })
			b:SetNested(true)
			if self.adv then self:_add(b) end
		end
	end
	return TF
end

-- tab names: the given ones first (presentOnly: only those some item uses), then any other Rarity found in the items (sorted)
local function gridTabs(given, items, presentOnly)
	local tabs, seen, extras, used = {}, {}, {}, {}
	for _, it in ipairs(items) do
		if it.Rarity then used[it.Rarity] = true end
	end
	for _, t in ipairs(given or {}) do
		if not presentOnly or used[t] then table.insert(tabs, t) end
		seen[t] = true
	end
	for _, it in ipairs(items) do
		if it.Rarity and not seen[it.Rarity] then
			seen[it.Rarity] = true
			table.insert(extras, it.Rarity)
		end
	end
	table.sort(extras)
	for _, t in ipairs(extras) do table.insert(tabs, t) end
	return tabs
end

local function itemsKey(items)
	local names = {}
	for i, it in ipairs(items) do names[i] = it.Name end
	return table.concat(names, "\0")
end

-- Pictures right in the card, bound to a Config path: a map of names -> true, or one name (scalar).
-- Without a path the choice stays in the window (opts.onChange(map), grid:selected()).
-- opts: text, desc, path, scalar, single, items = fn -> { {Name, Image | Model, Rarity, Sub} }, rarities, hideAll, startTab,
-- rows (visible rows), info = fn -> { [name] = {text, tone} }, dynamic (items re-read every second), emptyText, onChange
-- Game data is read in a thread of its own (see UI.onUpdate).
function Tab:imagePicker(opts)
	local items = isolated(opts.items) or {}
	local localSel = {}
	local function current()
		if opts.path then return Config.get(opts.path) end
		return localSel
	end
	local function selection(v)
		local out = {}
		if opts.scalar then
			if type(v) == "string" and v ~= "" then out[1] = v end
			return out
		end
		for name, on in pairs(type(v) == "table" and v or {}) do
			if on then table.insert(out, name) end
		end
		table.sort(out)
		return out
	end
	local IG = self:_card():ImageGrid({
		Name = opts.text, Description = opts.desc, Items = items, Rarities = gridTabs(opts.rarities, items, opts.presentOnly),
		HideAll = opts.hideAll, StartTab = opts.startTab, Single = opts.single, Rows = opts.rows,
		Default = selection(current()), KeepMissing = opts.path ~= nil,
		AllText = L("All", "ทั้งหมด"), CountText = L("%d selected", "เลือก %d"), EmptyText = opts.emptyText,
		Callback = function(names)
			if opts.scalar then
				local value = names[1]
				if value and Config.get(opts.path) ~= value then
					Config.set(opts.path, value)
					if opts.onChange then task.spawn(opts.onChange, value) end
				end
				return
			end
			local nextMap = {}
			for _, name in ipairs(names) do nextMap[name] = true end
			if not opts.path then
				localSel = nextMap
				if opts.onChange then task.spawn(opts.onChange, nextMap) end
				return
			end
			local now = Config.get(opts.path) or {}
			local changed = false
			for name, on in pairs(now) do if on and not nextMap[name] then changed = true break end end
			if not changed then
				for name in pairs(nextMap) do if not now[name] then changed = true break end end
			end
			if changed then
				Config.set(opts.path, nextMap)
				if opts.onChange then task.spawn(opts.onChange, nextMap) end
			end
		end,
	})
	IG.IgnoreConfig = true
	if opts.path then
		watch(opts.path, function(v)
			local wanted = selection(v)
			if table.concat(wanted, "\0") ~= table.concat(IG:GetSelection(), "\0") then
				IG:UpdateSelection(wanted, true)
			end
		end)
	end
	if opts.dynamic then
		local key = itemsKey(items)
		UI.onUpdate(function()
			local fresh = isolated(opts.items)
			if not fresh then return end
			local k = itemsKey(fresh)
			if k ~= key then
				key = k
				IG:SetItems(fresh, gridTabs(opts.rarities, fresh, opts.presentOnly))
				if not opts.path then
					-- kinds that left the list are no longer chosen
					local keepSel = {}
					for _, name in ipairs(IG:GetSelection()) do keepSel[name] = true end
					localSel = keepSel
				end
			end
		end)
	end
	if opts.info then
		UI.onUpdate(function()
			local info = isolated(opts.info)
			if info then IG:SetInfoAll(info) end
		end)
	end
	function IG.selected()
		return localSel
	end
	function IG.clear()
		localSel = {}
		IG:UpdateSelection({}, true)
	end
	return self:_add(IG)
end

-- Page shortcuts as pictures: tapping one opens that page and never turns anything on.
-- items = fn -> { {Name, Image | Model, Sub, Target = tab} }
function Tab:imageMenu(items)
	local rows = isolated(items) or {}
	local byName = {}
	for _, row in ipairs(rows) do
		byName[row.Name] = row.Target
		row.Sub = row.Sub or row.Rarity -- the group, shown under the picture
	end
	local IG
	IG = self:_card():ImageGrid({
		Items = rows, Single = true, HideAll = true, Rows = 99,
		Callback = function(names)
			local target = byName[names[1]]
			if target and target.tab then target.tab:Select() end
			-- a shortcut, not a setting: forget the pick so the same picture works again
			task.defer(function() IG:UpdateSelection({}, true) end)
		end,
	})
	return self:_add(IG)
end
-- opts: text, path, min, max, integer, desc
function Tab:number(opts)
	local card = self:_card()
	local I
	I = card:Input({
		Name = opts.text, Description = opts.desc, Default = tostring(Config.get(opts.path) or 0), Width = 120, AcceptedCharacters = "Numeric",
		Callback = function(text)
			local n = tonumber(text)
			if not n then
				I:UpdateText(tostring(Config.get(opts.path) or 0))
				return
			end
			if opts.min then n = math.max(opts.min, n) end
			if opts.max then n = math.min(opts.max, n) end
			if opts.integer then n = math.floor(n + 0.5) end
			if tostring(n) ~= text then
				I:UpdateText(tostring(n))
				return
			end
			if Config.get(opts.path) ~= n then
				Config.set(opts.path, n)
				if opts.onChange then task.spawn(opts.onChange, n) end
			end
		end,
	})
	I.IgnoreConfig = true
	watch(opts.path, function(v)
		if I:GetInput() ~= tostring(v or 0) then I:UpdateText(tostring(v or 0)) end
	end)
	return self:_add(I)
end

-- opts: text, path, options (list or fn -> list), labels (fn value -> text), desc, onChange
function Tab:dropdown(opts)
	local card = self:_card()
	local valueOf, labelOf = {}, {}
	local function resolve()
		local list = type(opts.options) == "function" and (isolated(opts.options) or {}) or opts.options or {}
		local labels = {}
		table.clear(valueOf)
		table.clear(labelOf)
		for _, v in ipairs(list) do
			local lbl = opts.labels and opts.labels(v) or tostring(v)
			if v == "" and lbl == "" then lbl = "-" end
			while valueOf[lbl] ~= nil do lbl = lbl .. " " end
			valueOf[lbl] = v
			labelOf[tostring(v)] = lbl
			table.insert(labels, lbl)
		end
		return labels
	end
	local labels = resolve()
	local suppress = false
	local DF
	DF = card:Dropdown({
		Name = opts.text, Description = opts.desc, Options = labels, Default = labelOf[tostring(Config.get(opts.path))],
		Search = #labels > 12,
		Callback = function(lbl)
			if suppress or lbl == nil then return end
			local v = valueOf[lbl]
			if v == nil then return end
			if not same(Config.get(opts.path), v) then
				Config.set(opts.path, v)
				if opts.onChange then task.spawn(opts.onChange, v) end
			end
		end,
	})
	DF.IgnoreConfig = true
	local function select(v)
		local lbl = labelOf[tostring(v)]
		suppress = true
		if lbl then DF:UpdateSelection(lbl) end
		suppress = false
	end
	watch(opts.path, select)
	if type(opts.options) == "function" then
		local last = table.concat(labels, "\1")
		UI.onUpdate(function()
			local fresh = resolve()
			local key = table.concat(fresh, "\1")
			if key ~= last then
				last = key
				suppress = true
				DF:ClearOptions()
				DF:InsertOptions(fresh)
				suppress = false
				select(Config.get(opts.path))
			end
		end)
	end
	return self:_add(DF)
end

function Tab:button(text, callback, desc)
	local card = self:_card()
	local b = card:Button({ Name = text, Callback = function() task.spawn(callback) end })
	self:_add(b)
