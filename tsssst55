function G.get(key)
	local ok, v = pcall(function()
		return DC[key]()
	end)
	if ok then
		return v
	end
	return nil
end

function G.money()
	return G.get("Money") or 0
end

function G.rebirths()
	return G.get("Rebirth") or 0
end

function G.inventory()
	return G.get("Inventory") or {}
end

function G.slots()
	return G.get("Slots") or {}
end

function G.buff(name)
	local ok, v = pcall(function()
		return G.mod("BuffController").GetBuff(name)
	end)
	return ok and tonumber(v) or 1
end

function G.entryConfig(name)
	local ok, cfg = pcall(function()
		return G.mod("EntryRegistry").getEntryConfig(name)
	end)
	return ok and cfg or nil
end

function G.entryImage(name)
	local cfg = G.entryConfig(name)
	return cfg and type(cfg.image) == "string" and cfg.image or nil
end

function G.entriesOf(kind)
	local ok, entries = pcall(function()
		return G.mod("EntryRegistry").entriesOfKind(kind)
	end)
	local out = {}
	if ok and type(entries) == "table" then
		for name, cfg in pairs(entries) do
			table.insert(out, { name = name, cfg = cfg })
		end
		table.sort(out, function(a, b) return a.name < b.name end)
	end
	return out
end

function G.unitModel(name)
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
	local models = assets and assets:FindFirstChild("Models")
	local units = models and models:FindFirstChild("Units")
	local model = units and units:FindFirstChild(name)
	if not model then
		-- UnitConfig keeps the source model (an Instance) as baseModel, e.g. for variants
		local cfg = G.entryConfig(name)
		local base = cfg and cfg.baseModel
		model = typeof(base) == "Instance" and base or (type(base) == "string" and units and units:FindFirstChild(base)) or nil
	end
	return model and model:IsA("Model") and model or nil
end

function G.rarityRank(name)
	return rarityRank[name] or 0
end

-- Mutation rarity as log10 of its chance: Silver 1, Gold 2, Emerald 3,
-- Diamond 4, Ruby 5, Rainbow 6. nil / unknown / "Off" -> nil.
function G.mutationRank(name)
	if not name or name == "Off" then
		return nil
	end
	local ok, muts = pcall(G.mod, "Inventory.Kinds.Unit.Mutations")
	local m = ok and muts[name]
	if not m or not m.chance then
		return nil
	end
	return math.floor(math.log10(m.chance) + 0.5)
end

-- Mutation names sorted from common to rare.
function G.mutationNames()
	local ok, muts = pcall(G.mod, "Inventory.Kinds.Unit.Mutations")
	local list = {}
	for name, m in pairs(ok and muts or {}) do
		table.insert(list, { name = name, chance = m.chance or 0 })
	end
	table.sort(list, function(a, b)
		return a.chance < b.chance
	end)
	local out = {}
	for _, m in ipairs(list) do
		table.insert(out, m.name)
	end
	return out
end

-- True when unit info `u` has a mutation at least as rare as `minName`.
function G.mutationAtLeast(u, minName)
	local need = G.mutationRank(minName)
	local have = G.mutationRank(u.mutation)
	return need ~= nil and have ~= nil and have >= need
end

function G.placedIds()
	local set = {}
	for _, slot in pairs(G.slots()) do
		if type(slot) == "table" and slot.unitId then
			set[slot.unitId] = true
		end
	end
	return set
end

function G.towerTeamIds()
	local team = G.get("TowerTeam") or {}
	local out = {}
	for i = 1, 4 do
		if team[i] then
			out[i] = team[i]
		end
	end
	return out
end

-- Full description of one inventory unit; nil for non-units.
function G.unitInfo(id, entry)
	entry = entry or G.inventory()[id]
	if not entry then
		return nil
	end
	local cfg = G.entryConfig(entry.name)
	if not cfg or cfg.kind ~= "Unit" then
		return nil
	end
	local a = entry.attributes or {}
	local function call(fn)
		if type(fn) ~= "function" then
			return nil
		end
		local ok, v = pcall(fn, a)
		return ok and v or nil
	end
	local rarity = call(cfg.getRarity) or cfg.rarity or "?"
	return {
		id = id,
		name = entry.name,
		amount = entry.amount or 1,
		level = a.level or 1,
		locked = a.locked == true,
		mutation = a.mutation,
		trait = a.trait,
		grade = a.grade,
		rarity = rarity,
		rank = G.rarityRank(rarity),
		chance = call(cfg.chance),
		income = call(cfg.income) or 0,
		damage = call(cfg.damage) or 0,
		health = call(cfg.health) or 0,
	}
end

function G.units()
	local list = {}
	for id, entry in pairs(G.inventory()) do
		local info = G.unitInfo(id, entry)
		if info then
			table.insert(list, info)
		end
	end
	return list
end

function G.itemCount(name)
	local total = 0
	for _, entry in pairs(G.inventory()) do
		if entry.name == name then
			total += entry.amount or 1
		end
	end
	return total
end

-- Inventory keys of consumables by kind ("Spin", "Boost", ...).
-- The game's own Auto Sell setting (SellService.UpdateAutoSell, Settings > Auto Sell).
-- RollService sells a freshly rolled unit right away when its odds (1 in N) have
-- N below this number, before any lock can be set. 0 = off.
function G.autoSellThreshold()
	return tonumber(G.get("AutoSell")) or 0
end

local unitChances
-- { [unit name] = N } for every unit kind (no mutation), read once.
function G.unitChances()
	if not unitChances then
		unitChances = {}
		local ok, list = pcall(function()
			return G.mod("EntryRegistry").entriesOfKind("Unit")
		end)
		for key, value in pairs(ok and type(list) == "table" and list or {}) do
			local cfg = type(value) == "table" and value or G.entryConfig(value)
			local name = type(key) == "string" and key or (type(value) == "string" and value) or (cfg and cfg.name)
			if cfg and name then
				local okC, n = pcall(function()
					return type(cfg.chance) == "function" and cfg.chance({}) or cfg.chance
				end)
				n = okC and tonumber(n)
				if n then
					unitChances[name] = n
				end
			end
		end
	end
	return unitChances
end

-- How many unit kinds the game's Auto Sell throws away right now: sold, total.
function G.autoSellCount()
	local threshold = G.autoSellThreshold()
	local sold, total = 0, 0
	for _, n in pairs(G.unitChances()) do
		total += 1
		if threshold > 0 and n < threshold then
			sold += 1
		end
	end
	return sold, total
end

function G.itemsOfKind(kind)
	local out = {}
	for id, entry in pairs(G.inventory()) do
		local cfg = G.entryConfig(entry.name)
		if cfg and cfg.kind == kind then
			table.insert(out, { id = id, name = entry.name, amount = entry.amount or 1, cfg = cfg })
		end
	end
	return out
end

-- The player's plot model name (PlotService RemoteProperty "PlotId").
function G.plotId()
	local ok, id = pcall(function()
		if not handles.plotId then
			handles.plotId = comm("PlotService"):GetProperty("PlotId")
			-- a new property object gets its value shortly after creation
			local deadline = os.clock() + 2
			while handles.plotId:Get() == nil and os.clock() < deadline do
				task.wait(0.1)
			end
		end
		return handles.plotId:Get()
	end)
	if ok and id then
		return id
	end
	-- fallback: the plot whose billboard shows our name
	local claimed = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild("Claimed")
	for _, plot in ipairs(claimed and claimed:GetChildren() or {}) do
		local label = plot:FindFirstChild("Label", true)
		local name = label and label:FindFirstChild("PlayerName", true)
		if name and (name.Text == G.player.DisplayName or name.Text == G.player.Name) then
			return plot.Name
		end
	end
	return nil
end

function G.unitStorage()
	return G.buff("Unit Storage")
end

return G
end
