function UI.destroy()
	alive = false
	for _, c in ipairs(cleanups) do
		pcall(function()
			if typeof(c) == "RBXScriptConnection" then c:Disconnect() else c() end
		end)
	end
	table.clear(cleanups)
	table.clear(updaters)
	table.clear(watchers)
	table.clear(taskRows)
	DukeGUI.Options = {}
	if W then
		pcall(W.Unload, W)
		W = nil
	end
end

