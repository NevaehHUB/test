---------------------------------------------------------------- start

applyPassiveSettings(false)
Misc.watchDisconnect(function(msg)
	G.disconnected = msg
	-- paused, not stopped: the session file stays "running", so a rejoin goes on by itself
	Scheduler.setPaused(true)
	Log.error("Hub", "disconnected, all tasks paused: " .. msg)
end)

-- A switch turned on while the script runs arms the job(s) it enables at once. Switches that were
-- already on when it loaded stay held (they are what the start question is about).
local wasEnabled = {}
local function enabledNow(t)
	local ok, on = pcall(t.def.enabled)
	return ok and on == true
end
function Hub.snapshot()
	for _, t in ipairs(Scheduler.all()) do
		wasEnabled[t.id] = enabledNow(t)
	end
end
Hub.snapshot()
Config.onChange(function()
	if env.AnimeDiceHub ~= Hub then return end
	local armedSome = false
	for _, t in ipairs(Scheduler.all()) do
		local on = enabledNow(t)
		if on and not wasEnabled[t.id] then
			Scheduler.arm(t.id)
			armedSome = true
		end
		wasEnabled[t.id] = on
	end
	if armedSome then writeSession(true) end
end)

-- after a server hop / rejoin: go on with what was running; otherwise ask once about last time's switches
local prev = previousSession()
if prev then
	if prev.all then
		Scheduler.armAll()
	else
		for _, id in ipairs(type(prev.ids) == "table" and prev.ids or {}) do Scheduler.arm(id) end
	end
	applyPassiveSettings(true)
	writeSession(true)
	Log.info("Hub", "continued the jobs from the last server")
	task.delay(1, function() UI.hint(L("Continuing the jobs from the last server", "ทำงานต่อจากเซิร์ฟก่อนหน้า")) end)
elseif Config.get("safety.resumeOnLoad") then
	Hub.resume()
	task.delay(1, function() UI.hint(L("Continuing last time's switches", "ทำต่อจากสวิตช์ที่เปิดไว้ครั้งก่อน")) end)
else
	task.delay(1, function()
		if env.AnimeDiceHub == Hub then promptHeld() end
	end)
end

if UserInputService.TouchEnabled then
	-- Draw the full UI before the scheduler starts.
	task.delay(2, function()
		if env.AnimeDiceHub == Hub then Scheduler.start() end
	end)
else
	Scheduler.start()
end
-- if anything teleports us (server hop, rejoin, the game's AFK teleport),
-- start again in the new server
Hub.restartQueued = Hop.queueSelf()
-- keep the session file fresh while jobs run, so only a recent teleport continues them
task.spawn(function()
	while env.AnimeDiceHub == Hub do
		task.wait(60)
		if env.AnimeDiceHub == Hub and not G.disconnected and hasArmed() then writeSession(true) end
	end
end)
Log.info("Hub", VERSION .. " loaded")
function Hub.destroy()
	Hub.stop()
	Scheduler.stop()
	Misc.cleanup()
	UI.destroy()
	Config.save()
end

Hub.modules = { G = G, Config = Config, Scheduler = Scheduler, Farm = Farm, Units = Units, Rewards = Rewards, Tower = Tower, Log = Log, Index = Index, Teleport = Teleport, UI = UI, Telemetry = Telemetry, Reroll = Reroll, Misc = Misc, Lang = Lang, Gear = Gear, Hop = Hop }
return Hub
end, function(e) return tostring(e) .. "\n" .. debug.traceback() end)
