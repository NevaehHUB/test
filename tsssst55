-- the previous session, when it was running in another server a short while ago (= we got teleported)
local function previousSession()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
	local ok, data = pcall(function()
		return isfile(SESSION_FILE) and Util.decode(readfile(SESSION_FILE)) or nil
	end)
	if not ok or type(data) ~= "table" or not data.running then return nil end
	if data.job == game.JobId or os.time() - (tonumber(data.t) or 0) > SESSION_MAX_AGE then return nil end
	return data
end

local function hasArmed()
	return Scheduler.allArmed() or #Scheduler.armedIds() > 0
end

-- "Continue": every switch that is on may run now
function Hub.resume()
	Scheduler.armAll()
	applyPassiveSettings(true)
	writeSession(true)
end

-- "Stop all": every job stops; switches stay as they are (turning one on again starts just that one)
function Hub.stop()
	Scheduler.disarmAll()
	if Scheduler.get("tower") and Scheduler.get("tower").running then Tower.stop() end
	writeSession(false)
end

-- tasks that spend money / items or sell (shown apart on the prompt)
local function riskyIds()
	return { sell = true, boosts = true, spins = true, traits = true, grades = true, roll = true, hop = true,
		levelUp = true, rebirth = true, dice = true, upgrades = true, tower = Config.get("tower.useDamageBoost") == true }
end

-- names of the held tasks: safe, risky
local function heldNames()
	local risky = riskyIds()
	local safe, spend = {}, {}
	for _, t in ipairs(Scheduler.held()) do
		table.insert(risky[t.id] and spend or safe, t.name)
	end
	return safe, spend
end

-- The one question at start: switches saved "on" from last time.
local function promptHeld()
	local safe, spend = heldNames()
	local passive = {}
	for _, s in ipairs({ { "misc.antiAfk", "Anti-AFK" }, { "misc.lowGraphics", "Low graphics" }, { "misc.autoRejoin", "Auto rejoin" } }) do
		if Config.get(s[1]) then table.insert(passive, s[2]) end
	end
	if #safe + #spend + #passive == 0 then return end
	local lines = { L("These were on last time. Continue them now?", "ครั้งก่อนเปิดไว้ ทำต่อเลยไหม?") }
	if #safe + #passive > 0 then
		local all = table.clone(safe)
		for _, p in ipairs(passive) do table.insert(all, p) end
		table.insert(lines, "\n✓ " .. table.concat(all, ", "))
	end
	if #spend > 0 then
		table.insert(lines, "\n⚠ " .. L("Spends or sells: ", "ใช้ของ / ใช้เงิน / ขาย: ") .. table.concat(spend, ", "))
	end
	if Config.get("sell.enabled") and not Config.get("sell.dryRun") then
		table.insert(lines, "⚠ " .. L("Auto sell is in REAL mode (below ", "ขายอัตโนมัติเป็นโหมดขายจริง (ต่ำกว่า ") .. tostring(Config.get("sell.belowRarity")) .. ")")
	end
	local boostNames = {}
	for name, on in pairs(Config.get("boosts.items") or {}) do if on then table.insert(boostNames, name) end end
	if Config.get("boosts.enabled") and #boostNames > 0 then
		table.sort(boostNames)
		table.insert(lines, "⚠ " .. L("Boosts: ", "บูสต์: ") .. table.concat(boostNames, ", ", 1, math.min(6, #boostNames)) .. (#boostNames > 6 and (" +" .. (#boostNames - 6)) or ""))
	end
	table.insert(lines, "\n" .. L("Not now = they wait; turning a switch off and on starts it.", "ยังไม่ทำ = พักไว้ ปิดแล้วเปิดสวิตช์ไหนก็เริ่มอันนั้น"))
	UI.confirm(table.concat(lines, "\n"), Hub.resume, function()
		UI.hint(L("Paused. Turn a switch on to start it.", "พักไว้แล้ว เปิดสวิตช์ไหนก็เริ่มงานนั้นทันที"))
	end, { yes = L("▶ Continue", "▶ ทำต่อ"), no = L("Not now", "ยังไม่ทำ") })
end
-- A task runs when its own toggle is on, or when the Auto page's master
-- switch and the task's group are on. Tasks that sell units or use up items
-- (sell, boosts, spins) have no group: only their own switch runs them, so a
-- switch shown off really is off.
local function flag(path, group)
	return function()
		return Config.get(path) == true or (group ~= nil and Config.auto(group))
	end
end

local function every(path, default)
	return function()
		return Config.get(path) or default
	end
end

local function disabler(path)
	return function()
		Config.set(path, false)
	end
end

