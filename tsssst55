-- Telemetry: a snapshot every few minutes, kept in memory and appended to
-- AnimeDiceHub/telemetry_<UserId>.csv so long runs can be compared later.
local G = import("game")
local Tower = import("tower")
local Index = import("index")

local Telemetry = {}

Telemetry.samples = {}

local COLUMNS = {
	"time", "money", "incomePerSec", "rebirth", "rolls", "units", "storage", "dice", "luck",
	"upgrades", "towerRuns", "towerBestFloor", "lastTower", "lastCleared", "infinityPredicted",
}

local function path()
	return "AnimeDiceHub/telemetry_" .. tostring(G.player.UserId) .. ".csv"
end

-- Money per second from placed units (what the plot pays), incl. Money Multiplier.
function Telemetry.incomePerSec()
	local inv = G.inventory()
	local total = 0
	for _, s in pairs(G.slots()) do
		local e = s.unitId and inv[s.unitId]
		if e then
			local info = G.unitInfo(s.unitId, e)
			total += info and info.income or 0
		end
	end
	return total * G.buff("Money Multiplier")
end

function Telemetry.snapshot()
	local last = Tower.stats.lastRun
	local infinity = 0
	pcall(function()
		local cfg = G.mod("Towers").Get("Infinity Tower")
		local plan = Tower.cached()
		if plan then
			for _, r in ipairs(plan.rows or {}) do
				if r.tower == "Infinity Tower" then
					infinity = r.cleared
				end
			end
		end
		if infinity == 0 and cfg then
			-- quick estimate with the current tower team
			local team = {}
			local byId = {}
			for _, u in ipairs(Tower.candidates()) do
				byId[u.id] = u
			end
			for i = 1, 4 do
				local id = G.towerTeamIds()[i]
				if id and byId[id] then
					table.insert(team, byId[id])
				end
			end
			infinity = Tower.simulate(cfg, team)
		end
	end)
	local s = {
		time = os.time(),
		money = G.money(),
		incomePerSec = Telemetry.incomePerSec(),
		rebirth = G.rebirths(),
		rolls = G.get("Rolls") or 0,
		units = #G.units(),
		storage = G.unitStorage(),
		dice = tostring(G.get("Dice")),
		luck = Index.luck(),
		upgrades = 0,
		towerRuns = Tower.stats.runs,
		towerBestFloor = Tower.stats.bestFloor,
		lastTower = last and last.tower or "",
		lastCleared = last and last.cleared or 0,
		infinityPredicted = infinity,
	}
	for _ in pairs(G.get("Upgrades") or {}) do
		s.upgrades += 1
	end
	table.insert(Telemetry.samples, s)
	Telemetry.append(s)
	return s
end

function Telemetry.append(s)
	if type(writefile) ~= "function" then
		return
	end
	pcall(function()
		if not isfolder("AnimeDiceHub") then
			makefolder("AnimeDiceHub")
		end
		local cells = {}
		for _, c in ipairs(COLUMNS) do
			table.insert(cells, tostring(s[c]))
		end
		local line = table.concat(cells, ",") .. "\n"
		if not isfile(path()) then
			writefile(path(), table.concat(COLUMNS, ",") .. "\n" .. line)
		elseif type(appendfile) == "function" then
			appendfile(path(), line)
		else
			writefile(path(), readfile(path()) .. line)
		end
	end)
end

function Telemetry.run()
	local s = Telemetry.snapshot()
	return "Ready", ("$%s/s · rebirth %d · luck %s"):format(
		tostring(math.floor(s.incomePerSec)), s.rebirth, tostring(math.floor(s.luck)))
end

return Telemetry
end
