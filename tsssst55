            local nameText = text({ Text = it.Name, FontFace = FONT.medium, TextSize = 13, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 6, 0, 100), Size = UDim2.new(1, -12, 0, 20), ZIndex = 33 }, f)
