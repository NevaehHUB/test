-- A live list: fn() -> { {text=, sub=, state="done"|"progress"|"blocked"|"off"} }
local STATE_MARK = { done = { "✓", "run" }, progress = { "…", "wait" }, blocked = { "✗", "bad" }, off = { "·", "off" } }
function Tab:list(fn, emptyText, _, header)
	return self:info(function()
		local items = fn() or {}
		if #items == 0 then
			return '<font color="' .. UI.tone("off") .. '">' .. plain(emptyText or L("Nothing here yet.", "ยังไม่มีรายการ")) .. "</font>"
		end
		local lines = {}
		for _, it in ipairs(items) do
			local m = STATE_MARK[it.state] or STATE_MARK.off
			table.insert(lines, ('<font color="%s">%s</font> %s%s'):format(UI.tone(m[2]), m[1], plain(it.text),
				(it.sub and it.sub ~= "") and ('  <font color="%s">— %s</font>'):format(UI.tone("off"), plain(it.sub)) or ""))
		end
		return table.concat(lines, "\n")
	end, nil, header)
end

-- Name / value rows: fn() -> { {icon=, title=, value=, good=bool?} } (up to 4)
function Tab:cards(fn)
	local card = self:_card()
	local rows = {}
	for i = 1, 4 do
		rows[i] = card:Value({ Name = "", Text = "" })
		rows[i]:SetVisibility(false)
	end
	UI.onUpdate(function()
		local items = fn() or {}
		for i, r in ipairs(rows) do
			local it = items[i]
			r:SetVisibility(it ~= nil)
			if it then
				r:UpdateLabel((it.icon and (it.icon .. "  ") or "") .. it.title)
				local color = it.good == true and UI.tone("run") or it.good == false and UI.tone("wait") or nil
				r:UpdateName(color and ('<font color="%s">%s</font>'):format(color, plain(it.value)) or plain(it.value))
			end
		end
	end)
	return rows
end

-- A text box with a button next to it.
function Tab:textInput(placeholder, buttonText, callback)
	local card = self:_card()
	local I = card:Input({ Name = placeholder, Placeholder = placeholder, Width = 200 })
	I.IgnoreConfig = true
	local proxy = setmetatable({}, {
		__index = function(_, k) if k == "Text" then return I:GetInput() end end,
		__newindex = function(_, k, v) if k == "Text" then I:UpdateText(v) end end,
	})
	local b = card:Button({ Name = buttonText, Callback = function()
		task.spawn(callback, I:GetInput(), proxy)
	end })
	self:_add(I)
	self:_add(b)
	return I
end

return UI
end
