-- Shared helpers: number formatting, table helpers, safe calls.
local HttpService = game:GetService("HttpService")

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td" }

function Util.fmt(n)
	n = tonumber(n)
	if not n then
		return "?"
	end
	if n ~= n then
		return "NaN"
	end
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n = n / 1000
		i += 1
	end
	local s
	if i == 1 then
		s = tostring(math.floor(n * 100 + 0.5) / 100)
	else
		s = string.format("%.2f", n):gsub("%.?0+$", "") .. SUFFIXES[i]
	end
	return (neg and "-" or "") .. s
end

function Util.fmtTime(sec)
	sec = math.max(0, math.floor(tonumber(sec) or 0))
	local h = math.floor(sec / 3600)
	local m = math.floor(sec % 3600 / 60)
	local s = sec % 60
	if h > 0 then
		return string.format("%dh%02dm", h, m)
	elseif m > 0 then
		return string.format("%dm%02ds", m, s)
	end
	return s .. "s"
end

function Util.clamp(v, lo, hi, default)
	v = tonumber(v)
	if not v or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return math.clamp(v, lo, hi)
end

function Util.copy(t)
	if type(t) ~= "table" then
		return t
	end
	local o = {}
	for k, v in pairs(t) do
		o[k] = Util.copy(v)
	end
	return o
end

-- Fill missing keys in `t` from `defaults` (recursively); drops nothing.
function Util.merge(defaults, t)
	local out = Util.copy(defaults)
	if type(t) ~= "table" then
		return out
	end
	for k, v in pairs(t) do
		if type(v) == "table" and type(out[k]) == "table" and #out[k] == 0 and next(out[k]) ~= nil then
			out[k] = Util.merge(out[k], v)
		elseif out[k] == nil or type(out[k]) == type(v) then
			out[k] = Util.copy(v)
		end
	end
	return out
end

function Util.count(t)
	local c = 0
	for _ in pairs(t or {}) do
		c += 1
	end
	return c
end

function Util.keys(t)
	local o = {}
	for k in pairs(t or {}) do
		table.insert(o, k)
	end
	table.sort(o, function(a, b)
		return tostring(a) < tostring(b)
	end)
	return o
end

function Util.encode(v)
	local ok, s = pcall(HttpService.JSONEncode, HttpService, v)
	return ok and s or nil
end

function Util.decode(s)
	local ok, v = pcall(HttpService.JSONDecode, HttpService, s)
	return ok and v or nil
end

-- Wait until pred() is truthy or timeout; returns the value or nil.
function Util.waitFor(pred, timeout, step)
	local deadline = os.clock() + (timeout or 5)
	repeat
		local ok, v = pcall(pred)
		if ok and v then
			return v
		end
		task.wait(step or 0.1)
	until os.clock() > deadline
	return nil
end

function Util.shortId(id)
	return tostring(id):sub(1, 6)
end

return Util
end
