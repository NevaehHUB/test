local function BuyCrate(crateName)
    local patterns = {
        {crateName},
        {crateName, 1},
        {crateName, State.CratePrices[crateName] or 100},
    }
    for _, args in ipairs(patterns) do
        if SafeFire(Remotes.BuyCrateEvent, table.unpack(args)) then
            task.wait(0.1)
            return true
        end
    end
    return false
end

local function StartAutoBuyCrates()
    if State.Threads.BuyCrates then return end
    State.AutoBuyCrates = true
    State.Threads.BuyCrates = task.spawn(function()
        while State.AutoBuyCrates do
            BuyCrate(State.SelectedCrate)
            task.wait(1)
        end
        State.Threads.BuyCrates = nil
    end)
end

local function StopAutoBuyCrates() State.AutoBuyCrates = false end

local function TriggerMinigame(name)
    if SafeFire(Remotes.EmoteEvent, name) then return true end
    if SafeFire(Remotes.MIH, "StartMinigame", name) then return true end
    if SafeFire(Remotes.PurchaseEvent, "Minigame", name) then return true end

    local model = workspace:FindFirstChild(name .. "Minigame") or workspace:FindFirstChild(name)
    if model then
        local cd = model:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then fireclickdetector(cd) return true end
        local pp = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pp and fireproximityprompt then fireproximityprompt(pp) return true end
    end
    return false
end

local function StartAutoMinigame()
    if State.Threads.Minigame then return end
    State.AutoMinigame = true
    State.Threads.Minigame = task.spawn(function()
        while State.AutoMinigame do
            TriggerMinigame(State.SelectedMinigame)
            task.wait(5)
        end
        State.Threads.Minigame = nil
    end)
end

local function StopAutoMinigame() State.AutoMinigame = false end

local function TriggerRebirth()
    local patterns = {{}, {true}, {LocalPlayer}, {Amount = 1}}
    for _, args in ipairs(patterns) do
        if SafeFire(Remotes.RebirthEvent, table.unpack(args)) then return true end
    end
    return false
end

local function StartAutoRebirth()
    if State.Threads.Rebirth then return end
    State.AutoRebirth = true
