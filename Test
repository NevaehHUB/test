local fabCorner = Instance.new("UICorner"); fabCorner.CornerRadius = UDim.new(1, 0); fabCorner.Parent = Fab
local fabStroke = Instance.new("UIStroke")
fabStroke.Color = Color3.fromRGB(255, 255, 255)
fabStroke.Transparency = 0.75
fabStroke.Thickness = 2
fabStroke.Parent = Fab

MakeDraggable(Fab, Fab)

-- Distinguish tap from drag on the FAB
local fabDragStart = nil
Fab.MouseButton1Down:Connect(function()
    fabDragStart = Fab.AbsolutePosition
end)
Fab.MouseButton1Click:Connect(function()
    if fabDragStart then
        local moved = (Fab.AbsolutePosition - fabDragStart).Magnitude
        fabDragStart = nil
        if moved > 8 then return end -- it was a drag, ignore tap
    end
    MainFrame.Visible = not MainFrame.Visible
    TweenService:Create(Fab, TweenInfo.new(0.15), {
        BackgroundColor3 = MainFrame.Visible and Theme.Accent or Theme.ElementHi
    }):Play()
end)

-- Pulse indicator when any automation is active
local fabPulse = false
task.spawn(function()
    while Fab.Parent do
        local anyActive = State.AutoBuyCrates or State.AutoMinigame
            or State.AutoRebirth or State.AutoTitles or State.AutoClaimRewards
        if anyActive then
            fabPulse = not fabPulse
            TweenService:Create(fabStroke, TweenInfo.new(0.6), {
                Transparency = fabPulse and 0.2 or 0.9
            }):Play()
        else
            if fabPulse then fabPulse = false end
            fabStroke.Transparency = 0.75
        end
        task.wait(0.6)
    end
end)

--=============================================================
-- BUTTON BEHAVIOUR
--=============================================================
HideBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    Notify("UI", "Hidden — tap the ⚙ button to reopen")
end)

CloseBtn.MouseButton1Click:Connect(function()
    for _, thread in pairs(State.Threads) do
        pcall(task.cancel, thread)
    end
    State.AutoBuyCrates = false
    State.AutoMinigame = false
    State.AutoRebirth = false
    State.AutoTitles = false
    State.AutoClaimRewards = false
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() NotifyGui:Destroy() end)
end)

--=============================================================
-- INIT
--=============================================================
SelectTab("Main")
task.defer(RebuildTabCanvas)

-- Restore saved toggles
task.wait(0.4)
if State.AutoBuyCrates    then StartAutoBuyCrates()    end
if State.AutoMinigame     then StartAutoMinigame()     end
if State.AutoRebirth      then StartAutoRebirth()      end
if State.AutoTitles       then StartAutoTitles()       end
if State.AutoClaimRewards then StartAutoClaimRewards() end

-- Keyboard shortcut (PC)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

Notify("Larp Auto", "Loaded! Tap ⚙ to toggle the menu.", 5)
print("[Larp Auto] Loaded. Tap ⚙ (or press RightShift) to toggle the UI.")
