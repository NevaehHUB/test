local function StopAutoRebirth() State.AutoRebirth = false end

local function ClaimTitles()
    local patterns = {{"ClaimAll"}, {"GetAll"}, {"AutoClaim"}, {}}
    for _, args in ipairs(patterns) do
        if SafeFire(Remotes.TradeTitleEvent, table.unpack(args)) then return true end
    end
    SafeInvoke(Remotes.ClaimIndexReward, "All")
