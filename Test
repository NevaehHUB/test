--=============================================================
-- SAFE REMOTE CALLS
--=============================================================
local function SafeFire(remote, ...)
    if not remote then return false end
    local ok, err = pcall(remote.FireServer, remote, ...)
    if not ok then warn("[Larp Auto] Fire failed: " .. tostring(remote.Name) .. " -> " .. tostring(err)) end
    return ok
end

local function SafeInvoke(remote, ...)
    if not remote then return false, nil end
    local ok, res = pcall(remote.InvokeServer, remote, ...)
    if not ok then warn("[Larp Auto] Invoke failed: " .. tostring(remote.Name) .. " -> " .. tostring(res)) end
    return ok, res
end

