    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 54, 0, 30)
    btn.Position = UDim2.new(1, -68, 0.5, -15)
    btn.BackgroundColor3 = Theme.ElementHi
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Parent = row
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1, 0); bc.Parent = btn

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 24, 0, 24)
    knob.Position = UDim2.new(0, 3, 0, 3)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = btn
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

    local enabled = default and true or false
    local function render()
        TweenService:Create(btn, TweenInfo.new(0.18), {
            BackgroundColor3 = enabled and Theme.Accent or Theme.ElementHi
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = enabled and UDim2.new(1, -27, 0, 3) or UDim2.new(0, 3, 0, 3)
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        render()
        callback(enabled)
    end)
    render()

    return {
        Set = function(v)
            v = v and true or false
            if v ~= enabled then enabled = v; render() end
        end,
        Get = function() return enabled end,
