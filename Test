--=============================================================
-- GLOBAL DRAG HANDLER
--=============================================================
local CurrentDrag = nil

local function ComputeClampBounds(frame)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local size = frame.AbsoluteSize
    local ap = frame.AnchorPoint
    local minX = ap.X * size.X
    local maxX = vp.X - size.X + ap.X * size.X
    local minY = ap.Y * size.Y
    local maxY = vp.Y - size.Y + ap.Y * size.Y
    if minX > maxX then local m = (minX + maxX) * 0.5; minX, maxX = m, m end
    if minY > maxY then local m = (minY + maxY) * 0.5; minY, maxY = m, m end
    return minX, maxX, minY, maxY
end

local function BeginDrag(frame, input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    -- Convert any scale-based position to pure offsets for consistent dragging
    local p = frame.Position
    if p.X.Scale ~= 0 or p.Y.Scale ~= 0 then
        local abs = frame.AbsolutePosition
        local ap = frame.AnchorPoint
        local sz = frame.AbsoluteSize
        frame.Position = UDim2.fromOffset(abs.X + ap.X * sz.X, abs.Y + ap.Y * sz.Y)
    end
    CurrentDrag = {
        frame  = frame,
        startX = frame.Position.X.Offset,
        startY = frame.Position.Y.Offset,
        inputX = input.Position.X,
        inputY = input.Position.Y,
    }
end

UserInputService.InputChanged:Connect(function(input)
    if not CurrentDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local frame = CurrentDrag.frame
    if not frame or not frame.Parent then CurrentDrag = nil; return end

    local dx = input.Position.X - CurrentDrag.inputX
    local dy = input.Position.Y - CurrentDrag.inputY
    local ox = CurrentDrag.startX + dx
    local oy = CurrentDrag.startY + dy

    local minX, maxX, minY, maxY = ComputeClampBounds(frame)
    frame.Position = UDim2.fromOffset(
        math.clamp(ox, minX, maxX),
        math.clamp(oy, minY, maxY)
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        CurrentDrag = nil
    end
end)

local function MakeDraggable(frame, handle)
    handle = handle or frame
    handle.InputBegan:Connect(function(input)
        BeginDrag(frame, input)
    end)
end

