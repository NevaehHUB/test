-- REMOTE RESOLUTION
--=============================================================
local Remotes = {}

local SEARCH_ROOTS = {
    ReplicatedStorage,
    ReplicatedStorage:FindFirstChild("Remotes"),
    ReplicatedStorage:FindFirstChild("Events"),
    ReplicatedStorage:FindFirstChild("RemoteEvents"),
    ReplicatedStorage:FindFirstChild("Net"),
}

local function GetRemote(name, className)
    className = className or "RemoteEvent"
    for _, root in ipairs(SEARCH_ROOTS) do
        if root then
            local r = root:FindFirstChild(name)
            if r and r:IsA(className) then
                Remotes[name] = r
                return r
            end
        end
    end
    -- brief wait as last resort
    local r = ReplicatedStorage:WaitForChild(name, 3)
    if r and r:IsA(className) then
        Remotes[name] = r
        return r
    end
    warn("[Larp Auto] Remote not found: " .. name .. " (" .. className .. ")")
    return nil
end

