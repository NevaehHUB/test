--[[ ==========================================================================
     Astra UI bootstrap + Chilli-compatible shim
     Replaces the Chilli Library loader while keeping the same API surface,
     so the rest of the script (10k+ lines) does not need to be touched.
     ========================================================================== ]]

local Astra = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ali-lov3/AstraUiLib/refs/heads/main/Source.lua"))()

local AstraWindow = Astra.CreateWindow({
	Title = "Kira Hub - Steal An Egg",
	Logo = 0,
	Anonymous = false,
	ConfigFolder = "KiraConfigs",
})

local AstraTabs = {}

local function astraTab(name)
	name = tostring(name or "Main")
	if AstraTabs[name] then
		return AstraTabs[name]
	end
	local ok, tab = pcall(AstraWindow.CreateTab, AstraWindow, { Name = name, Icon = "box" })
	if not ok then
		return nil
	end
	AstraTabs[name] = tab
	return tab
end

-- ---------------------------------------------------------------------------
-- helpers
-- ---------------------------------------------------------------------------
local function callAny(obj, names, ...)
	if obj == nil then
		return false, nil
	end
	for i = 1, #names do
		local f = obj[names[i]]
		if type(f) == "function" then
			local ok, res = pcall(f, obj, ...)
			if ok then
				return true, res
			end
		end
	end
	return false, nil
end

local function toColor3(v, fallback)
	if typeof(v) == "Color3" then
		return v
	end
	if type(v) == "string" and #v > 0 then
		local ok, c = pcall(Color3.fromHex, v)
		if ok then
			return c
		end
	end
	return fallback or Color3.fromRGB(255, 255, 255)
end

-- ---------------------------------------------------------------------------
-- generic widget handle
-- ---------------------------------------------------------------------------
local function newHandle(value, widget)
	local h = {}
	local subs = {}
	h._value = value
	h._widget = widget
	h._subs = subs

	h.Get = function()
		return h._value
	end
	h.GetValue = h.Get

	h.Set = function(_, v, ...)
		h._value = v
		callAny(widget, { "Set", "SetValue", "SetState", "SetText", "Update" }, v)
		for _, f in ipairs(subs) do
			pcall(f, v)
		end
	end
	h.SetValue = h.Set

	h.SetOptions = function(_, options, selected, keep, ...)
		callAny(widget, { "SetOptions", "UpdateOptions", "Refresh" }, options, selected, keep)
	end

	h.JoinExclusiveGroup = function(_, group)
		if type(group) == "table" and type(group._join) == "function" then
			group._join(h)
		end
	end

	h.GetQuickPath = function()
		return h._quickPath
	end

	h.Subscribe = function(_, f)
		if type(f) == "function" then
			subs[#subs + 1] = f
		end
	end

	return h
end

-- ---------------------------------------------------------------------------
-- canvas engine (mini immediate-mode UI used by the Predictor / Discord tabs)
-- ---------------------------------------------------------------------------
local function createCanvas(hostFrame, spec)
	local canvas = { _elements = {}, _onResize = {}, _contentLines = 16 }
	local root = Instance.new("Frame")
	root.Name = "Canvas"
	root.BackgroundTransparency = 1
	root.Position = UDim2.fromOffset(0, 0)
	root.Size = UDim2.new(1, 0, 0, 16 * 12)
	root.ClipsDescendants = false
	root.Parent = hostFrame

	local dockFrame = Instance.new("Frame")
	dockFrame.Name = "Dock"
	dockFrame.BackgroundTransparency = 1
	dockFrame.Position = UDim2.fromOffset(0, 0)
	dockFrame.Size = UDim2.new(1, 0, 0, 0)
	dockFrame.Visible = false
	dockFrame.Parent = root

	local ctx = { unit = 12, widthPx = 300, heightPx = 200 }

	local function px(v)
		return (tonumber(v) or 0) * ctx.unit
	end

	local function applyProps(inst, props)
		if type(props) ~= "table" then
			return
		end
		local x = px(props.X)
		local y = px(props.Y)

		if props.Position then
			inst.Position = props.Position
		elseif props.X ~= nil or props.Y ~= nil then
			inst.Position = UDim2.fromOffset(x, y)
		end

		if inst:IsA("GuiObject") then
			local w = props.Width
			local h = props.Height

			if w ~= nil or h ~= nil then
				local hOff = h and px(h) or (inst.AbsoluteSize.Y > 0 and inst.AbsoluteSize.Y or ctx.unit)
				if w == nil or w == 1 then
					inst.Size = UDim2.new(1, -x, 0, hOff)
				else
					inst.Size = UDim2.fromOffset(px(w), hOff)
				end
			end
		end

		if props.Visible ~= nil then inst.Visible = props.Visible == true end
		if props.ZIndex ~= nil then inst.ZIndex = tonumber(props.ZIndex) or inst.ZIndex end

		if props.Background ~= nil then inst.BackgroundColor3 = toColor3(props.Background, inst.BackgroundColor3) end
		if props.BackgroundTransparency ~= nil then inst.BackgroundTransparency = tonumber(props.BackgroundTransparency) or 0 end
		if props.Transparency ~= nil then inst.BackgroundTransparency = tonumber(props.Transparency) or 0 end

		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			if props.Text ~= nil then inst.Text = tostring(props.Text) end
			if props.Color ~= nil then inst.TextColor3 = toColor3(props.Color, inst.TextColor3) end
			if props.Scale ~= nil then inst.TextSize = math.max(6, ctx.unit * (tonumber(props.Scale) or 1)) end
			if props.Wrap ~= nil then inst.TextWrapped = props.Wrap == true end
			if props.Align ~= nil then
				local a = tostring(props.Align):lower()
				inst.TextXAlignment = a == "right" and Enum.TextXAlignment.Right
					or a == "center" and Enum.TextXAlignment.Center
					or Enum.TextXAlignment.Left
			end
			if props.TextStrokeTransparency ~= nil then inst.TextStrokeTransparency = tonumber(props.TextStrokeTransparency) or 0 end
			inst.TextScaled = false
			inst.TextYAlignment = Enum.TextYAlignment.Center
		end

		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			if props.Image ~= nil then inst.Image = tostring(props.Image) end
			if props.ImageTransparency ~= nil then inst.ImageTransparency = tonumber(props.ImageTransparency) or 0 end
		end

		if props.Corner ~= nil then
			local corner = inst:FindFirstChildOfClass("UICorner")
			if not corner then
				corner = Instance.new("UICorner")
				corner.Parent = inst
			end
			corner.CornerRadius = UDim.new(tonumber(props.Corner) or 0, 0)
		end

		if props.StrokeColor ~= nil or props.StrokeThickness ~= nil or props.StrokeTransparency ~= nil then
			local stroke = inst:FindFirstChildOfClass("UIStroke")
			if not stroke then
				stroke = Instance.new("UIStroke")
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				stroke.Parent = inst
			end
			if props.StrokeColor ~= nil then stroke.Color = toColor3(props.StrokeColor, stroke.Color) end
			if props.StrokeThickness ~= nil then stroke.Thickness = math.max(0.5, (tonumber(props.StrokeThickness) or 0.1) * ctx.unit) end
			if props.StrokeTransparency ~= nil then stroke.Transparency = tonumber(props.StrokeTransparency) or 0 end
		end

		if props.Gradient ~= nil then
			local grad = inst:FindFirstChildOfClass("UIGradient")
			if not grad then
				grad = Instance.new("UIGradient")
				grad.Parent = inst
			end
			if typeof(props.Gradient) == "ColorSequence" then
				grad.Color = props.Gradient
			end
			if props.GradientRotation ~= nil then
				grad.Rotation = tonumber(props.GradientRotation) or 90
			end
		end

		if props.HoverTransparency ~= nil and inst:IsA("TextButton") then
			inst.AutoButtonColor = false
		end
	end

	local function makeElement(kind, parent, props)
		props = props or {}
		local inst
		if kind == "frame" then
			inst = Instance.new("Frame")
		elseif kind == "text" then
			inst = Instance.new("TextLabel")
		elseif kind == "image" then
			inst = Instance.new("ImageLabel")
		elseif kind == "button" then
			inst = Instance.new("TextButton")
		end
		inst.Name = "El"
		inst.BackgroundTransparency = 1
		inst.BorderSizePixel = 0
		inst.Parent = parent or root
		applyProps(inst, props)

		local handle = {}
		handle.Instance = inst
		handle.Set = function(_, newProps)
			applyProps(inst, newProps)
		end
		handle.SetRotation = function(_, deg)
			inst.Rotation = tonumber(deg) or 0
		end
		handle.SetTransparency = function(_, t)
			inst.ImageTransparency = tonumber(t) or 0
		end
		handle.SetImageId = function(_, id)
			inst.Image = "rbxassetid://" .. tostring(id)
		end
		table.insert(canvas._elements, handle)

		if kind == "button" and type(props.Callback) == "function" then
			inst.Activated:Connect(function()
				pcall(props.Callback)
			end)
		end
		return handle
	end

	local function recompute()
		local w = root.AbsoluteSize.X
		if w <= 0 then
			w = hostFrame.AbsoluteSize.X
		end
		if w <= 0 then
			w = 300
		end
		ctx.widthPx = w
		ctx.unit = math.clamp(w / 26, 10, 22)
		ctx.heightPx = canvas._contentLines * ctx.unit
		root.Size = UDim2.new(1, 0, 0, ctx.heightPx)

		for _, fn in ipairs(canvas._onResize) do
			pcall(fn, canvas, ctx.widthPx, ctx.heightPx)
		end
	end

	canvas.Root = function() return root end
	canvas.Query = function() return "" end
	canvas.Width = function() return ctx.widthPx end
	canvas.Height = function() return ctx.heightPx end
	canvas.Unit = function() return ctx.unit end
	canvas.TextSize = function() return ctx.unit end

	canvas.OnResize = function(_, fn)
		if type(fn) == "function" then
			table.insert(canvas._onResize, fn)
		end
	end

	canvas.Dock = function() return dockFrame end

	canvas.SetDock = function(_, lines, opts)
		lines = tonumber(lines) or 0
		dockFrame.Visible = lines > 0
		dockFrame.Size = UDim2.new(1, 0, 0, lines * ctx.unit)
		opts = opts or {}
		if opts.DividerColor ~= nil then
			local divider = dockFrame:FindFirstChild("Divider")
			if not divider then
				divider = Instance.new("Frame")
				divider.Name = "Divider"
				divider.BorderSizePixel = 0
				divider.AnchorPoint = Vector2.new(0, 1)
				divider.Position = UDim2.new(0, 0, 1, 0)
				divider.Size = UDim2.new(1, 0, 0, 1)
				divider.Parent = dockFrame
			end
			divider.BackgroundColor3 = toColor3(opts.DividerColor, Color3.fromRGB(170, 174, 184))
			divider.BackgroundTransparency = 0.5
		end
	end

	canvas.SetContentLines = function(_, n)
		canvas._contentLines = math.max(1, tonumber(n) or 1)
		recompute()
	end

	canvas.Frame = function(_, props) return makeElement("frame", props and props.Parent or root, props) end
	canvas.Text = function(_, props) return makeElement("text", props and props.Parent or root, props) end
	canvas.Image = function(_, props) return makeElement("image", props and props.Parent or root, props) end
	canvas.Button = function(_, props) return makeElement("button", props and props.Parent or root, props) end

	canvas.Destroy = function()
		pcall(function() root:Destroy() end)
	end

	hostFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(recompute)
	task.defer(recompute)
	return canvas
end

-- ---------------------------------------------------------------------------
-- section shim
-- ---------------------------------------------------------------------------
local Section = {}

local function sectionAdd(astraSection, method, spec)
	if astraSection == nil then
		return nil
	end
	local f = astraSection[method]
	if type(f) ~= "function" then
		return nil
	end
	local ok, res = pcall(f, astraSection, spec)
	return ok and res or nil
end

function Section:CreateToggle(spec)
	spec = spec or {}
	local handle
	local default = spec.Default == true
	local widget = sectionAdd(self._astra, "AddToggle", {
		Name = tostring(spec.Name or "Toggle"),
		Default = default,
		Callback = function(state)
			if type(state) ~= "boolean" then
				state = not not state
			end
			handle._value = state
			for _, f in ipairs(handle._subs) do pcall(f, state) end
			if type(spec.Callback) == "function" then pcall(spec.Callback, state) end
		end,
	})
	handle = newHandle(default, widget)
	handle._quickPath = tostring(spec.Name or "Toggle")
	return handle
end

function Section:CreateSlider(spec)
	spec = spec or {}
	local handle
	local min = tonumber(spec.Min) or 0
	local max = tonumber(spec.Max) or 100
	local default = tonumber(spec.Default) or min
	local widget = sectionAdd(self._astra, "AddSlider", {
		Name = tostring(spec.Name or "Slider"),
		Min = min,
		Max = max,
		Default = default,
		Callback = function(v)
			v = tonumber(v) or 0
			handle._value = v
			for _, f in ipairs(handle._subs) do pcall(f, v) end
			if type(spec.Callback) == "function" then pcall(spec.Callback, v) end
		end,
	})
	handle = newHandle(default, widget)
	handle._quickPath = tostring(spec.Name or "Slider")
	return handle
end

function Section:CreateDropdown(spec)
	spec = spec or {}
	local handle
	local options = spec.Options or {}
	local default = type(spec.Default) == "string" and spec.Default or options[1]
	local widget = sectionAdd(self._astra, "AddDropdown", {
		Name = tostring(spec.Name or "Dropdown"),
		Options = options,
		Default = default,
		Callback = function(selected)
			handle._value = selected
			for _, f in ipairs(handle._subs) do pcall(f, selected) end
			if type(spec.Callback) == "function" then pcall(spec.Callback, selected) end
		end,
	})
	handle = newHandle(default, widget)
	handle._quickPath = tostring(spec.Name or "Dropdown")
	return handle
end

function Section:CreateMultiDropdown(spec)
	spec = spec or {}
	local handle
	local options = spec.Options or {}
	local default = type(spec.Default) == "table" and spec.Default or {}
	local widget = sectionAdd(self._astra, "AddMultiDropdown", {
		Name = tostring(spec.Name or "Multi Dropdown"),
		Options = options,
		Default = default,
		Callback = function(selected)
			handle._value = selected
			for _, f in ipairs(handle._subs) do pcall(f, selected) end
			if type(spec.Callback) == "function" then pcall(spec.Callback, selected) end
		end,
	})
	handle = newHandle(default, widget)
	handle._quickPath = tostring(spec.Name or "Multi Dropdown")
	return handle
end

function Section:CreateText(spec)
	spec = spec or {}
	local text = tostring(spec.Text or "")
	local label = sectionAdd(self._astra, "AddLabel", text)
	local h = newHandle(text, label)
	h._quickPath = tostring(spec.Name or "Text")
	return h
end

function Section:CreateLabel(spec)
	spec = spec or {}
	local text = tostring(spec.Text or spec.Name or "")
	local label = sectionAdd(self._astra, "AddLabel", text)
	return newHandle(text, label)
end

function Section:CreateButton(spec)
	spec = spec or {}
	local widget = sectionAdd(self._astra, "AddButton", {
		Name = tostring(spec.Name or "Button"),
		Callback = function()
			if type(spec.Callback) == "function" then
				pcall(spec.Callback)
			end
		end,
	})
	return newHandle(nil, widget)
end

function Section:CreateInput(spec)
	spec = spec or {}
	local value = tostring(spec.Default or "")
	local subs = {}
	local h = {}
	h._value = value
	h._configIgnored = true
	h.State = { _registered = true, _configIgnored = true }

	local widget = sectionAdd(self._astra, "AddInput", {
		Name = tostring(spec.Name or "Input"),
		Placeholder = tostring(spec.Placeholder or ""),
		Default = value,
		Callback = function(text, entered)
			text = tostring(text or "")
			h._value = text
			for _, f in ipairs(subs) do pcall(f, text, entered) end
			if type(spec.Callback) == "function" then pcall(spec.Callback, text, entered) end
		end,
	})
	h._widget = widget

	h.Get = function() return h._value end
	h.GetValue = h.Get
	h.GetText = h.Get

	h.Set = function(_, v)
		v = tostring(v or "")
		h._value = v
		callAny(widget, { "Set", "SetValue", "SetText" }, v)
	end
	h.SetValue = h.Set

	h._controller = {
		GetValue = function() return h._value end,
		SetValue = function(v) h.Set(nil, v) end,
	}
	h.Subscribe = function(_, f)
		if type(f) == "function" then subs[#subs + 1] = f end
	end
	return h
end

function Section:CreateCanvas(spec)
	spec = spec or {}

	-- Find a Frame the Astra section lives in so the canvas sits inside the tab.
	local hostFrame
	local ok, probe = pcall(self._astra.AddLabel, self._astra, "")
	if ok then
		local inst
		if typeof(probe) == "Instance" then
			inst = probe
		elseif type(probe) == "table" then
			for _, k in ipairs({ "Instance", "Object", "Frame", "Handle", "Root", "Element", "Label", "Gui" }) do
				if typeof(probe[k]) == "Instance" then
					inst = probe[k]
					break
				end
			end
		end
		local node = inst
		while node do
			if node:IsA("Frame") or node:IsA("ScrollingFrame") then
				hostFrame = node
				break
			end
			node = node.Parent
		end
	end

	if not hostFrame then
		-- Fallback: create a floating panel so the canvas still works.
		local gui = Instance.new("ScreenGui")
		gui.Name = "KiraCanvas"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 40
		gui.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
		hostFrame = Instance.new("Frame")
		hostFrame.Size = UDim2.fromOffset(520, 640)
		hostFrame.Position = UDim2.fromOffset(360, 60)
		hostFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		hostFrame.BackgroundTransparency = 0.15
		hostFrame.BorderSizePixel = 0
		hostFrame.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = hostFrame
	end

	local canvas = createCanvas(hostFrame, spec)

	if type(spec.Build) == "function" then
		task.defer(function()
			pcall(spec.Build, canvas)
		end)
	end

	return canvas
end

-- ---------------------------------------------------------------------------
-- tab shim
-- ---------------------------------------------------------------------------
local Tab = {}

function Tab:CreateSection(spec)
	spec = spec or {}
	local side = tostring(spec.Side or "Left")
	if side ~= "Left" and side ~= "Right" then
		side = "Left"
	end

	local ok, sec = pcall(self._astra.CreateSection, self._astra, {
		Name = tostring(spec.Name or "Section"),
		Side = side,
	})
	if not ok then
		ok, sec = pcall(self._astra.CreateSection, self._astra, {
			Name = tostring(spec.Name or "Section"),
			Side = "Right",
		})
	end
	if not ok then
		return nil
	end
	return setmetatable({ _astra = sec }, { __index = Section })
end

-- ---------------------------------------------------------------------------
-- window shim
-- ---------------------------------------------------------------------------
local function makeState(spec)
	spec = spec or {}
	local value = spec.Default
	local subs = {}
	local h = {}
	h.Get = function() return value end
	h.GetValue = h.Get
	h.Set = function(_, v)
		value = v
		for _, f in ipairs(subs) do pcall(f, v) end
	end
	h.Subscribe = function(_, f)
		if type(f) == "function" then subs[#subs + 1] = f end
	end
	return h
end

local function makeExclusiveGroup(spec)
	spec = spec or {}
	local members = {}
	local maxActive = math.max(1, tonumber(spec.MaxActive) or 1)
	local group = {}
	group._members = members
	group._join = function(handle)
		if not table.find(members, handle) then
			table.insert(members, handle)
		end
		local active = {}
		for _, m in ipairs(members) do
			if m ~= handle and m:Get() == true then
				active[#active + 1] = m
			end
		end
		while #active >= maxActive do
			local oldest = table.remove(active, 1)
			if oldest then
				oldest:Set(false)
			end
		end
	end
	return group
end

local function makeTab(spec)
	spec = spec or {}
	local astra = astraTab(spec.Name)
	if not astra then
		return nil
	end
	local t = setmetatable({ _astra = astra }, { __index = Tab })
	t.Page = astra.Page or astra.Frame or astra.Holder
	return t
end

local shim = {}
shim.ManualQuickDefaults = {
	PinnedFeatures = { "Player > Movement > Speed Boost", "Player > Movement > Boost Speed" },
	Keybinds = { ["Player > Movement > Speed Boost"] = "Q" },
	PinGroups = {},
	LeftCenterHidden = true,
}

function shim:CreateWindow(opts)
	opts = opts or {}
	local w = {}
	w._defaultName = tostring(opts.DefaultTab or "Main")
	astraTab(w._defaultName)

	w.CreateTab = function(_, tspec)
		return makeTab(tspec)
	end

	w.GetDefaultTab = function()
		return makeTab({ Name = w._defaultName })
	end

	w.CreateState = function(_, sspec)
		return makeState(sspec)
	end

	w.CreateExclusiveGroup = function(_, gspec)
		return makeExclusiveGroup(gspec)
	end

	return w
end

function shim:Finalize()
	-- Astra auto-finalises when the window is built.
end

function shim:Notify(title, text, duration)
	pcall(function()
		Astra.Notify({
			Title = tostring(title or "Kira Hub"),
			Text = tostring(text or ""),
			Icon = "check",
			Duration = tonumber(duration) or 4,
		})
	end)
end

local function fn11()
	return shim
end

